<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_customer_display" model="ir.ui.view">
        <field name="name">account.move.form.doorandoor.customer.display</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="ddpc_customer_display_active" invisible="1"/>
                <button name="action_ddpc_open_customer_display" type="object"
                        string="Abrir pantalla de cliente" class="btn-secondary"
                        groups="sales_team.group_sale_salesman,sales_team.group_sale_manager" invisible="move_type != 'out_invoice'"/>
                <button name="action_ddpc_close_customer_display" type="object"
                        string="Cerrar pantalla cliente" class="btn-secondary"
                        groups="sales_team.group_sale_salesman,sales_team.group_sale_manager"
                        invisible="move_type != 'out_invoice' or not ddpc_customer_display_active"/>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <widget name="ddpc_customer_display_lifecycle" model="account.move" class="d-none"/>
            </xpath>
        </field>
    </record>
</odoo>
