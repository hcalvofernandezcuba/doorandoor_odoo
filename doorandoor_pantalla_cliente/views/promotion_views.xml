<?xml version="1.0" encoding="utf-8"?>
<odoo>
 <record id="action_ddpc_promotion" model="ir.actions.act_window">
  <field name="name">Promociones de pantalla de cliente</field><field name="res_model">doorandoor.customer.display.promotion</field><field name="view_mode">list,form</field>
  <field name="context">{'default_media_type': 'image'}</field><field name="help" type="html"><p class="o_view_nocontent_smiling_face">Cree una promoción para la pantalla de cliente.</p><p>Suba una imagen o video, active el registro y defina el orden de visualización.</p></field>
 </record>
 <record id="menu_ddpc_backend" model="ir.ui.menu">
  <field name="name">Pantalla de cliente</field><field name="parent_id" ref="base.menu_administration"/><field name="action" ref="action_ddpc_promotion"/><field name="sequence">72</field><field name="groups_id" eval="[(6, 0, [ref('base.group_system')])]"/>
 </record>
 <record id="menu_ddpc_promotion" model="ir.ui.menu">
  <field name="name">Promociones pantalla cliente</field><field name="parent_id" ref="website.menu_content"/><field name="action" ref="action_ddpc_promotion"/><field name="sequence">90</field><field name="groups_id" eval="[(6, 0, [ref('website.group_website_designer'), ref('website.group_website_restricted_editor'), ref('base.group_system')])]"/>
 </record>
 <record id="view_ddpc_promotion_list" model="ir.ui.view"><field name="name">doorandoor.customer.display.promotion.list</field><field name="model">doorandoor.customer.display.promotion</field><field name="arch" type="xml"><list><field name="sequence" widget="handle"/><field name="name"/><field name="city_rule_id" optional="show"/><field name="media_type"/><field name="display_seconds"/><field name="date_start" optional="hide"/><field name="date_end" optional="hide"/><field name="active"/></list></field></record>
 <record id="view_ddpc_promotion_form" model="ir.ui.view"><field name="name">doorandoor.customer.display.promotion.form</field><field name="model">doorandoor.customer.display.promotion</field><field name="arch" type="xml"><form string="Promoción de pantalla de cliente"><sheet><div class="oe_title"><label for="name"/><h1><field name="name" placeholder="Ej.: Puerta moderna de impacto"/></h1></div><group><group string="Segmentación y orden"><field name="active"/><field name="city_rule_id" placeholder="Vacío = promoción general"/><field name="sequence" help="Orden dentro de la ciudad. Número menor aparece primero."/><field name="display_seconds"/></group><group string="Vigencia"><field name="date_start"/><field name="date_end"/><field name="company_id" groups="base.group_system"/><div class="o_form_label">La pantalla muestra promociones generales y las asignadas a su ciudad.</div></group></group><notebook><page string="Contenido"><group><field name="media_type"/><field name="conditions" placeholder="Ej.: Oferta válida hasta fin de existencias."/></group><group string="Archivo de la promoción"><widget name="ddpc_promotion_media_picker"/><field name="video_filename" invisible="1"/><field name="video_mimetype" invisible="1"/></group></page></notebook></sheet></form></field></record>
</odoo>
