<odoo>
    <record id="payment_provider_form_ddtp_card_fee" model="ir.ui.view">
        <field name="name">payment.provider.form.ddtp.card.fee</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='configuration']" position="inside">
                <group string="Pago con tarjeta" invisible="code not in ('stripe', 'clover')">
                    <field name="ddtp_card_fee_rate"/>
                    <field name="ddtp_card_fee_product_id"/>
                    <field name="ddtp_payment_notification_partner_ids" widget="many2many_tags"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
