<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_stripe_refund" model="ir.ui.view">
        <field name="name">account.move.form.stripe.refund</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_ddsr_request_stripe_refund" type="object"
                        string="Solicitar devolución"
                        class="btn-secondary"
                        groups="doorandoor_control_cobros.group_ddc_user"
                        invisible="move_type != 'out_invoice' or state != 'posted' or payment_state not in ('paid', 'in_payment')"/>
            </xpath>
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button name="action_ddsr_view_stripe_refunds" type="object"
                        class="oe_stat_button" icon="fa-undo"
                        invisible="ddsr_refund_request_count == 0">
                    <field name="ddsr_refund_request_count" widget="statinfo" string="Devoluciones Stripe"/>
                </button>
            </xpath>
        </field>
    </record>
    <record id="view_move_form_stripe_refund_quantities" model="ir.ui.view">
        <field name="name">account.move.form.stripe.refund.quantities</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='quantity']" position="after">
                <field name="ddsr_refunded_quantity" optional="show" readonly="1"/>
                <field name="ddsr_net_quantity" optional="show" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
