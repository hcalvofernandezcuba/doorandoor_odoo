<odoo>
    <record id="ddsr_settlement_view_list" model="ir.ui.view">
        <field name="name">doorandoor.stripe.settlement.list</field>
        <field name="model">doorandoor.stripe.settlement</field>
        <field name="arch" type="xml">
            <list create="0" delete="0">
                <field name="name"/>
                <field name="provider_id"/>
                <field name="arrival_date"/>
                <field name="stripe_status" widget="badge"/>
                <field name="gross_amount" sum="Bruto"/>
                <field name="fee_amount" sum="Comisiones"/>
                <field name="net_amount" sum="Neto"/>
                <field name="payout_amount" sum="Liquidación"/>
                <field name="difference_amount" sum="Diferencia"/>
                <field name="match_state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="ddsr_settlement_view_form" model="ir.ui.view">
        <field name="name">doorandoor.stripe.settlement.form</field>
        <field name="model">doorandoor.stripe.settlement</field>
        <field name="arch" type="xml">
            <form create="0" delete="0">
                <header>
                    <button name="action_ddsr_propose_bank_line" type="object"
                            string="Buscar depósito" class="btn-secondary"/>
                    <button name="action_ddsr_confirm_proposal" type="object"
                            string="Confirmar propuesta" class="btn-primary"
                            invisible="not statement_line_id or match_state == 'confirmed'"/>
                    <field name="match_state" widget="statusbar" statusbar_visible="pending,proposed,confirmed"/>
                </header>
                <sheet>
                    <h1><field name="name"/></h1>
                    <group>
                        <group>
                            <field name="provider_id"/>
                            <field name="journal_id"/>
                            <field name="stripe_payout_id"/>
                            <field name="stripe_status"/>
                        </group>
                        <group>
                            <field name="currency_id"/>
                            <field name="stripe_created_at"/>
                            <field name="arrival_date"/>
                            <field name="description"/>
                        </group>
                    </group>
                    <group string="Totales">
                        <field name="gross_amount"/>
                        <field name="fee_amount"/>
                        <field name="net_amount"/>
                        <field name="payout_amount"/>
                        <field name="difference_amount"/>
                    </group>
                    <group string="Depósito bancario">
                        <field name="statement_line_id"
                               domain="[('journal_id', '=', journal_id), ('amount', '&gt;', 0)]"/>
                    </group>
                    <notebook>
                        <page string="Movimientos Stripe">
                            <field name="line_ids">
                                <list create="0" delete="0">
                                    <field name="available_date"/>
                                    <field name="transaction_type"/>
                                    <field name="source_reference"/>
                                    <field name="description"/>
                                    <field name="amount" sum="Bruto"/>
                                    <field name="fee" sum="Comisiones"/>
                                    <field name="net" sum="Neto"/>
                                    <field name="payment_transaction_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="ddsr_settlement_action" model="ir.actions.act_window">
        <field name="name">Liquidaciones Stripe</field>
        <field name="res_model">doorandoor.stripe.settlement</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>

