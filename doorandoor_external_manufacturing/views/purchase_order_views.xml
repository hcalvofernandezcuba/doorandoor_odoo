<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_ddem" model="ir.ui.view">
        <field name="name">purchase.order.form.ddem</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_ref']" position="after">
                <field name="ddem_external_order_id" readonly="1" invisible="not ddem_external_order_id"/>
                <field name="ddem_sale_order_id" readonly="1" invisible="not ddem_external_order_id"/>
                <field name="ddem_logistic_route" readonly="1" invisible="not ddem_external_order_id"/>
            </xpath>
        </field>
    </record>
</odoo>
