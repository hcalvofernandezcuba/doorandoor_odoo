<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ddem_external_order_list" model="ir.ui.view">
        <field name="name">ddem.external.order.list</field>
        <field name="model">ddem.external.order</field>
        <field name="arch" type="xml">
            <list decoration-success="state in ('received', 'delivered')" decoration-danger="state == 'issue'" decoration-warning="not ready_to_order and state == 'draft'">
                <field name="name"/>
                <field name="sale_order_id"/>
                <field name="customer_id"/>
                <field name="vendor_id"/>
                <field name="supply_route"/>
                <field name="logistic_route"/>
                <field name="warehouse_id"/>
                <field name="promised_date"/>
                <field name="payment_percent"/>
                <field name="margin_percent"/>
                <field name="ready_to_order"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_ddem_external_order_form" model="ir.ui.view">
        <field name="name">ddem.external.order.form</field>
        <field name="model">ddem.external.order</field>
        <field name="arch" type="xml">
            <form string="Pedido externo">
                <header>
                    <button name="action_manager_approve" type="object" string="Aprobar Gerencia" class="btn-secondary" invisible="not manager_approval_required or manager_approved or state != 'draft'" groups="purchase.group_purchase_manager,base.group_system"/>
                    <button name="action_check_ready" type="object" string="Comprobar y liberar" class="btn-secondary" invisible="state != 'draft'"/>
                    <button name="action_create_purchase_order" type="object" string="Crear orden de compra" class="btn-primary" invisible="state not in ('draft', 'ready') or purchase_order_id" groups="purchase.group_purchase_user,base.group_system"/>
                    <button name="action_open_purchase_order" type="object" string="Abrir compra" class="btn-primary" invisible="not purchase_order_id"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,ready,ordered,manufacturing,ready_pickup,received,delivered"/>
                </header>
                <sheet>
                    <div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div>
                    <div class="alert alert-danger" role="alert" invisible="ready_to_order or state not in ('draft', 'ready')">
                        <strong>Pedido bloqueado:</strong><field name="blocking_reason" nolabel="1"/>
                    </div>
                    <div class="alert alert-success" role="alert" invisible="not ready_to_order or state not in ('draft', 'ready')">
                        Controles completos. El pedido puede generar una orden de compra en borrador.
                    </div>
                    <group>
                        <group string="Origen">
                            <field name="sale_order_id" readonly="state != 'draft'"/>
                            <field name="customer_id" readonly="1"/>
                            <field name="salesperson_id" readonly="1"/>
                            <field name="vendor_id" readonly="state != 'draft'"/>
                            <field name="vendor_quote_reference" readonly="state not in ('draft', 'ready')"/>
                            <field name="vendor_quote_attachment_ids" widget="many2many_binary" readonly="state not in ('draft', 'ready')"/>
                        </group>
                        <group string="Ruta del pedido">
                            <field name="supply_route" readonly="state != 'draft'"/>
                            <field name="logistic_route" readonly="state != 'draft'"/>
                            <field name="warehouse_id" invisible="logistic_route == 'direct'" readonly="state != 'draft'"/>
                            <field name="requested_date" readonly="state not in ('draft', 'ready')"/>
                            <field name="promised_date" readonly="state in ('received', 'delivered', 'cancelled')"/>
                            <field name="purchase_order_id" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Productos">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="sale_line_id"/>
                                    <field name="product_id"/>
                                    <field name="description" optional="hide"/>
                                    <field name="quantity"/>
                                    <field name="product_uom_id"/>
                                    <field name="sale_unit_price"/>
                                    <field name="vendor_unit_price" groups="purchase.group_purchase_user,base.group_system"/>
                                    <field name="sale_subtotal"/>
                                    <field name="vendor_subtotal"/>
                                </list>
                            </field>
                        </page>
                        <page string="Controles">
                            <group>
                                <group string="Firma y pago">
                                    <field name="policy_ok" readonly="1"/>
                                    <field name="paid_amount" readonly="1"/>
                                    <field name="payment_percent" readonly="1" widget="percentage"/>
                                    <field name="min_payment_percent" readonly="state != 'draft'"/>
                                    <field name="payment_ok" readonly="1"/>
                                </group>
                                <group string="Margen y aprobación">
                                    <field name="sale_amount" readonly="1"/>
                                    <field name="vendor_amount" readonly="1" groups="purchase.group_purchase_user,base.group_system"/>
                                    <field name="margin_percent" readonly="1" groups="purchase.group_purchase_user,base.group_system"/>
                                    <field name="min_margin_percent" readonly="state != 'draft'" groups="purchase.group_purchase_manager,base.group_system"/>
                                    <field name="margin_ok" readonly="1" groups="purchase.group_purchase_user,base.group_system"/>
                                    <field name="manager_approval_required" readonly="state != 'draft'" groups="purchase.group_purchase_manager,base.group_system"/>
                                    <field name="manager_approved" readonly="1"/>
                                    <field name="manager_approved_by_id" readonly="1" invisible="not manager_approved"/>
                                    <field name="manager_approved_at" readonly="1" invisible="not manager_approved"/>
                                </group>
                            </group>
                        </page>
                        <page string="Instrucciones"><field name="notes"/></page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_ddem_external_order_search" model="ir.ui.view">
        <field name="name">ddem.external.order.search</field>
        <field name="model">ddem.external.order</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="sale_order_id"/>
                <field name="customer_id"/>
                <field name="vendor_id"/>
                <field name="warehouse_id"/>
                <filter name="blocked" string="Bloqueados" domain="[('ready_to_order', '=', False), ('state', '=', 'draft')]"/>
                <filter name="ready" string="Listos para ordenar" domain="[('ready_to_order', '=', True), ('state', 'in', ('draft', 'ready'))]"/>
                <filter name="active" string="En proceso" domain="[('state', 'in', ('ordered', 'manufacturing', 'ready_pickup'))]"/>
                <filter name="issues" string="Con incidencia" domain="[('state', '=', 'issue')]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_vendor" string="Proveedor" context="{'group_by': 'vendor_id'}"/>
                    <filter name="group_state" string="Estado" context="{'group_by': 'state'}"/>
                    <filter name="group_warehouse" string="Almacén" context="{'group_by': 'warehouse_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_ddem_external_order" model="ir.actions.act_window">
        <field name="name">Pedidos externos</field>
        <field name="res_model">ddem.external.order</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_ddem_external_order_search"/>
    </record>

    <menuitem id="menu_ddem_external_order" name="Pedidos externos" parent="purchase.menu_purchase_root" action="action_ddem_external_order" sequence="42" groups="sales_team.group_sale_salesman,purchase.group_purchase_user"/>
</odoo>
