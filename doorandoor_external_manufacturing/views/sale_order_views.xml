<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_ddem" model="ir.ui.view">
        <field name="name">sale.order.form.ddem</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_ddem_prepare_external_orders" type="object" string="Preparar pedido externo" class="btn-secondary" invisible="state not in ('draft', 'sent', 'sale')" groups="sales_team.group_sale_salesman"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_ddem_view_external_orders" type="object" class="oe_stat_button" icon="fa-industry" invisible="ddem_external_order_count == 0">
                    <field name="ddem_external_order_count" widget="statinfo" string="Pedidos externos"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
