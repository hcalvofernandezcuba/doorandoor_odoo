<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_ddsn_invoice_number_guard" model="ir.ui.view">
        <field name="name">account.move.form.ddsn.invoice.number.guard</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="priority">1000</field>
        <field name="arch" type="xml">
            <xpath expr="//h1/field[@name='name']" position="attributes">
                <attribute name="readonly">1</attribute>
                <attribute name="invisible">state == 'draft'</attribute>
            </xpath>
            <xpath expr="//h1" position="inside">
                <span invisible="state != 'draft'">Borrador</span>
            </xpath>
        </field>
    </record>
</odoo>
