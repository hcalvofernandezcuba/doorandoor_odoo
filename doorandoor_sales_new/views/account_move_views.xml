<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_move_form_inherit_doorandoor_sales_new" model="ir.ui.view">
            <field name="name">account.move.form.doorandoor.sales.new</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="priority">99</field>
            <field name="arch" type="xml">
                <!-- Fiscal invoice numbers are generated by Odoo.  Draft
                     invoices, including preinvoices, must never expose the
                     editable technical `name` field to commercial users. -->
                <xpath expr="//h1/field[@name='name']" position="attributes">
                    <attribute name="readonly">1</attribute>
                    <attribute name="invisible">state == 'draft'</attribute>
                </xpath>
                <xpath expr="//h1" position="inside">
                    <span invisible="state != 'draft'">Borrador</span>
                </xpath>
                <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                    <button
                        name="action_sync_fulfillment"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-refresh"
                        invisible="move_type not in ('out_invoice', 'out_refund')">
                        <div class="o_stat_info">
                            <span class="o_stat_text">Sync</span>
                            <span class="o_stat_text">Fulfillment</span>
                        </div>
                    </button>
                    <button
                        name="action_view_generated_sale_order"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-shopping-cart"
                        invisible="move_type not in ('out_invoice', 'out_refund')">
                        <field name="sale_order_id" string="Sale Order" widget="statinfo"/>
                    </button>
                    <button
                        name="action_view_fulfillment_lines"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-tasks"
                        invisible="move_type not in ('out_invoice', 'out_refund')">
                        <field name="fulfillment_line_count" string="Fulfillment" widget="statinfo"/>
                    </button>
                    <button
                        name="action_view_pickings"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-truck"
                        invisible="move_type not in ('out_invoice', 'out_refund')">
                        <field name="picking_count" string="Dispatches" widget="statinfo"/>
                    </button>
                    <button
                        name="action_view_ddsn_supply_transfers"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-exchange"
                        invisible="not ddsn_supply_transfer_count">
                        <field name="ddsn_supply_transfer_count" string="Traslados internos" widget="statinfo"/>
                    </button>
                    <button
                        name="action_view_mrp_productions"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-industry"
                        invisible="move_type not in ('out_invoice', 'out_refund')">
                        <field name="mrp_production_count" string="Manufacturing" widget="statinfo"/>
                    </button>
                    <button
                        name="%(action_doorandoor_payment_release_log)d"
                        type="action"
                        class="oe_stat_button"
                        icon="fa-money"
                        invisible="move_type not in ('out_invoice', 'out_refund')">
                        <field name="payment_release_log_count" string="Releases" widget="statinfo"/>
                    </button>
                    <button
                        name="action_view_pickup_orders"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-archive"
                        invisible="move_type not in ('out_invoice', 'out_refund')">
                        <field name="pickup_order_count" string="Pickup Orders" widget="statinfo"/>
                    </button>
                </xpath>

                <xpath expr="//header/button[@name='action_post'][2]" position="replace">
                    <button
                        name="action_post"
                        string="Confirmar"
                        class="oe_highlight"
                        type="object"
                        invisible="ddsn_is_preinvoice or state != 'draft'"/>
                </xpath>

                <xpath expr="//header/button[@name='button_draft']" position="attributes">
                    <attribute name="groups">base.group_system</attribute>
                </xpath>

                <xpath expr="//sheet" position="attributes">
                    <attribute name="readonly">state in ('posted', 'cancel')</attribute>
                </xpath>

                <xpath expr="//header" position="inside">
                    <field name="ddsn_is_preinvoice" invisible="1"/>
                    <field name="ddsn_preinvoice_state" invisible="1"/>
                    <field name="ddsn_preinvoice_number" invisible="1"/>
                    <field name="ddsn_created_invoice_id" invisible="1"/>
                    <field name="ddsn_po_first_flow" invisible="1"/>
                    <field name="ddsn_admin_unrestricted_print" invisible="1"/>
                    <button
                        name="action_ddsn_change_supply_warehouse"
                        type="object"
                        string="Cambiar almacén proveedor"
                        invisible="move_type != 'out_invoice' or state != 'draft' or not invoice_line_ids"/>
                    <button
                        name="action_ddsn_confirm_preinvoice"
                        type="object"
                        string="Confirmar prefactura"
                        class="oe_highlight"
                        invisible="not ddsn_is_preinvoice or ddsn_preinvoice_state != 'draft'"/>
                    <button
                        name="action_ddsn_create_invoice_from_preinvoice"
                        type="object"
                        string="Crear factura"
                        class="oe_highlight"
                        invisible="not ddsn_is_preinvoice or ddsn_preinvoice_state != 'confirmed' or ddsn_created_invoice_id"/>
                    <button
                        name="action_ddsn_print_po"
                        type="object"
                        string="Emitir / Imprimir PO"
                        class="oe_highlight"
                        invisible="1"/>
                    <button
                        name="action_ddsn_open_po_delivery"
                        type="object"
                        string="Entregas"
                        class="oe_highlight"
                        invisible="1"/>
                    <button
                        name="action_ddsn_create_invoice_from_preinvoice"
                        type="object"
                        string="Abrir factura"
                        invisible="not ddsn_is_preinvoice or not ddsn_created_invoice_id"/>
                    <button
                        name="action_ddsn_reset_preinvoice_draft"
                        type="object"
                        string="Volver a borrador"
                        groups="base.group_system"
                        invisible="not ddsn_is_preinvoice or ddsn_preinvoice_state != 'confirmed' or ddsn_created_invoice_id"/>
                    <button
                        name="action_ddsn_preview_invoice"
                        type="object"
                        string="Vista previa"
                        invisible="state != 'posted' or move_type not in ('out_invoice', 'out_refund')"/>
                    <button
                        name="action_print_pdf"
                        type="object"
                        string="Imprimir"
                        invisible="move_type not in ('out_invoice', 'out_refund') or (not ddsn_admin_unrestricted_print and ((ddsn_is_preinvoice and state != 'draft') or (not ddsn_is_preinvoice and (state != 'posted' or payment_state != 'paid'))))"/>
                    <button
                        name="action_invoice_sent"
                        type="object"
                        string="Enviar"
                        invisible="state != 'posted' or payment_state != 'paid' or move_type not in ('out_invoice', 'out_refund')"/>
                    <button
                        name="action_ddsn_renew_preinvoice_reservation"
                        type="object"
                        string="Renovar reserva"
                        invisible="state != 'draft' or move_type not in ('out_invoice', 'out_refund') or not ddsn_is_preinvoice or ddsn_preinvoice_state != 'confirmed' or ddsn_reservation_status != 'expired'"/>
                    <field
                        name="ddsn_document_stage"
                        widget="statusbar"
                        statusbar_visible="preinvoice,invoice,cancelled"
                        invisible="move_type not in ('out_invoice', 'out_refund')"/>
                    <button
                        name="action_create_pickup_orders"
                        type="object"
                        string="Create Pickup Order"
                        invisible="move_type not in ('out_invoice', 'out_refund')"/>
                </xpath>

                <xpath expr="//h1/span[@invisible='name or name_placeholder or quick_edit_mode']" position="replace">
                    <span invisible="name or name_placeholder or quick_edit_mode or move_type not in ('out_invoice', 'out_refund') or not ddsn_is_preinvoice">Prefactura</span>
                    <span invisible="name or name_placeholder or quick_edit_mode or move_type not in ('out_invoice', 'out_refund') or ddsn_is_preinvoice">Factura</span>
                    <span invisible="name or name_placeholder or quick_edit_mode or move_type in ('out_invoice', 'out_refund')">Borrador</span>
                </xpath>

                <xpath expr="//h1/field[@name='name']" position="before">
                    <field name="ddsn_preinvoice_number"
                           placeholder="Nueva prefactura"
                           readonly="1"
                           invisible="not ddsn_is_preinvoice"/>
                </xpath>
                <xpath expr="//h1/field[@name='name']" position="attributes">
                    <attribute name="invisible">ddsn_is_preinvoice</attribute>
                </xpath>

                <xpath expr="//field[@name='partner_id']" position="attributes">
                    <attribute name="readonly">ddsn_is_preinvoice and ddsn_preinvoice_state == 'confirmed'</attribute>
                </xpath>
                <xpath expr="//field[@name='partner_shipping_id']" position="attributes">
                    <attribute name="readonly">ddsn_is_preinvoice and ddsn_preinvoice_state == 'confirmed'</attribute>
                </xpath>
                <xpath expr="//field[@name='invoice_date']" position="attributes">
                    <attribute name="readonly">ddsn_is_preinvoice and ddsn_preinvoice_state == 'confirmed'</attribute>
                </xpath>
                <xpath expr="//field[@name='invoice_payment_term_id']" position="attributes">
                    <attribute name="readonly">ddsn_is_preinvoice and ddsn_preinvoice_state == 'confirmed'</attribute>
                </xpath>
                <xpath expr="//field[@name='invoice_line_ids']" position="attributes">
                    <attribute name="readonly">state != 'draft' or (ddsn_is_preinvoice and ddsn_preinvoice_state == 'confirmed')</attribute>
                </xpath>

                <xpath expr="//field[@name='partner_shipping_id']" position="after">
                    <field
                        name="ddsn_shipping_address_summary"
                        widget="text"
                        readonly="1"
                        nolabel="1"
                        placeholder="La direccion de entrega seleccionada se mostrara aqui."
                        invisible="move_type not in ('out_invoice', 'out_refund')"/>
                </xpath>

                <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='quantity']" position="after">
                    <field name="ddsn_stock_display" string="Stock" readonly="1" optional="show"/>
                    <field name="ddsn_warehouse_stock_display" string="Almacenes" widget="ddsn_stock_tooltip" readonly="1" optional="show"/>
                    <field name="ddsn_warehouse_stock_html" string="Warehouses HTML" widget="html" readonly="1" optional="hide"/>
                    <field name="ddsn_supply_warehouse_id" string="Almacén proveedor" optional="show"/>
                    <field name="ddsn_supply_transfer_id" string="Traslado" readonly="1" optional="hide"/>
                    <field name="ddsn_bonus_percent" string="Bonus %" readonly="1" optional="hide"/>
                    <field name="ddsn_bonus_source" string="Bonus Source" readonly="1" optional="hide"/>
                    <field name="ddsn_bonus_rule_reference" string="Bonus Rule" readonly="1" optional="hide"/>
                    <field name="ddsn_bonus_authorized_by_id" string="Authorized By" readonly="1" optional="hide"/>
                </xpath>
                <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='price_unit']" position="before">
                    <field name="ddsn_can_edit_commercial_price" column_invisible="True"/>
                </xpath>
                <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='price_unit']" position="attributes">
                    <attribute name="readonly">not ddsn_can_edit_commercial_price</attribute>
                </xpath>
                <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='discount']" position="attributes">
                    <attribute name="readonly">not ddsn_can_edit_commercial_price</attribute>
                </xpath>
                <xpath expr="//field[@name='invoice_line_ids']/form//field[@name='price_unit']" position="attributes">
                    <attribute name="readonly">not ddsn_can_edit_commercial_price</attribute>
                </xpath>
                <xpath expr="//field[@name='invoice_line_ids']/form//field[@name='discount']" position="attributes">
                    <attribute name="readonly">not ddsn_can_edit_commercial_price</attribute>
                </xpath>

                <xpath expr="//field[@name='invoice_line_ids']/form//field[@name='product_id']" position="after">
                    <group string="Stock Visibility" colspan="2">
                        <field name="ddsn_stock_display" readonly="1"/>
                        <field name="ddsn_warehouse_stock_html" readonly="1" widget="html"/>
                        <field name="ddsn_warehouse_stock_text" readonly="1" widget="text"/>
                        <field name="ddsn_supply_warehouse_id"/>
                        <field name="ddsn_supply_transfer_id" readonly="1"/>
                    </group>
                </xpath>

                <xpath expr="//field[@name='tax_totals']" position="replace">
                    <div class="oe_subtotal_footer oe_right" colspan="2">
                        <table class="oe_subtotal_footer_table w-100">
                            <tr>
                                <td class="text-end"><label for="amount_untaxed" string="Subtotal"/></td>
                                <td class="text-end ps-2"><field name="amount_untaxed" nolabel="1" readonly="1"/></td>
                            </tr>
                            <tr>
                                <td class="text-end"><label for="amount_tax" string="Total de Impuestos"/></td>
                                <td class="text-end ps-2"><field name="amount_tax" nolabel="1" readonly="1"/></td>
                            </tr>
                            <tr>
                                <td class="text-end oe_subtotal_footer_separator"><label for="amount_total" string="Total"/></td>
                                <td class="text-end ps-2 oe_subtotal_footer_separator">
                                    <field name="amount_total" nolabel="1" readonly="1" class="fw-bold"/>
                                </td>
                            </tr>
                        </table>
                    </div>
                </xpath>

                <xpath expr="//notebook" position="inside">
                    <page string="Fulfillment Setup" invisible="move_type not in ('out_invoice', 'out_refund')">
                        <group string="DoorAndDoor Fulfillment">
                            <group>
                                <field name="sale_order_id" readonly="1"/>
                                <field name="release_state"/>
                                <field name="payment_release_policy"/>
                                <field name="fulfillment_route_policy"/>
                            </group>
                            <group>
                                <field name="partial_stock_policy"/>
                                <field name="picking_creation_policy"/>
                                <field name="mrp_creation_policy"/>
                                <field name="ddsn_reservation_expires_at" readonly="1"/>
                                <field name="ddsn_reservation_status" readonly="1"/>
                            </group>
                        </group>
                    </page>
                    <page string="Fulfillment" invisible="move_type not in ('out_invoice', 'out_refund')">
                        <field name="fulfillment_line_ids" readonly="1">
                            <list>
                                <field name="product_id"/>
                                <field name="amount_total"/>
                                <field name="amount_released"/>
                                <field name="picking_id"/>
                                <field name="mrp_production_id"/>
                                <field name="state"/>
                            </list>
                        </field>
                    </page>
                    <page string="Payment Releases" invisible="move_type not in ('out_invoice', 'out_refund')">
                        <field name="payment_release_log_ids" readonly="1">
                            <list>
                                <field name="amount_applied"/>
                                <field name="policy_used"/>
                                <field name="notes"/>
                                <field name="write_date"/>
                            </list>
                        </field>
                    </page>
                    <page string="Pickup Orders" invisible="move_type not in ('out_invoice', 'out_refund')">
                        <field name="pickup_order_ids" readonly="1">
                            <list>
                                <field name="name"/>
                                <field name="warehouse_id"/>
                                <field name="picking_id"/>
                                <field name="amount_total"/>
                                <field name="state"/>
                                <field name="delivered_date"/>
                            </list>
                        </field>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
