<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="report_invoice_document_hide_line_taxes" inherit_id="account.report_invoice_document">
            <xpath expr="//th[@name='th_taxes']" position="replace"/>
            <xpath expr="//td[@name='td_taxes']" position="replace"/>
            <xpath expr="//p[@name='payment_communication']" position="replace"/>
            <xpath expr="//div[@name='shipping_address_block']" position="attributes">
                <attribute name="style">font-size: 9px; line-height: 1.1;</attribute>
            </xpath>
            <xpath expr="//div[@name='address_not_same_as_shipping']" position="attributes">
                <attribute name="style">font-size: 9px; line-height: 1.1;</attribute>
            </xpath>
            <xpath expr="//div[@name='address_same_as_shipping']" position="attributes">
                <attribute name="style">font-size: 9px; line-height: 1.1;</attribute>
            </xpath>
            <xpath expr="//div[@name='no_shipping']" position="attributes">
                <attribute name="style">font-size: 9px; line-height: 1.1;</attribute>
            </xpath>
            <xpath expr="//address[@class='mb-0']" position="attributes">
                <attribute name="style">font-size: 9px; line-height: 1.1;</attribute>
            </xpath>
            <xpath expr="//div[@id='partner_vat_address_not_same_as_shipping']" position="attributes">
                <attribute name="style">font-size: 9px; line-height: 1.1;</attribute>
            </xpath>
            <xpath expr="//div[@id='partner_vat_address_same_as_shipping']" position="attributes">
                <attribute name="style">font-size: 9px; line-height: 1.1;</attribute>
            </xpath>
            <xpath expr="//div[@id='partner_vat_no_shipping']" position="attributes">
                <attribute name="style">font-size: 9px; line-height: 1.1;</attribute>
            </xpath>
            <xpath expr="//div[hasclass('page')]" position="attributes">
                <attribute name="style">font-size: 11px; line-height: 1.15;</attribute>
            </xpath>
            <xpath expr="//div[@id='informations']" position="attributes">
                <attribute name="class">row mb-2</attribute>
            </xpath>
            <xpath expr="//table[@name='invoice_line_table']" position="attributes">
                <attribute name="style">font-size: 14px; line-height: 1.2; margin-top: 2px;</attribute>
            </xpath>
            <xpath expr="//table[@name='invoice_line_table']/thead/tr" position="attributes">
                <attribute name="style">border-bottom: 1px solid #ddd;</attribute>
            </xpath>
            <xpath expr="//table[@name='invoice_line_table']/tbody" position="attributes">
                <attribute name="style">line-height: 1.15;</attribute>
            </xpath>
            <xpath expr="//td[@name='account_invoice_line_name']" position="attributes">
                <attribute name="style">padding-top: 4px; padding-bottom: 4px;</attribute>
            </xpath>
            <xpath expr="//td[@name='td_quantity']" position="attributes">
                <attribute name="style">padding-top: 4px; padding-bottom: 4px;</attribute>
            </xpath>
            <xpath expr="//td[@name='td_price_unit']" position="attributes">
                <attribute name="style">padding-top: 4px; padding-bottom: 4px;</attribute>
            </xpath>
            <xpath expr="//td[@name='td_subtotal']" position="attributes">
                <attribute name="style">padding-top: 4px; padding-bottom: 4px;</attribute>
            </xpath>
            <xpath expr="//div[@id='right-elements']" position="attributes">
                <attribute name="class">col-4 mt-2 ms-3 d-inline-block float-end</attribute>
            </xpath>
            <xpath expr="//div[@id='payment_term']" position="attributes">
                <attribute name="class">clearfix mt-1</attribute>
            </xpath>
            <xpath expr="//t[@t-if='o.tax_totals' and @t-call='account.document_tax_totals']" position="replace">
                <t t-if="o.tax_totals" t-call="doorandoor_sales_new.document_tax_totals_invoice_only">
                    <t t-set="tax_totals" t-value="o.tax_totals"/>
                    <t t-set="currency" t-value="o.currency_id"/>
                </t>
            </xpath>
        </template>

        <template id="document_tax_totals_invoice_only">
            <t t-foreach="tax_totals['subtotals']" t-as="subtotal">
                <tr class="o_subtotal">
                    <td>
                        <span t-out="subtotal['name']">Untaxed Amount</span>
                    </td>
                    <td class="text-end">
                        <span t-att-class="oe_subtotal_footer_separator"
                              t-out="subtotal['base_amount_currency']"
                              t-options='{"widget": "monetary", "display_currency": currency}'
                        >27.00</span>
                    </td>
                </tr>
            </t>

            <tr t-if="tax_totals.get('total_amount_currency') != tax_totals.get('base_amount_currency')" class="o_taxes">
                <td>Total de impuestos</td>
                <td class="text-end o_price_total">
                    <span class="text-nowrap"
                          t-out="tax_totals['total_amount_currency'] - tax_totals['base_amount_currency']"
                          t-options='{"widget": "monetary", "display_currency": currency}'
                    >0.00</span>
                </td>
            </tr>

            <tr t-if="'cash_rounding_base_amount_currency' in tax_totals">
                <td>Rounding</td>
                <td class="text-end">
                    <span t-out="tax_totals['cash_rounding_base_amount_currency']"
                          t-options='{"widget": "monetary", "display_currency": currency}'
                    >0</span>
                </td>
            </tr>

            <tr class="o_total">
                <td><strong>Total</strong></td>
                <td class="text-end">
                    <strong t-out="tax_totals['total_amount_currency']"
                            t-options='{"widget": "monetary", "display_currency": currency}'
                    >31.05</strong>
                </td>
            </tr>
        </template>

        <template id="report_invoice_document_signature" inherit_id="account.report_invoice_document">
            <xpath expr="//div[hasclass('page')]" position="inside">
                <div class="mt-2 pt-1">
                    <div class="row mb-2 align-items-start">
                        <div class="col-8">
                            <div>
                                <strong>Codigo de documento</strong>
                            </div>
                            <div class="mt-1">
                                <img t-att-src="o._ddsn_get_barcode_img_src()" alt="Invoice Barcode" style="max-width: 250px; max-height: 55px;"/>
                            </div>
                        </div>
                        <div class="col-4 text-end">
                            <div>
                                <strong>Escanear para abrir</strong>
                            </div>
                            <div class="mt-1">
                                <img t-att-src="o._ddsn_get_document_qr_img_src()" alt="Invoice QR" style="width: 72px; height: 72px;"/>
                            </div>
                        </div>
                    </div>
                    <t t-set="invoice_pickings" t-value="o.fulfillment_line_ids.mapped('picking_id')"/>
                    <t t-if="invoice_pickings">
                        <div class="mb-1" style="font-size: 10px;">
                            <strong>Dispatch Order</strong>:
                            <span t-esc="', '.join(invoice_pickings.mapped('name'))"/>
                        </div>
                    </t>
                    <div class="row">
                        <div class="col-6">
                            <t t-set="salesperson_history" t-value="o._ddsn_get_salesperson_history()"/>
                            <t t-set="document_salesperson" t-value="o.invoice_user_id or o.sale_order_id.user_id or o.create_uid"/>
                            <div style="margin-top: 12px; font-size: 10px;">
                                <strong t-if="len(salesperson_history) &lt;= 1">Comercial</strong>
                                <strong t-else="">Comercial inicial</strong>
                            </div>
                            <div style="border-top: 1px solid #000; margin-top: 18px; padding-top: 3px; min-height: 14px; font-size: 10px;">
                                <span t-esc="salesperson_history[0] if salesperson_history else (o.invoice_user_id or o.create_uid).name"/>
                                <t t-if="document_salesperson.partner_id.phone or document_salesperson.partner_id.mobile or document_salesperson.ddco_office_id.phone">
                                    <br/><strong>Phone:</strong>
                                    <span t-esc="document_salesperson.partner_id.phone or document_salesperson.partner_id.mobile or document_salesperson.ddco_office_id.phone"/>
                                </t>
                            </div>
                            <div t-foreach="salesperson_history[1:]" t-as="salesperson_name" class="mt-1" style="font-size: 10px;">
                                <strong>Cambio de comercial:</strong>
                                <span t-esc="salesperson_name"/>
                            </div>
                        </div>
                        <div class="col-6 text-end">
                            <div style="margin-top: 12px; font-size: 10px;">
                                <strong>Received by</strong>
                            </div>
                            <div style="border-top: 1px solid #000; margin-top: 18px; padding-top: 3px; min-height: 14px; font-size: 10px;">
                                &amp;nbsp;
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </template>

        <!-- Reuse the four native Bubble layout zones for invoices.  This is
             deliberately conditional, so sales orders and deliveries retain
             their own established report header. -->
        <template id="external_layout_bubble_invoice_header" inherit_id="web.external_layout_bubble">
            <xpath expr="//div[@class='d-flex justify-content-between']/div[1]" position="replace">
                <div class="w-50">
                    <t t-if="o and o._name == 'account.move' and o.move_type == 'out_invoice'">
                        <div style="color: #000000;">
                            <strong>FACTURA</strong>
                            <div><span t-field="o.name"/></div>
                            <div t-if="o.invoice_date">
                                Fecha: <span t-field="o.invoice_date"/>
                            </div>
                        </div>
                    </t>
                    <t t-else="">
                        <img t-if="company.logo" class="o_company_logo mb-2" t-att-src="image_data_uri(company.logo)" alt="Logo"/>
                        <div t-if="company.report_header" t-field="company.report_header" class="o_company_tagline fw-bold">Lema de la empresa</div>
                    </t>
                </div>
            </xpath>
            <xpath expr="//div[@name='company_address']" position="replace">
                <div name="company_address" class="w-50 text-end">
                    <t t-if="o and o._name == 'account.move' and o.move_type == 'out_invoice'">
                        <div style="text-align: right; font-size: 10pt; line-height: 1.2;">
                            <img t-if="company.logo" class="o_company_logo" t-att-src="image_data_uri(company.logo)" alt="Door &amp; Door" style="display: block; max-height: 106px; max-width: 300px; position: relative; top: -2pt; margin: 0 0 3px auto;"/>
                            <address t-field="company.partner_id"
                                     t-options='{"widget": "contact", "fields": ["address"], "no_marker": true}'
                                     style="margin: 0;"/>
                            <div t-if="company.phone or company.mobile">
                                <span t-esc="company.phone or company.mobile"/>
                            </div>
                            <div style="margin-top: 7px; color: #000000;">
                                <strong>COMERCIAL</strong><br/>
                                <span t-esc="(o.invoice_user_id or o.sale_order_id.user_id or o.create_uid).name"/>
                                <span t-if="(o.invoice_user_id or o.sale_order_id.user_id or o.create_uid).partner_id.phone or (o.invoice_user_id or o.sale_order_id.user_id or o.create_uid).partner_id.mobile">
                                    <br/><span t-esc="(o.invoice_user_id or o.sale_order_id.user_id or o.create_uid).partner_id.phone or (o.invoice_user_id or o.sale_order_id.user_id or o.create_uid).partner_id.mobile"/>
                                </span>
                            </div>
                        </div>
                    </t>
                    <t t-else="">
                        <ul class="list-unstyled" name="company_address_list">
                            <li t-if="company.is_company_details_empty"><span t-field="company.partner_id" t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": true}'/></li>
                            <li t-else=""><span t-field="company.company_details"/></li>
                            <li t-if="not forced_vat and company.vat"><t t-esc="company.country_id.vat_label or 'Tax ID'"/>: <span t-esc="company.vat"/></li>
                            <li t-elif="forced_vat"><t t-esc="company.country_id.vat_label or 'Tax ID'"/>: <span t-esc="forced_vat"/></li>
                        </ul>
                    </t>
                </div>
            </xpath>
        </template>

