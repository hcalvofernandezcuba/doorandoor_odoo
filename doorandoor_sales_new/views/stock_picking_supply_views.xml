<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_picking_form_ddsn_supply_traceability" model="ir.ui.view">
            <field name="name">stock.picking.form.ddsn.supply.traceability</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='origin']" position="after">
                    <field name="ddsn_supply_invoice_id" readonly="1" invisible="not ddsn_supply_invoice_id"/>
                    <field name="ddsn_supply_preinvoice_id" readonly="1" invisible="not ddsn_supply_preinvoice_id"/>
                    <field name="ddsn_supply_source_warehouse_id" readonly="1" invisible="not ddsn_supply_invoice_id"/>
                    <field name="ddsn_supply_destination_warehouse_id" readonly="1" invisible="not ddsn_supply_invoice_id"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
