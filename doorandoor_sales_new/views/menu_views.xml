<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <menuitem
            id="menu_doorandoor_sales_new_root"
            name="DoorAndDoor Sales"
            parent="sale.sale_menu_root"
            sequence="90"/>

        <menuitem
            id="menu_doorandoor_fulfillment_line"
            name="Fulfillment Lines"
            parent="menu_doorandoor_sales_new_root"
            action="action_doorandoor_fulfillment_line"
            sequence="10"/>

        <record id="action_doorandoor_po_sales" model="ir.actions.act_window">
            <field name="name">POs</field>
            <field name="res_model">sale.order</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('ddsn_po_first_flow', '=', True), ('ddsn_po_issued_at', '!=', False)]</field>
            <field name="context">{'create': False}</field>
        </record>

        <menuitem
            id="menu_doorandoor_po_sales"
            name="POs"
            parent="menu_doorandoor_sales_new_root"
            action="action_doorandoor_po_sales"
            sequence="5"/>

        <menuitem
            id="menu_doorandoor_payment_release_log"
            name="Payment Release Logs"
            parent="menu_doorandoor_sales_new_root"
            action="action_doorandoor_payment_release_log"
            sequence="20"/>

        <menuitem
            id="menu_doorandoor_pickup_order"
            name="Pickup Orders"
            parent="menu_doorandoor_sales_new_root"
            action="action_doorandoor_pickup_order"
            sequence="30"/>

        <menuitem
            id="menu_doorandoor_pickup_order_inventory"
            name="Delivered Pickup Orders"
            parent="stock.menu_stock_root"
            action="action_doorandoor_pickup_order_inventory"
            sequence="95"/>
    </data>
</odoo>
