<odoo>
    <record id="module_category_inventory_count" model="ir.module.category">
        <field name="name">Inventory Counts</field>
        <field name="sequence">35</field>
    </record>
    <record id="group_inventory_count_user" model="res.groups">
        <field name="name">Inventory Counter</field>
        <field name="category_id" ref="module_category_inventory_count"/>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
    </record>
    <record id="group_inventory_count_manager" model="res.groups">
        <field name="name">Inventory Count Manager</field>
        <field name="category_id" ref="module_category_inventory_count"/>
        <field name="implied_ids" eval="[(4, ref('group_inventory_count_user')), (4, ref('stock.group_stock_manager'))]"/>
    </record>
    <record id="rule_inventory_count_company" model="ir.rule">
        <field name="name">Inventory sessions by company</field>
        <field name="model_id" ref="model_inventory_count_session"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_inventory_count_user'))]"/>
    </record>
    <record id="rule_inventory_count_line_company" model="ir.rule">
        <field name="name">Inventory count lines by company</field>
        <field name="model_id" ref="model_inventory_count_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_inventory_count_user'))]"/>
    </record>
    <record id="rule_inventory_count_item_line_company" model="ir.rule">
        <field name="name">Inventory item lines by company</field>
        <field name="model_id" ref="model_inventory_count_item_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_inventory_count_user'))]"/>
    </record>
</odoo>

