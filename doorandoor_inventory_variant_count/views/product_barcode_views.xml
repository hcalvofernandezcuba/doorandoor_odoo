<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_form_inventory_barcode" model="ir.ui.view">
        <field name="name">product.template.form.inventory.barcode</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="doorandoor_stock_labels.view_product_template_form_inherit_ddsl"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='barcode']" position="attributes">
                <attribute name="invisible">False</attribute>
            </xpath>
            <xpath expr="//field[@name='barcode']" position="after">
                <field name="ddic_shared_lot_serial"
                       groups="doorandoor_inventory_variant_count.group_inventory_count_manager,base.group_system"/>
                <button name="action_generate_doorandoor_barcode"
                        string="Generate Barcode"
                        type="object"
                        class="btn-secondary"
                        icon="fa-barcode"
                        invisible="barcode"
                        help="Generate a dated EAN-13 barcode for every variant whose barcode is blank."/>
            </xpath>
        </field>
    </record>

    <record id="view_product_variant_form_inventory_barcode" model="ir.ui.view">
        <field name="name">product.product.form.inventory.barcode</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='barcode']" position="attributes">
                <attribute name="invisible">False</attribute>
            </xpath>
            <xpath expr="//field[@name='barcode']" position="after">
                <button name="action_generate_doorandoor_barcode"
                        string="Generate Barcode"
                        type="object"
                        class="btn-secondary"
                        icon="fa-barcode"
                        invisible="barcode"
                        help="Generate a dated EAN-13 barcode when this field is blank."/>
            </xpath>
        </field>
    </record>
</odoo>
