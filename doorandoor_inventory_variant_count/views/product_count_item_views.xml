<odoo>
    <record id="view_product_count_item_list" model="ir.ui.view">
        <field name="name">product.count.item.list</field>
        <field name="model">product.count.item</field>
        <field name="arch" type="xml">
            <list editable="bottom" import="true" multi_edit="true">
                <field name="sequence" widget="handle"/>
                <field name="product_id"/>
                <field name="name"/>
                <field name="item_type"/>
                <field name="code" optional="show"/>
                <field name="barcode" optional="show"/>
                <field name="qty_per_product"/>
                <field name="uom_id"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_product_count_item_form" model="ir.ui.view">
        <field name="name">product.count.item.form</field>
        <field name="model">product.count.item</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" text="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="product_id"/>
                            <field name="name"/>
                            <field name="item_type"/>
                            <field name="qty_per_product"/>
                            <field name="uom_id"/>
                        </group>
                        <group>
                            <field name="code"/>
                            <field name="barcode"/>
                            <field name="active"/>
                            <field name="note"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_product_count_item" model="ir.actions.act_window">
        <field name="name">Variant Count Items</field>
        <field name="res_model">product.count.item</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_product': 1}</field>
    </record>
    <record id="product_product_form_count_items" model="ir.ui.view">
        <field name="name">product.product.form.count.items</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_count_items" type="object" class="oe_stat_button"
                        icon="fa-list-ol" groups="doorandoor_inventory_variant_count.group_inventory_count_user">
                    <field name="count_item_count" widget="statinfo" string="Count Items"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
