<odoo>
    <record id="view_inventory_count_session_list" model="ir.ui.view">
        <field name="name">inventory.count.session.list</field>
        <field name="model">inventory.count.session</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'done'" decoration-muted="state == 'cancel'">
                <field name="name"/>
                <field name="date"/>
                <field name="location_id"/>
                <field name="count_mode"/>
                <field name="load_reference" optional="show"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="line_count"/>
                <field name="difference_count"/>
                <field name="state"
                       widget="badge"
                       decoration-muted="state in ('draft', 'cancel')"
                       decoration-info="state == 'counting'"
                       decoration-warning="state == 'review'"
                       decoration-success="state == 'done'"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <record id="view_inventory_count_session_search" model="ir.ui.view">
        <field name="name">inventory.count.session.search</field>
        <field name="model">inventory.count.session</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="location_id"/>
                <field name="user_id"/>
                <filter name="my_counts" string="My Counts" domain="[('user_id', '=', uid)]"/>
                <separator/>
                <filter name="open" string="Open" domain="[('state', 'in', ['draft', 'counting', 'review'])]"/>
                <group expand="0" string="Group By">
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_location" string="Location" context="{'group_by': 'location_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="view_inventory_count_session_form" model="ir.ui.view">
        <field name="name">inventory.count.session.form</field>
        <field name="model">inventory.count.session</field>
        <field name="arch" type="xml">
            <form class="o_inventory_count_mobile">
                <header>
                    <button name="action_start" string="Iniciar y cargar existencias" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_review" string="Revisar" type="object" class="btn-primary" invisible="state != 'counting'"/>
                    <button name="action_print_serial_audit"
                            string="Control de seriales"
                            type="object"
                            invisible="not serial_campaign_id or state == 'draft'"/>
                    <button name="action_back_to_counting" string="Volver al conteo" type="object" invisible="state != 'review'"/>
                    <button name="action_validate" string="Validar ajuste" type="object" class="btn-primary" invisible="state != 'review'" groups="doorandoor_inventory_variant_count.group_inventory_count_manager" confirm="Esta acción aplicará el ajuste físico de inventario. ¿Desea continuar?"/>
                    <button name="action_cancel" string="Cancelar" type="object" invisible="state in ('done', 'cancel')"/>
                    <button name="action_reset_draft" string="Restablecer a borrador" type="object" invisible="state != 'cancel'" groups="doorandoor_inventory_variant_count.group_inventory_count_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,counting,review,done"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="allowed_location_ids" invisible="1"/>
                            <field name="location_id"
                                   readonly="state != 'draft'"
                                   options="{'no_create': True, 'no_create_edit': True, 'no_search_more': True}"/>
                            <field name="count_mode" readonly="state != 'draft'"/>
                            <field name="load_reference"
                                   invisible="count_mode != 'additive'"
                                   required="count_mode == 'additive'"
                                   readonly="state != 'draft'"
                                   placeholder="Ej.: TAMPA-LOTE-003"/>
                            <field name="serial_campaign_id"
                                   readonly="state != 'draft'"
                                   options="{'no_create': True}"/>
                            <field name="allowed_serial_batch_ids" invisible="1"/>
                            <field name="serial_batch_id"
                                   invisible="not serial_campaign_id"
                                   required="serial_campaign_id and state == 'draft'"
                                   readonly="state != 'draft'"
                                   domain="[('id', 'in', allowed_serial_batch_ids)]"
                                   options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="user_id" readonly="state in ('done', 'cancel')"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/>
                            <field name="line_count"/>
                            <field name="difference_count"/>
                            <field name="serial_expected_count" invisible="not serial_campaign_id"/>
                            <field name="serial_counted_count" invisible="not serial_campaign_id"/>
                            <field name="serial_pending_count" invisible="not serial_campaign_id"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert"
                         invisible="count_mode != 'additive' or state == 'cancel'">
                        Carga inicial acumulativa: la cantidad contada en este lote se sumará
                        a la existencia mostrada como Esperado. Revise Existencia resultante antes
                        de validar.
                    </div>
                    <div class="alert alert-warning" role="alert"
                         invisible="not serial_campaign_id or state == 'cancel'">
                        Conteo serializado por lote: solo se aceptan etiquetas únicas del lote seleccionado.
                        Un segundo escaneo de la misma unidad será rechazado en todas sus sesiones.
                    </div>
                    <group string="Captura por código de barras" invisible="state != 'counting'" class="o_inventory_scan_box">
                        <field name="barcode_input" placeholder="Escanee el código de barras..."/>
                        <field name="scan_qty"/>
                        <button name="action_scan" string="Agregar lectura" type="object" class="btn-primary" icon="fa-barcode"/>
                        <button name="action_open_configured_product"
                                string="Agregar producto configurado"
                                type="object"
                                class="btn-secondary"
                                icon="fa-sliders"/>
                    </group>
                    <notebook>
                        <page string="Ítems para contar" name="items">
                            <field name="item_line_ids" readonly="state not in ('counting', 'review')" context="{'default_session_id': id}">
                                <list editable="bottom" import="true" decoration-danger="is_counted and difference_qty != 0" decoration-success="is_counted and difference_qty == 0">
                                    <field name="product_id" readonly="1"/>
                                    <field name="item_id" readonly="1"/>
                                    <field name="item_code" optional="show" readonly="1"/>
                                    <field name="barcode" optional="show" readonly="1"/>
                                    <field name="expected_qty" readonly="1"/>
                                    <field name="counted_qty"/>
                                    <field name="is_counted"/>
                                    <field name="difference_qty" readonly="1"/>
                                    <field name="uom_id" readonly="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Variantes / Ajuste" name="variants">
                            <field name="line_ids" readonly="state in ('done', 'cancel')">
                                <list decoration-danger="is_counted and difference_qty != 0" decoration-success="is_counted and difference_qty == 0">
                                    <field name="product_id" readonly="1"/>
                                    <field name="lot_id" optional="show" readonly="1"/>
                                    <field name="package_id" optional="hide" readonly="1"/>
                                    <field name="owner_id" optional="hide" readonly="1"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="cost_price" string="Costo" optional="show" groups="base.group_system"/>
                                    <field name="sale_price" string="Precio" optional="show" groups="base.group_system"/>
                                    <field name="expected_qty" readonly="1"/>
                                    <field name="counted_qty" readonly="item_line_ids"/>
                                    <field name="is_counted" readonly="item_line_ids"/>
                                    <field name="difference_qty" readonly="1"/>
                                    <field name="result_qty" string="Existencia resultante" readonly="1"/>
                                    <field name="price_configured" optional="hide" groups="base.group_system"/>
                                    <field name="uom_id" readonly="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notas"><field name="note" placeholder="Observaciones, incidencias o aprobaciones..."/></page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_inventory_count_session" model="ir.actions.act_window">
        <field name="name">Sesiones de conteo de inventario</field>
        <field name="res_model">inventory.count.session</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_inventory_count_session_search"/>
        <field name="context">{'search_default_open': 1}</field>
    </record>
    <record id="action_inventory_count_item_lines" model="ir.actions.act_window">
        <field name="name">Importar o editar conteos de ítems</field>
        <field name="res_model">inventory.count.item.line</field>
        <field name="view_mode">list</field>
        <field name="domain">[('state', '=', 'counting')]</field>
        <field name="help" type="html"><p>Use Favorites → Import records to upload CSV or XLSX counts.</p></field>
    </record>
</odoo>
