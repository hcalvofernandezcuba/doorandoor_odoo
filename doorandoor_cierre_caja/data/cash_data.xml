    <record id="seq_cash_audit" model="ir.sequence"><field name="name">Auditoría sorpresa de caja</field><field name="code">doorandoor.cash.audit</field><field name="prefix">AUD-CAJA/%(year)s/</field><field name="padding">5</field></record>
    <record id="denomination_100" model="doorandoor.cash.denomination"><field name="name">USD 100</field><field name="value">100</field></record>
