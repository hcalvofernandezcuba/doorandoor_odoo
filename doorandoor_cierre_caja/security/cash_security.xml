<odoo>
    <record id="group_cashier" model="res.groups"><field name="name">Operador de caja</field><field name="category_id" ref="base.module_category_accounting"/></record>
    <record id="group_cash_manager" model="res.groups"><field name="name">Responsable de caja</field><field name="category_id" ref="base.module_category_accounting"/><field name="implied_ids" eval="[(4, ref('group_cashier'))]"/></record>
    <record id="base.group_system" model="res.groups"><field name="implied_ids" eval="[(4, ref('group_cashier'))]"/></record>
    <record id="rule_ddcc_cash_request_user_own" model="ir.rule"><field name="name">Solicitudes de efectivo propias</field><field name="model_id" ref="model_doorandoor_cash_collection_request"/><field name="domain_force">[('salesperson_id', '=', user.id)]</field><field name="groups" eval="[(4, ref('base.group_user'))]"/></record>
    <record id="rule_ddcc_cash_request_cashier_all" model="ir.rule"><field name="name">Cajero ve solicitudes de sus cajas</field><field name="model_id" ref="model_doorandoor_cash_collection_request"/><field name="domain_force">['|', ('register_id.cashier_ids', 'in', [user.id]), ('register_id.manager_ids', 'in', [user.id])]</field><field name="groups" eval="[(4, ref('group_cashier'))]"/></record>
    <record id="rule_ddcc_cash_request_admin_all" model="ir.rule"><field name="name">Administración ve todas las solicitudes de caja</field><field name="model_id" ref="model_doorandoor_cash_collection_request"/><field name="domain_force">[(1, '=', 1)]</field><field name="groups" eval="[(4, ref('base.group_system'))]"/></record>
    <record id="rule_ddcc_register_cashier_office" model="ir.rule"><field name="name">Operador ve solamente sus cajas</field><field name="model_id" ref="model_doorandoor_cash_register"/><field name="domain_force">['|', ('cashier_ids', 'in', [user.id]), ('manager_ids', 'in', [user.id])]</field><field name="groups" eval="[(4, ref('group_cashier'))]"/></record>
    <record id="rule_ddcc_register_admin_all" model="ir.rule"><field name="name">Administración ve todas las cajas</field><field name="model_id" ref="model_doorandoor_cash_register"/><field name="domain_force">[(1, '=', 1)]</field><field name="groups" eval="[(4, ref('base.group_system'))]"/></record>
    <record id="rule_ddcc_session_cashier_office" model="ir.rule"><field name="name">Operador ve sesiones de sus cajas</field><field name="model_id" ref="model_doorandoor_cash_session"/><field name="domain_force">['|', ('register_id.cashier_ids', 'in', [user.id]), ('register_id.manager_ids', 'in', [user.id])]</field><field name="groups" eval="[(4, ref('group_cashier'))]"/></record>
    <record id="rule_ddcc_session_admin_all" model="ir.rule"><field name="name">Administración ve todas las sesiones de caja</field><field name="model_id" ref="model_doorandoor_cash_session"/><field name="domain_force">[(1, '=', 1)]</field><field name="groups" eval="[(4, ref('base.group_system'))]"/></record>
    <record id="rule_ddcc_session_line_cashier_office" model="ir.rule"><field name="name">Operador ve conteos de sus cajas</field><field name="model_id" ref="model_doorandoor_cash_session_line"/><field name="domain_force">['|', ('session_id.register_id.cashier_ids', 'in', [user.id]), ('session_id.register_id.manager_ids', 'in', [user.id])]</field><field name="groups" eval="[(4, ref('group_cashier'))]"/></record>
    <record id="rule_ddcc_session_line_admin_all" model="ir.rule"><field name="name">Administración ve todos los conteos de caja</field><field name="model_id" ref="model_doorandoor_cash_session_line"/><field name="domain_force">[(1, '=', 1)]</field><field name="groups" eval="[(4, ref('base.group_system'))]"/></record>
    <record id="rule_ddcc_movement_cashier_office" model="ir.rule"><field name="name">Operador ve movimientos de sus cajas</field><field name="model_id" ref="model_doorandoor_cash_movement"/><field name="domain_force">['|', ('session_id.register_id.cashier_ids', 'in', [user.id]), ('session_id.register_id.manager_ids', 'in', [user.id])]</field><field name="groups" eval="[(4, ref('group_cashier'))]"/></record>
    <record id="rule_ddcc_movement_admin_all" model="ir.rule"><field name="name">Administración ve todos los movimientos de caja</field><field name="model_id" ref="model_doorandoor_cash_movement"/><field name="domain_force">[(1, '=', 1)]</field><field name="groups" eval="[(4, ref('base.group_system'))]"/></record>
    <record id="rule_ddcc_movement_line_cashier_office" model="ir.rule"><field name="name">Operador ve detalle de movimientos de sus cajas</field><field name="model_id" ref="model_doorandoor_cash_movement_line"/><field name="domain_force">['|', ('movement_id.session_id.register_id.cashier_ids', 'in', [user.id]), ('movement_id.session_id.register_id.manager_ids', 'in', [user.id])]</field><field name="groups" eval="[(4, ref('group_cashier'))]"/></record>
    <record id="rule_ddcc_movement_line_admin_all" model="ir.rule"><field name="name">Administración ve todo el detalle de caja</field><field name="model_id" ref="model_doorandoor_cash_movement_line"/><field name="domain_force">[(1, '=', 1)]</field><field name="groups" eval="[(4, ref('base.group_system'))]"/></record>
</odoo>
