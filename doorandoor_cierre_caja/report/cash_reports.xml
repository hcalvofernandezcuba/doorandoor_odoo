<odoo>
 <record id="action_report_cash_daily" model="ir.actions.report"><field name="name">Reporte diario de caja</field><field name="model">doorandoor.cash.session</field><field name="report_type">qweb-pdf</field><field name="report_name">doorandoor_cierre_caja.report_cash_daily</field><field name="report_file">doorandoor_cierre_caja.report_cash_daily</field><field name="binding_model_id" ref="model_doorandoor_cash_session"/><field name="binding_type">report</field></record>
 <record id="action_report_cash_deposit" model="ir.actions.report"><field name="name">Planilla de depósito de efectivo</field><field name="model">doorandoor.cash.session</field><field name="report_type">qweb-pdf</field><field name="report_name">doorandoor_cierre_caja.report_cash_deposit</field><field name="report_file">doorandoor_cierre_caja.report_cash_deposit</field><field name="binding_model_id" ref="model_doorandoor_cash_session"/><field name="binding_type">report</field></record>
 <record id="action_report_cash_audit_worksheet" model="ir.actions.report"><field name="name">Hoja de arqueo de caja</field><field name="model">doorandoor.cash.audit</field><field name="report_type">qweb-pdf</field><field name="report_name">doorandoor_cierre_caja.report_cash_audit_worksheet</field><field name="report_file">doorandoor_cierre_caja.report_cash_audit_worksheet</field><field name="binding_model_id" ref="model_doorandoor_cash_audit"/><field name="binding_type">report</field></record>
 <template id="report_cash_daily"><t t-call="web.html_container"><t t-foreach="docs" t-as="o"><t t-call="web.external_layout"><div class="page"><h2>Reporte diario de caja — <span t-field="o.name"/></h2><p><strong>Caja:</strong> <span t-field="o.register_id"/> · <strong>Fecha:</strong> <span t-field="o.date"/> · <strong>Responsable:</strong> <span t-field="o.cashier_id"/></p><table class="table table-sm"><tr><td>Fondo de cambio</td><td class="text-end"><span t-field="o.opening_amount"/></td></tr><tr><td>Ventas cobradas en efectivo</td><td class="text-end"><span t-field="o.cash_sales_amount"/></td></tr><tr><td>Salidas de efectivo</td><td class="text-end"><span t-field="o.cash_out_amount"/></td></tr><tr class="fw-bold"><td>Efectivo esperado</td><td class="text-end"><span t-field="o.expected_amount"/></td></tr><tr class="fw-bold"><td>Efectivo contado</td><td class="text-end"><span t-field="o.counted_amount"/></td></tr><tr><td>Diferencia</td><td class="text-end"><span t-field="o.difference_amount"/></td></tr></table><t t-set="payment_summary" t-value="o._ddcc_payment_method_summary()"/><h4>Resumen de cobros por método</h4><table class="table table-sm"><thead><tr><th>Método</th><th class="text-end">Pagos</th><th class="text-end">Importe</th></tr></thead><tbody><tr t-foreach="payment_summary" t-as="row"><td><span t-esc="row['label']"/></td><td class="text-end"><span t-esc="row['count']"/></td><td class="text-end"><span t-esc="o.currency_id.format(row['amount'])"/></td></tr><tr t-if="not payment_summary"><td colspan="3">No hay cobros conciliados para esta oficina y fecha.</td></tr></tbody><tfoot><tr class="fw-bold"><td>Total cobrado</td><td class="text-end"><span t-esc="sum(row['count'] for row in payment_summary)"/></td><td class="text-end"><span t-esc="o.currency_id.format(sum(row['amount'] for row in payment_summary))"/></td></tr></tfoot></table><p class="small">Este resumen se limita a pagos conciliados con facturas de la oficina de esta caja. No modifica el arqueo de efectivo.</p><h4>Arqueo por denominación</h4><table class="table table-sm"><thead><tr><th>Denominación</th><th class="text-end">Cantidad</th><th class="text-end">Importe</th></tr></thead><tbody><tr t-foreach="o.closing_line_ids" t-as="l"><td><span t-field="l.denomination_id"/></td><td class="text-end"><span t-field="l.quantity"/></td><td class="text-end"><span t-field="l.subtotal"/></td></tr></tbody></table><p t-if="o.note"><strong>Observaciones:</strong> <span t-field="o.note"/></p></div></t></t></t></template>
 <template id="report_cash_deposit"><t t-call="web.html_container"><t t-foreach="docs" t-as="o"><t t-call="web.external_layout"><div class="page"><h2>Planilla de depósito de efectivo</h2><p><strong>Caja:</strong> <span t-field="o.register_id"/> · <strong>Fecha:</strong> <span t-field="o.date"/></p><p><strong>Banco destino:</strong> <span t-field="o.register_id.deposit_journal_id"/> · <strong>Referencia:</strong> <span t-field="o.deposit_reference"/></p><table class="table table-sm"><thead><tr><th>Denominación</th><th class="text-end">Cantidad de billetes</th><th class="text-end">Subtotal</th></tr></thead><tbody><tr t-foreach="o.closing_line_ids" t-as="l"><td><span t-field="l.denomination_id"/></td><td class="text-end"><span t-field="l.quantity"/></td><td class="text-end"><span t-field="l.subtotal"/></td></tr></tbody><tfoot><tr class="fw-bold"><td colspan="2">Total a depositar</td><td class="text-end"><span t-field="o.counted_amount"/></td></tr></tfoot></table><br/><div class="row"><div class="col-6">Entregado por: ____________________</div><div class="col-6">Recibido por: ____________________</div></div></div></t></t></t></template>
 <template id="report_cash_audit_worksheet"><t t-call="web.html_container"><t t-foreach="docs" t-as="o"><t t-call="web.external_layout"><div class="page"><h2>Hoja inicial de arqueo de caja</h2><p><strong>Arqueo:</strong> <span t-field="o.name"/> · <strong>Caja:</strong> <span t-field="o.register_id"/> · <strong>Sesión:</strong> <span t-field="o.session_id"/></p><p><strong>Emitido:</strong> <span t-field="o.audit_at"/> · <strong>Supervisor/a:</strong> <span t-field="o.auditor_id"/></p><div class="alert alert-warning"><strong>Efectivo esperado al iniciar el arqueo:</strong> <span t-field="o.expected_amount"/>. Este documento es una fotografía del momento de emisión; el conteo se realiza físicamente antes de registrar datos en Odoo.</div><h4>Operaciones de efectivo incluidas</h4><table class="table table-sm"><thead><tr><th>Fecha</th><th>Factura</th><th>Cajero</th><th class="text-end">Cobro</th><th class="text-end">Recibido</th><th class="text-end">Vuelto</th><th>Billetes recibidos / vuelto</th></tr></thead><tbody><tr t-foreach="o.movement_snapshot_ids" t-as="m"><td><span t-field="m.payment_date"/></td><td><span t-field="m.move_id"/></td><td><span t-field="m.cashier_id"/></td><td class="text-end"><span t-field="m.payment_amount"/></td><td class="text-end"><span t-field="m.tender_amount"/></td><td class="text-end"><span t-field="m.change_amount"/></td><td><span t-foreach="m.line_ids" t-as="l"><span t-field="l.denomination_id"/>: <span t-esc="l.received_quantity"/> / <span t-esc="l.change_quantity"/><br/></span></td></tr></tbody></table><h4>Control manual de conteo físico</h4><p>Escriba las cantidades encontradas en caja. No use las cantidades esperadas de Odoo durante el conteo.</p><table class="table table-sm"><thead><tr><th>Denominación</th><th class="text-center">Cantidad física</th><th class="text-end">Subtotal físico</th></tr></thead><tbody><tr t-foreach="o.line_ids" t-as="l"><td><span t-field="l.denomination_id"/></td><td style="height:30px"/><td/></tr></tbody><tfoot><tr class="fw-bold"><td>Total contado físicamente</td><td></td><td>________________</td></tr></tfoot></table><br/><div class="row"><div class="col-6">Contado por: __________________________</div><div class="col-6">Supervisor/a: __________________________</div></div><p class="mt-4">Observaciones: ____________________________________________________________________________________</p></div></t></t></t></template>
</odoo>
