<odoo>
 <record id="view_ddcc_cash_session_list" model="ir.ui.view"><field name="name">doorandoor.cash.session.list</field><field name="model">doorandoor.cash.session</field><field name="arch" type="xml"><list decoration-success="state == 'closed'" decoration-info="state == 'open'"><field name="name"/><field name="date"/><field name="register_id"/><field name="cashier_id"/><field name="expected_amount"/><field name="counted_amount"/><field name="difference_amount"/><field name="state"/></list></field></record>
 <record id="view_ddcc_cash_session_form" model="ir.ui.view"><field name="name">doorandoor.cash.session.form</field><field name="model">doorandoor.cash.session</field><field name="arch" type="xml"><form><header><button name="action_open" type="object" string="Abrir caja" class="btn-primary" invisible="state != 'draft'"/><button name="%(action_ddcc_cash_close_wizard)d" type="action" string="Contar y cerrar" class="btn-primary" invisible="state != 'open'"/><button name="action_print_daily_report" type="object" string="Reporte diario" invisible="state != 'closed'"/><button name="action_print_deposit_slip" type="object" string="Planilla de depósito" invisible="state != 'closed'"/><field name="state" widget="statusbar" statusbar_visible="draft,open,closed"/></header><sheet><div class="oe_title"><h1><field name="name" readonly="1"/></h1></div><group><group><field name="register_id" string="Oficina / Caja" widget="selection" domain="[('active', '=', True), ('office_id', '!=', False)]" readonly="state != 'draft'" options="{'no_create': True, 'no_open': True}"/><field name="date" readonly="state != 'draft'"/><field name="cashier_id"/><field name="journal_id" readonly="1"/><field name="denomination_control_active" readonly="1"/></group><group><field name="opening_amount" readonly="1"/><field name="cash_sales_amount" readonly="1"/><field name="cash_out_amount" readonly="1"/><field name="expected_amount" readonly="1"/><field name="counted_amount" readonly="1"/><field name="difference_amount" readonly="1"/></group></group><notebook><page string="Fondo de cambio"><field name="opening_line_ids" readonly="state != 'draft'"><list editable="bottom"><field name="denomination_id"/><field name="quantity"/><field name="subtotal" readonly="1"/></list></field></page><page string="Movimientos de efectivo"><field name="movement_ids" readonly="1"><list><field name="name"/><field name="payment_id"/><field name="move_id"/><field name="user_id"/><field name="tender_amount"/><field name="payment_amount"/><field name="change_amount"/></list></field></page><page string="Arqueo de cierre"><field name="closing_line_ids" readonly="1"><list><field name="denomination_id"/><field name="quantity"/><field name="subtotal"/></list></field></page><page string="Depósito y notas"><group><field name="deposit_reference" readonly="state != 'open'"/><field name="note" readonly="state != 'open'"/></group></page></notebook></sheet><chatter/></form></field></record>
 <record id="action_ddcc_cash_session" model="ir.actions.act_window"><field name="name">Cierres diarios</field><field name="res_model">doorandoor.cash.session</field><field name="view_mode">list,form</field></record>
 <record id="action_ddcc_cash_open_wizard" model="ir.actions.act_window"><field name="name">Abrir caja</field><field name="res_model">doorandoor.cash.open.wizard</field><field name="view_mode">form</field><field name="target">new</field></record>
 <menuitem id="menu_ddcc_root" name="Control de caja" parent="account.menu_finance" sequence="90" groups="doorandoor_cierre_caja.group_cashier,base.group_system"/>
 <menuitem id="menu_ddcc_open" name="Abrir caja" parent="menu_ddcc_root" action="action_ddcc_cash_open_wizard" sequence="10" groups="doorandoor_cierre_caja.group_cashier,base.group_system"/>
 <menuitem id="menu_ddcc_sessions" name="Cierres diarios" parent="menu_ddcc_root" action="action_ddcc_cash_session" sequence="20" groups="doorandoor_cierre_caja.group_cashier,base.group_system"/>
 <menuitem id="menu_ddcc_registers" name="Configuración de cajas" parent="menu_ddcc_root" action="action_ddcc_cash_register" sequence="90" groups="doorandoor_cierre_caja.group_cash_manager,base.group_system"/>
</odoo>
