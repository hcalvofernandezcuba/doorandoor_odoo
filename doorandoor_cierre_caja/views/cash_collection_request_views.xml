<odoo>
 <record id="view_ddcc_cash_request_list" model="ir.ui.view"><field name="name">doorandoor.cash.collection.request.list</field><field name="model">doorandoor.cash.collection.request</field><field name="arch" type="xml"><list decoration-warning="state == 'waiting_archeo'" decoration-success="state == 'paid'"><field name="name"/><field name="invoice_id"/><field name="city_rule_id"/><field name="salesperson_id"/><field name="register_id"/><field name="amount"/><field name="state"/></list></field></record>
 <record id="view_ddcc_cash_request_form" model="ir.ui.view"><field name="name">doorandoor.cash.collection.request.form</field><field name="model">doorandoor.cash.collection.request</field><field name="arch" type="xml"><form string="Cobro pendiente de caja"><header><button name="action_open_cash_payment" type="object" string="Cobrar efectivo" class="btn-primary" invisible="state != 'pending'"/><button name="action_open_invoice" type="object" string="Abrir factura"/><button name="action_cancel" type="object" string="Cancelar solicitud" invisible="state not in ('pending','waiting_archeo')"/><field name="state" widget="statusbar" statusbar_visible="pending,waiting_archeo,paid,cancelled"/></header><sheet><div class="oe_title"><h1><field name="name"/></h1></div><div class="alert alert-warning" invisible="state != 'waiting_archeo'">La caja está en arqueo presencial. El cobro se activará al liberar la caja.</div><group><group><field name="invoice_id"/><field name="salesperson_id"/><field name="city_rule_id"/></group><group><field name="register_id"/><field name="amount"/><field name="cashier_id"/><field name="payment_id"/></group></group></sheet><chatter/></form></field></record>
 <record id="action_ddcc_cash_request" model="ir.actions.act_window"><field name="name">Cobros pendientes de caja</field><field name="res_model">doorandoor.cash.collection.request</field><field name="view_mode">list,form</field><field name="domain">[('state','in',['pending','waiting_archeo'])]</field></record>
 <menuitem id="menu_ddcc_cash_requests" name="Cobros pendientes" parent="menu_ddcc_root" action="action_ddcc_cash_request" sequence="18" groups="doorandoor_cierre_caja.group_cashier,base.group_system"/>
 <record id="view_move_form_ddcc_cash_request" model="ir.ui.view"><field name="name">account.move.form.ddcc.cash.request</field><field name="model">account.move</field><field name="inherit_id" ref="account.view_move_form"/><field name="arch" type="xml"><xpath expr="//button[@name='action_register_payment']" position="replace"><button name="action_ddcc_pay_selected_method" type="object" string="Pagar" class="btn-primary" invisible="move_type != 'out_invoice' or state != 'posted' or amount_residual &lt;= 0"/><button name="action_ddcc_request_cash_collection" type="object" string="Enviar a caja" invisible="move_type != 'out_invoice' or state != 'posted' or amount_residual &lt;= 0"/></xpath></field></record>
</odoo>
