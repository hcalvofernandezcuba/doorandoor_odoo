<odoo>
 <record id="view_ddcc_cash_register_list" model="ir.ui.view"><field name="name">doorandoor.cash.register.list</field><field name="model">doorandoor.cash.register</field><field name="arch" type="xml"><list><field name="name"/><field name="office_id"/><field name="city_rule_id"/><field name="cash_journal_id"/><field name="deposit_journal_id"/><field name="cashier_ids" widget="many2many_tags"/><field name="manager_ids" widget="many2many_tags"/><field name="active"/></list></field></record>
 <record id="view_ddcc_cash_register_form" model="ir.ui.view"><field name="name">doorandoor.cash.register.form</field><field name="model">doorandoor.cash.register</field><field name="arch" type="xml"><form><sheet><group><field name="name"/><field name="company_id"/><field name="office_id" options="{'no_create': True, 'no_open': True}"/><field name="city_rule_id"/><field name="cash_journal_id"/><field name="deposit_journal_id"/><field name="cashier_ids" widget="many2many_tags"/><field name="manager_ids" widget="many2many_tags"/><field name="active"/></group></sheet></form></field></record>
 <record id="action_ddcc_cash_register" model="ir.actions.act_window"><field name="name">Cajas de ventas</field><field name="res_model">doorandoor.cash.register</field><field name="view_mode">list,form</field></record>
 <record id="view_ddcc_commercial_office_cash_registers" model="ir.ui.view">
  <field name="name">doorandoor.commercial.office.cash.registers</field>
  <field name="model">doorandoor.commercial.office</field>
  <field name="inherit_id" ref="doorandoor_commercial_office_tax.view_ddco_commercial_office_form"/>
  <field name="arch" type="xml">
   <xpath expr="//notebook" position="inside">
    <page string="Caja comercial">
     <field name="cash_register_ids" readonly="1">
      <list><field name="name"/><field name="cashier_ids" widget="many2many_tags"/><field name="manager_ids" widget="many2many_tags"/><field name="active"/></list>
     </field>
    </page>
   </xpath>
  </field>
 </record>
</odoo>
