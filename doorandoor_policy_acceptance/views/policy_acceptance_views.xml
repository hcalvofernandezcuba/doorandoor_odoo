<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="policy_acceptance_list" model="ir.ui.view">
        <field name="name">doorandoor.policy.acceptance.list</field>
        <field name="model">doorandoor.policy.acceptance</field>
        <field name="arch" type="xml">
            <list create="0" delete="0">
                <field name="partner_id"/>
                <field name="policy_version"/>
                <field name="state" widget="badge"/>
                <field name="signer_name"/>
                <field name="accepted_at"/>
                <field name="valid_until"/>
                <field name="source"/>
                <field name="email_sent_at" optional="show"/>
                <field name="telegram_sent_at" optional="hide"/>
                <field name="sale_order_id" optional="show"/>
                <field name="account_move_id" optional="show"/>
            </list>
        </field>
    </record>
    <record id="policy_acceptance_search" model="ir.ui.view">
        <field name="name">doorandoor.policy.acceptance.search</field>
        <field name="model">doorandoor.policy.acceptance</field>
        <field name="arch" type="xml">
            <search string="Clientes con políticas firmadas">
                <field name="partner_id"/>
                <field name="signer_name"/>
                <field name="policy_version"/>
                <filter name="valid" string="Vigentes" domain="[('state','=','accepted'),('valid_until','&gt;=',context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="expired" string="Vencidas" domain="[('state','=','expired')]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_partner" string="Cliente" context="{'group_by':'partner_id'}"/>
                    <filter name="group_language" string="Idioma" context="{'group_by':'accepted_language'}"/>
                    <filter name="group_source" string="Origen" context="{'group_by':'source'}"/>
                    <filter name="group_month" string="Mes de aceptación" context="{'group_by':'accepted_at:month'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="policy_acceptance_form" model="ir.ui.view">
        <field name="name">doorandoor.policy.acceptance.form</field>
        <field name="model">doorandoor.policy.acceptance</field>
        <field name="arch" type="xml">
            <form create="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id" readonly="1"/>
                            <field name="policy_id" readonly="1"/>
                            <field name="policy_version" readonly="1"/>
                            <field name="policy_sha256" readonly="1"/>
                        </group>
                        <group>
                            <field name="state" readonly="1"/>
                            <field name="source" readonly="1"/>
                            <field name="signer_name" readonly="1"/>
                            <field name="accepted_at" readonly="1"/>
                            <field name="accepted_language" readonly="1"/>
                            <field name="accepted_document_sha256" readonly="1"/>
                            <field name="valid_until" readonly="1"/>
                            <field name="email_sent_at" readonly="1"/>
                            <field name="telegram_sent_at" readonly="1"/>
                        </group>
                    </group>
                    <group string="Evidencia técnica">
                        <field name="ip_address" readonly="1"/>
                        <field name="user_agent" readonly="1"/>
                        <field name="sale_order_id" readonly="1"/>
                        <field name="account_move_id" readonly="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="policy_acceptance_action" model="ir.actions.act_window">
        <field name="name">Clientes con políticas firmadas</field>
        <field name="res_model">doorandoor.policy.acceptance</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="policy_acceptance_search"/>
        <field name="domain">[('state','=','accepted')]</field>
        <field name="context">{'search_default_valid': 1}</field>
    </record>

    <menuitem id="menu_policy_acceptance_sales"
              name="Clientes con políticas firmadas"
              parent="sale.sale_menu_root"
              action="policy_acceptance_action"
              sequence="75"
              groups="sales_team.group_sale_salesman"/>
</odoo>
