<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_partner_form_policy_acceptance" model="ir.ui.view">
        <field name="name">res.partner.form.policy.acceptance</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_ddpa_view_acceptances" type="object" class="oe_stat_button" icon="fa-check-square-o">
                    <field name="ddpa_policy_acceptance_count" widget="statinfo" string="Políticas"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='category_id']" position="after">
                <field name="ddpa_policy_status" readonly="1"/>
                <field name="ddpa_policy_valid_until" readonly="1" invisible="not ddpa_policy_valid_until"/>
            </xpath>
        </field>
    </record>
</odoo>
