<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mail_template_policy_acceptance" model="mail.template">
        <field name="name">DoorAndDoor: aceptar políticas comerciales</field>
        <field name="model_id" ref="model_doorandoor_policy_acceptance"/>
        <field name="subject">Acción requerida: aceptación de políticas Door &amp; Door</field>
        <field name="email_from">{{ user.email_formatted or company.email_formatted }}</field>
        <field name="email_to">{{ object.partner_id.email }}</field>
        <field name="lang">{{ object.partner_id.lang }}</field>
        <field name="body_html" type="html">
            <div style="font-family: Arial, sans-serif; color: #0b2942;">
                <p>Hola <t t-out="object.partner_id.name"/>,</p>
                <p>Antes de continuar con su proceso comercial, necesitamos que revise y acepte las políticas de venta vigentes de Door &amp; Door.</p>
                <p style="margin: 24px 0;">
                    <a t-att-href="object._get_public_url()" style="background:#0b2942;color:#fff;padding:12px 20px;text-decoration:none;border-radius:4px;">Revisar y aceptar políticas</a>
                </p>
                <p>Versión: <strong><t t-out="object.policy_version"/></strong></p>
                <p>Este enlace es personal. No lo reenvíe.</p>
                <p>Door &amp; Door<br/>+1 813 809 3988</p>
            </div>
        </field>
        <field name="auto_delete" eval="False"/>
    </record>
</odoo>
