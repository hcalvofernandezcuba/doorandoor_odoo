<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_ddii_inventory_import_wizard_form" model="ir.ui.view">
        <field name="name">ddii.inventory.import.wizard.form</field>
        <field name="model">ddii.inventory.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Start Initial Inventory Import">
                <group>
                    <field name="source_format"/>
                    <field name="location_id"/>
                    <field name="inventory_date"/>
                    <field name="source_file" filename="source_filename"/>
                    <field name="source_filename" invisible="1"/>
                </group>
                <footer>
                    <button name="action_create_and_analyze" string="Analyze PDF" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_ddii_inventory_import_wizard" model="ir.actions.act_window">
        <field name="name">Import initial inventory</field>
        <field name="res_model">ddii.inventory.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
