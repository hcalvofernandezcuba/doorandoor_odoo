<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="doorandoor_process_control.RealtimePickingTemplate">
        <div class="o_ddpc_realtime_widget">
            <div class="card mb-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <strong><t t-esc="widget.picking_id ? 'Estado en Tiempo Real' : 'Widget de Traslados'"/></strong>
                    <button class="btn btn-sm btn-outline-secondary o_ddpc_refresh_manual" type="button">
                        <i class="fa fa-refresh"/> Actualizar
                    </button>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <small class="text-muted">Estado actual:</small>
                            <div class="o_ddpc_realtime_status font-weight-bold">Cargando...</div>
                        </div>
                        <div class="col-md-6">
                            <small class="text-muted">Etapa:</small>
                            <div>
                                <span class="badge o_ddpc_stage_badge">-</span>
                            </div>
                        </div>
                    </div>
                    <div class="row mt-2">
                        <div class="col-12">
                            <small class="text-muted">Última actualización:</small>
                            <div class="o_ddpc_last_update text-muted">-</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="alert alert-info o_ddpc_connection_status" style="display: none;">
                <i class="fa fa-info-circle"/> Conexión en tiempo real activa
            </div>
        </div>
    </template>
</odoo>