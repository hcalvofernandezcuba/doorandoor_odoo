<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="mail_activity_type_transfer_receipt" model="mail.activity.type">
            <field name="name">Recepción de traslado pendiente</field>
            <field name="summary">Recibir mercancía trasladada</field>
            <field name="res_model">stock.picking</field>
            <field name="icon">fa-exchange</field>
            <field name="decoration_type">warning</field>
        </record>

        <record id="ir_cron_transfer_receipt_alerts" model="ir.cron">
            <field name="name">DoorAndDoor: recordatorios de traslados pendientes</field>
            <field name="model_id" ref="stock.model_stock_picking"/>
            <field name="state">code</field>
            <field name="code">model._cron_ddpc_transfer_receipt_alerts()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>
