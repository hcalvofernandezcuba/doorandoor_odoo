<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="group_ddpc_user" model="res.groups">
            <field name="name">DoorAndDoor Process User</field>
            <field name="category_id" ref="base.module_category_hidden"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_ddpc_manager" model="res.groups">
            <field name="name">DoorAndDoor Process Manager</field>
            <field name="category_id" ref="base.module_category_hidden"/>
            <field name="implied_ids" eval="[(4, ref('doorandoor_process_control.group_ddpc_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_admin'))]"/>
        </record>

        <record id="group_ddpc_warehouse_operator" model="res.groups">
            <field name="name">DoorAndDoor Almacenero</field>
            <field name="category_id" ref="base.module_category_hidden"/>
            <field name="implied_ids" eval="[(4, ref('doorandoor_process_control.group_ddpc_user'))]"/>
        </record>

        <record id="sales_team.group_sale_salesman" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('doorandoor_process_control.group_ddpc_user'))]"/>
        </record>

        <record id="account.group_account_invoice" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('doorandoor_process_control.group_ddpc_user'))]"/>
        </record>

        <record id="mrp.group_mrp_user" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('doorandoor_process_control.group_ddpc_user'))]"/>
        </record>

        <record id="stock.group_stock_user" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('doorandoor_process_control.group_ddpc_user')), (4, ref('doorandoor_process_control.group_ddpc_warehouse_operator'))]"/>
        </record>

        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('doorandoor_process_control.group_ddpc_manager'))]"/>
        </record>

        <record id="rule_ddpc_warehouse_prereservation_company" model="ir.rule">
            <field name="name">Prereservas visibles por compania</field>
            <field name="model_id" ref="model_doorandoor_warehouse_prereservation"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(5, 0, 0)]"/>
        </record>

        <record id="rule_ddpc_pending_delivery_company" model="ir.rule">
            <field name="name">Entregas pendientes visibles por compania</field>
            <field name="model_id" ref="model_doorandoor_pending_delivery"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(5, 0, 0)]"/>
        </record>

        <record id="rule_ddpc_sales_reservation_company" model="ir.rule">
            <field name="name">Reservas de ventas visibles por compania</field>
            <field name="model_id" ref="model_doorandoor_sales_reservation_analysis"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(5, 0, 0)]"/>
        </record>

        <record id="rule_ddpc_sales_reservation_operator" model="ir.rule">
            <field name="name">Reservas limitadas a almacenes asignados</field>
            <field name="model_id" ref="model_doorandoor_sales_reservation_analysis"/>
            <field name="domain_force">([('warehouse_id', 'in', user.ddpc_warehouse_ids.ids)] if user.ddpc_warehouse_ids else [('company_id', 'in', company_ids)])</field>
            <field name="groups" eval="[(4, ref('doorandoor_process_control.group_ddpc_warehouse_operator'))]"/>
        </record>

        <record id="rule_ddpc_sales_reservation_manager" model="ir.rule">
            <field name="name">Gerencia ve todas las reservas de ventas</field>
            <field name="model_id" ref="model_doorandoor_sales_reservation_analysis"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('sales_team.group_sale_manager')), (4, ref('doorandoor_process_control.group_ddpc_manager')), (4, ref('base.group_system'))]"/>
        </record>

        <record id="rule_ddpc_warehouse_prereservation_operator" model="ir.rule">
            <field name="name">Prereservas limitadas a almacenes asignados</field>
            <field name="model_id" ref="model_doorandoor_warehouse_prereservation"/>
            <field name="domain_force">([('warehouse_id', 'in', user.ddpc_warehouse_ids.ids)] if user.ddpc_warehouse_ids else [('company_id', 'in', company_ids)])</field>
            <field name="groups" eval="[(4, ref('doorandoor_process_control.group_ddpc_warehouse_operator'))]"/>
        </record>

        <record id="rule_ddpc_warehouse_prereservation_manager" model="ir.rule">
            <field name="name">Gerencia ve todas las prereservas</field>
            <field name="model_id" ref="model_doorandoor_warehouse_prereservation"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('doorandoor_process_control.group_ddpc_manager')), (4, ref('base.group_system'))]"/>
        </record>

        <record id="rule_ddpc_pending_delivery_operator" model="ir.rule">
            <field name="name">Entregas limitadas a almacenes asignados</field>
            <field name="model_id" ref="model_doorandoor_pending_delivery"/>
            <field name="domain_force">([('warehouse_id', 'in', user.ddpc_warehouse_ids.ids)] if user.ddpc_warehouse_ids else [('company_id', 'in', company_ids)])</field>
            <field name="groups" eval="[(4, ref('doorandoor_process_control.group_ddpc_warehouse_operator'))]"/>
        </record>

        <record id="rule_ddpc_pending_delivery_manager" model="ir.rule">
            <field name="name">Gerencia ve todas las entregas pendientes</field>
            <field name="model_id" ref="model_doorandoor_pending_delivery"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('doorandoor_process_control.group_ddpc_manager')), (4, ref('base.group_system'))]"/>
        </record>

        <record id="rule_ddpc_stock_picking_operator_warehouses" model="ir.rule">
            <field name="name">Operaciones limitadas a almacenes asignados</field>
            <field name="model_id" ref="stock.model_stock_picking"/>
            <field name="domain_force">(['|', ('ddpc_source_warehouse_id', 'in', user.ddpc_warehouse_ids.ids), ('ddpc_dest_warehouse_id', 'in', user.ddpc_warehouse_ids.ids)] if user.ddpc_warehouse_ids else [('company_id', 'in', company_ids)])</field>
            <field name="groups" eval="[(4, ref('doorandoor_process_control.group_ddpc_warehouse_operator'))]"/>
        </record>

        <record id="rule_ddpc_stock_picking_manager_all" model="ir.rule">
            <field name="name">Gerencia ve todas las operaciones de almacén</field>
            <field name="model_id" ref="stock.model_stock_picking"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('doorandoor_process_control.group_ddpc_manager')), (4, ref('base.group_system'))]"/>
        </record>

        <record id="seq_doorandoor_process_flow" model="ir.sequence">
            <field name="name">DoorAndDoor Process Flow</field>
            <field name="code">doorandoor.process.flow</field>
            <field name="prefix">PC/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
