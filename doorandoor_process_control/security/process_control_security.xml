<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="group_ddpc_user" model="res.groups">
            <field name="name">DoorAndDoor Process User</field>
            <field name="category_id" ref="base.module_category_hidden"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_ddpc_manager" model="res.groups">
            <field name="name">DoorAndDoor Process Manager</field>
            <field name="category_id" ref="base.module_category_hidden"/>
            <field name="implied_ids" eval="[(4, ref('doorandoor_process_control.group_ddpc_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_admin'))]"/>
        </record>

        <record id="sales_team.group_sale_salesman" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('doorandoor_process_control.group_ddpc_user'))]"/>
        </record>

        <record id="account.group_account_invoice" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('doorandoor_process_control.group_ddpc_user'))]"/>
        </record>

        <record id="mrp.group_mrp_user" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('doorandoor_process_control.group_ddpc_user'))]"/>
        </record>

        <record id="stock.group_stock_user" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('doorandoor_process_control.group_ddpc_user'))]"/>
        </record>

        <record id="seq_doorandoor_process_flow" model="ir.sequence">
            <field name="name">DoorAndDoor Process Flow</field>
            <field name="code">doorandoor.process.flow</field>
            <field name="prefix">PC/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
