<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_ddpc_process_backfill_wizard_form" model="ir.ui.view">
            <field name="name">doorandoor.process.backfill.wizard.form</field>
            <field name="model">doorandoor.process.backfill.wizard</field>
            <field name="arch" type="xml">
                <form string="Cargar historicos en Operaciones">
                    <group>
                        <group>
                            <field name="include_sales"/>
                            <field name="include_invoices"/>
                            <field name="include_manufacturing"/>
                            <field name="include_pickings"/>
                        </group>
                        <group>
                            <field name="create_review_task"/>
                            <field name="per_model_limit"/>
                            <field name="created_flow_count" readonly="1"/>
                            <field name="created_task_count" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="result_message" readonly="1" nolabel="1"/>
                    </group>
                    <footer>
                        <button name="action_backfill" type="object" string="Cargar historicos" class="btn-primary"/>
                        <button string="Cerrar" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_ddpc_process_backfill_wizard" model="ir.actions.act_window">
            <field name="name">Cargar historicos</field>
            <field name="res_model">doorandoor.process.backfill.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
    </data>
</odoo>
