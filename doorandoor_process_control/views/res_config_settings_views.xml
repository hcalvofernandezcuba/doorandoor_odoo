<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_res_config_settings_inherit_ddpc" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.ddpc</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//form" position="inside">
                    <app string="Process Control" name="doorandoor_process_control" groups="doorandoor_process_control.group_ddpc_manager">
                        <block title="Process Colors">
                            <setting string="Overdue Color">
                                <field name="ddpc_color_overdue"/>
                            </setting>
                            <setting string="In Progress Color">
                                <field name="ddpc_color_in_progress"/>
                            </setting>
                            <setting string="Done Color">
                                <field name="ddpc_color_done"/>
                            </setting>
                        </block>
                        <block title="Alertas de traslados">
                            <setting string="Frecuencia de recordatorios"
                                     help="Horas entre avisos mientras el almacén destino no confirme la recepción.">
                                <field name="ddpc_transfer_alert_interval_hours"/>
                            </setting>
                            <setting string="Escalamiento por demora"
                                     help="Horas posteriores a la fecha programada para mostrar la alerta como vencida.">
                                <field name="ddpc_transfer_overdue_hours"/>
                            </setting>
                            <setting string="Mercancía en tránsito"
                                     help="Ubicación temporal entre el despacho del origen y la recepción física del destino. Si queda vacía, DoorAndDoor la crea automáticamente.">
                                <field name="ddpc_transfer_transit_location_id"
                                       options="{'no_create': True, 'no_create_edit': True}"/>
                            </setting>
                        </block>
                    </app>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
