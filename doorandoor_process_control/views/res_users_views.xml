<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_inherit_ddpc_warehouses" model="ir.ui.view">
        <field name="name">res.users.form.ddpc.warehouses</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Operaciones de almacén" groups="base.group_system">
                    <group>
                        <field name="ddpc_warehouse_ids" widget="many2many_tags"/>
                        <field name="ddpc_default_warehouse_id"/>
                    </group>
                    <div class="alert alert-info" role="alert">
                        El usuario verá las recepciones, entregas y traslados de estos almacenes.
                    </div>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_warehouse_form_inherit_ddpc_operators" model="ir.ui.view">
        <field name="name">stock.warehouse.form.ddpc.operators</field>
        <field name="model">stock.warehouse</field>
        <field name="inherit_id" ref="stock.view_warehouse"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/group" position="inside">
                <group string="Operadores DoorAndDoor" groups="base.group_system">
                    <field name="ddpc_operator_user_ids" widget="many2many_tags"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
