<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Vista Kanban para Dashboard de Recepciones de Traslados en Tiempo Real -->
        <record id="view_stock_picking_realtime_dashboard" model="ir.ui.view">
            <field name="name">stock.picking.realtime.dashboard</field>
            <field name="model">stock.picking</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_dashboard o_ddpc_realtime_dashboard" create="false" 
                        default_group_by="ddpc_dest_warehouse_id">
                    <field name="name"/>
                    <field name="ddpc_transfer_stage"/>
                    <field name="ddpc_source_warehouse_id"/>
                    <field name="ddpc_dest_warehouse_id"/>
                    <field name="ddpc_realtime_status"/>
                    <field name="ddpc_last_activity_timestamp"/>
                    <field name="scheduled_date"/>
                    <field name="state"/>
                    <templates>
                        <t t-name="card">
                            <div class="o_ddpc_picking_card">
                                <div class="o_kanban_card_header">
                                    <div class="o_kanban_card_header_title">
                                        <strong><t t-esc="record.name.value"/></strong>
                                    </div>
                                    <div class="o_kanban_card_header_right">
                                        <span class="badge badge-pill o_ddpc_stage_badge"
                                              t-att-class="record.ddpc_transfer_stage.raw_value === 'dispatch' ? 'text-bg-warning' : 'text-bg-info'">
                                            <t t-esc="record.ddpc_transfer_stage.raw_value === 'dispatch' ? 'Despacho' : 'Recepción'"/>
                                        </span>
                                    </div>
                                </div>
                                <div class="o_kanban_card_content">
                                    <div class="row">
                                        <div class="col-6">
                                            <small class="text-muted">Origen:</small>
                                            <div class="font-weight-bold">
                                                <field name="ddpc_source_warehouse_id"/>
                                            </div>
                                        </div>
                                        <div class="col-6">
                                            <small class="text-muted">Destino:</small>
                                            <div class="font-weight-bold">
                                                <field name="ddpc_dest_warehouse_id"/>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row mt-2">
                                        <div class="col-12">
                                            <small class="text-muted">Estado en tiempo real:</small>
                                            <div class="o_ddpc_realtime_status font-weight-bold"
                                                 t-att-class="record.state.raw_value === 'done' ? 'text-success' : 'text-warning'">
                                                <t t-esc="record.ddpc_realtime_status.value or record.state.value"/>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row mt-2">
                                        <div class="col-6">
                                            <small class="text-muted">Fecha programada:</small>
                                            <div><t t-esc="record.scheduled_date.value"/></div>
                                        </div>
                                        <div class="col-6">
                                            <small class="text-muted">Última actividad:</small>
                                            <div class="o_ddpc_last_update text-muted">
                                                <t t-esc="record.ddpc_last_activity_timestamp.value"/>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="o_kanban_card_footer">
                                    <div class="o_kanban_card_manage_button_group">
                                        <button class="btn btn-sm btn-primary" type="open" name="open_record">
                                            <i class="fa fa-eye"/> Ver
                                        </button>
                                        <t t-if="record.ddpc_transfer_stage.raw_value === 'receipt' and record.state.raw_value !== 'done'">
                                            <button class="btn btn-sm btn-success" type="object" name="button_validate">
                                                <i class="fa fa-check"/> Validar Recepción
                                            </button>
                                        </t>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- Acción de menú para el Dashboard de Recepciones en Tiempo Real -->
        <record id="action_stock_picking_realtime_dashboard" model="ir.actions.act_window">
            <field name="name">Recepciones de Traslados en Tiempo Real</field>
            <field name="res_model">stock.picking</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="domain">[
                ('ddpc_transfer_stage', 'in', ['dispatch', 'receipt']),
                ('state', 'not in', ['done', 'cancel'])
            ]</field>
            <field name="context">{
                'default_ddpc_transfer_stage': 'receipt',
                'search_default_my_pickings': 1
            }</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No hay traslados pendientes de recepción en este momento.
                </p>
                <p>
                    Los traslados internos entre almacenes aparecerán aquí cuando sean despachados
                    y estarán disponibles para recepción en tiempo real.
                </p>
            </field>
        </record>

        <!-- Item de menú para el Dashboard -->
        <menuitem id="menu_realtime_transfer_dashboard"
                  name="Recepciones en Tiempo Real"
                  parent="doorandoor_process_control.menu_ddpc_warehouse_root"
                  action="action_stock_picking_realtime_dashboard"
                  sequence="10"
                  groups="stock.group_stock_user"/>
    </data>
</odoo>
