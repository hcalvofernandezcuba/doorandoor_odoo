<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ddpc_pending_delivery_kanban" model="ir.ui.view">
        <field name="name">doorandoor.pending.delivery.kanban</field>
        <field name="model">doorandoor.pending.delivery</field>
        <field name="arch" type="xml">
            <kanban string="Entregas pendientes" create="0" edit="0" delete="0"
                    default_group_by="warehouse_id" quick_create="false"
                    records_draggable="false" groups_draggable="false">
                <field name="invoice_id"/>
                <field name="invoice_date"/>
                <field name="warehouse_id"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="qty_pending_delivery"/>
                <field name="product_uom_id"/>
                <field name="picking_id"/>
                <field name="delivery_date" optional="show"/>
                <field name="mrp_production_id"/>
                <field name="operational_state"/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="border-start border-4 {{
                            record.operational_state.raw_value === 'ready_delivery' ? 'border-success' :
                            record.operational_state.raw_value === 'delivered' ? 'border-primary' :
                            record.operational_state.raw_value === 'waiting_production' ? 'border-warning' :
                            record.operational_state.raw_value === 'in_preparation' ? 'border-info' :
                            'border-secondary'
                        }}">
                            <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                                <strong class="fs-5"><field name="invoice_id"/></strong>
                                <span t-attf-class="badge {{
                                    record.operational_state.raw_value === 'ready_delivery' ? 'text-bg-success' :
                                    record.operational_state.raw_value === 'delivered' ? 'text-bg-primary' :
                                    record.operational_state.raw_value === 'waiting_production' ? 'text-bg-warning' :
                                    record.operational_state.raw_value === 'in_preparation' ? 'text-bg-info' :
                                    'text-bg-secondary'
                                }}"><field name="operational_state"/></span>
                            </div>
                            <div class="mb-2"><i class="fa fa-user me-1" title="Cliente"/><field name="partner_id"/></div>
                            <div class="fw-bold text-primary mb-2"><i class="fa fa-cube me-1" title="Producto"/><field name="product_id"/></div>
                            <div class="mb-2">
                                <span class="text-muted">Pendiente:</span>
                                <strong class="ms-1"><field name="qty_pending_delivery"/></strong>
                                <span class="ms-1"><field name="product_uom_id"/></span>
                            </div>
                            <div class="small" t-if="record.picking_id.raw_value">
                                <i class="fa fa-truck me-1" title="Entrega"/><field name="picking_id"/>
                            </div>
                            <div class="small" t-if="record.mrp_production_id.raw_value">
                                <i class="fa fa-cogs me-1" title="Orden de fabricacion"/><field name="mrp_production_id"/>
                            </div>
                            <div class="text-muted small mt-2"><field name="invoice_date"/></div>
                            <div class="mt-3" t-if="record.picking_id.raw_value and record.operational_state.raw_value !== 'delivered'">
                                <a type="object" name="action_open_picking"
                                   class="btn btn-primary btn-sm">
                                    <i class="fa fa-truck me-1"/>Procesar entrega
                                </a>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_ddpc_pending_delivery_list" model="ir.ui.view">
        <field name="name">doorandoor.pending.delivery.list</field>
        <field name="model">doorandoor.pending.delivery</field>
        <field name="arch" type="xml">
            <list string="Entregas pendientes" create="0" edit="0" delete="0"
                  decoration-success="operational_state == 'ready_delivery'"
                  decoration-primary="operational_state == 'delivered'"
                  decoration-warning="operational_state == 'waiting_production'">
                <field name="warehouse_id"/>
                <field name="invoice_id"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="delivery_date"/>
                <field name="qty_invoiced"/>
                <field name="qty_delivered"/>
                <field name="qty_pending_delivery" sum="Total pendiente"/>
                <field name="product_uom_id"/>
                <field name="operational_state" widget="badge"/>
                <field name="picking_id"/>
                <field name="mrp_production_id" optional="show"/>
                <field name="salesperson_id" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <button name="action_open_picking" type="object"
                        string="Procesar entrega" icon="fa-truck"
                        invisible="not picking_id or operational_state == 'delivered'"/>
            </list>
        </field>
    </record>

    <record id="view_ddpc_pending_delivery_search" model="ir.ui.view">
        <field name="name">doorandoor.pending.delivery.search</field>
        <field name="model">doorandoor.pending.delivery</field>
        <field name="arch" type="xml">
            <search string="Entregas pendientes">
                <field name="invoice_id"/>
                <field name="warehouse_id"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <filter name="waiting_production" string="Esperando produccion" domain="[('operational_state','=','waiting_production')]"/>
                <filter name="pending_preparation" string="Pendientes de preparar" domain="[('operational_state','=','pending_preparation')]"/>
                <filter name="ready_delivery" string="Listas para entregar" domain="[('operational_state','=','ready_delivery')]"/>
                <filter name="delivered" string="Entregadas" domain="[('operational_state','=','delivered')]"/>
                <separator/>
                <filter name="group_warehouse" string="Almacen" context="{'group_by':'warehouse_id'}"/>
                <filter name="group_state" string="Estado" context="{'group_by':'operational_state'}"/>
                <filter name="group_product" string="Producto" context="{'group_by':'product_id'}"/>
            </search>
        </field>
    </record>

    <record id="view_ddpc_pending_delivery_pivot" model="ir.ui.view">
        <field name="name">doorandoor.pending.delivery.pivot</field>
        <field name="model">doorandoor.pending.delivery</field>
        <field name="arch" type="xml">
            <pivot string="Entregas pendientes">
                <field name="warehouse_id" type="row"/>
                <field name="operational_state" type="row"/>
                <field name="product_id" type="row"/>
                <field name="qty_pending_delivery" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_ddpc_pending_delivery_graph" model="ir.ui.view">
        <field name="name">doorandoor.pending.delivery.graph</field>
        <field name="model">doorandoor.pending.delivery</field>
        <field name="arch" type="xml">
            <graph string="Análisis de entregas" type="bar">
                <field name="operational_state"/>
                <field name="qty_pending_delivery" type="measure"/>
                <field name="qty_delivered" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_ddpc_pending_deliveries" model="ir.actions.act_window">
        <field name="name">Entregas pendientes</field>
        <field name="res_model">doorandoor.pending.delivery</field>
        <field name="view_mode">kanban,list,pivot,graph</field>
        <field name="search_view_id" ref="view_ddpc_pending_delivery_search"/>
        <field name="context">{'search_default_group_warehouse': 1}</field>
        <field name="groups_id" eval="[(4, ref('stock.group_stock_user')), (4, ref('base.group_system'))]"/>
        <field name="help" type="html">
            <p>Facturas totalmente pagadas con productos pendientes de entrega.</p>
            <p>La preparación y validación física continúa realizándose desde el picking.</p>
        </field>
    </record>
</odoo>
