<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_order_form_inherit_ddpa_warehouses" model="ir.ui.view">
            <field name="name">sale.order.form.doorandoor.produccion.almacen</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//sheet//field[@name='partner_shipping_id']" position="after">
                    <field name="ddpa_delivery_warehouse_id" options="{'no_create': True}"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
