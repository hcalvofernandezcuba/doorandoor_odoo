<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_mrp_production_form_inherit_ddpa" model="ir.ui.view">
            <field name="name">mrp.production.form.doorandoor.produccion.almacen</field>
            <field name="model">mrp.production</field>
            <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='product_id']" position="after">
                    <field name="ddpa_origin_warehouse_id" options="{'no_create': True}" readonly="1"/>
                    <field name="ddpa_delivery_warehouse_id" options="{'no_create': True}" readonly="1"/>
                    <field name="ddpa_internal_picking_id" readonly="1"/>
                </xpath>
            </field>
        </record>

        <record id="view_mrp_production_tree_inherit_ddpa" model="ir.ui.view">
            <field name="name">mrp.production.tree.doorandoor.produccion.almacen</field>
            <field name="model">mrp.production</field>
            <field name="inherit_id" ref="mrp.mrp_production_tree_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='product_id']" position="after">
                    <field name="ddpa_origin_warehouse_id" optional="show"/>
                    <field name="ddpa_delivery_warehouse_id" optional="show"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
