<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_historic_logistics" model="ir.module.category">
        <field name="name">DoorAndDoor Regularización Histórica</field>
        <field name="sequence">39</field>
    </record>

    <record id="group_historic_logistics_viewer" model="res.groups">
        <field name="name">Consulta</field>
        <field name="category_id" ref="module_category_historic_logistics"/>
    </record>

    <record id="group_historic_logistics_operator" model="res.groups">
        <field name="name">Operador de recepción histórica</field>
        <field name="category_id" ref="module_category_historic_logistics"/>
        <field name="implied_ids" eval="[(4, ref('group_historic_logistics_viewer')), (4, ref('doorandoor_process_control.group_ddpc_warehouse_operator')), (4, ref('doorandoor_inventory_variant_count.group_inventory_count_user')), (4, ref('doorandoor_import_historic_invoices.group_legacy_delivery_ocr_operator'))]"/>
    </record>

    <record id="group_historic_logistics_supervisor" model="res.groups">
        <field name="name">Supervisor de regularización histórica</field>
        <field name="category_id" ref="module_category_historic_logistics"/>
        <field name="implied_ids" eval="[(4, ref('group_historic_logistics_operator')), (4, ref('doorandoor_import_historic_invoices.group_legacy_delivery_ocr_supervisor')), (4, ref('doorandoor_cargas_control.group_load_control_planner'))]"/>
    </record>

    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_historic_logistics_supervisor'))]"/>
    </record>

    <record id="rule_historic_regularization_company" model="ir.rule">
        <field name="name">Regularizaciones históricas por compañía</field>
        <field name="model_id" ref="model_doorandoor_historic_regularization"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(5, 0, 0)]"/>
    </record>

    <record id="rule_historic_regularization_operator_warehouses" model="ir.rule">
        <field name="name">Regularizaciones limitadas a almacenes asignados</field>
        <field name="model_id" ref="model_doorandoor_historic_regularization"/>
        <field name="domain_force">([] if user.has_group('base.group_system') else ([('warehouse_id', 'in', user.ddpc_warehouse_ids.ids)] if user.ddpc_warehouse_ids else [('id', '=', 0)]))</field>
        <field name="groups" eval="[(4, ref('group_historic_logistics_operator'))]"/>
    </record>

    <record id="rule_historic_regularization_supervisor_all" model="ir.rule">
        <field name="name">Supervisor histórico consulta sus almacenes asignados</field>
        <field name="model_id" ref="model_doorandoor_historic_regularization"/>
        <field name="domain_force">([] if user.has_group('base.group_system') else ([('warehouse_id', 'in', user.ddpc_warehouse_ids.ids)] if user.ddpc_warehouse_ids else [('id', '=', 0)]))</field>
        <field name="groups" eval="[(4, ref('group_historic_logistics_supervisor'))]"/>
    </record>

    <record id="rule_historic_regularization_line_company" model="ir.rule">
        <field name="name">Líneas históricas por compañía</field>
        <field name="model_id" ref="model_doorandoor_historic_regularization_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(5, 0, 0)]"/>
    </record>
</odoo>
