<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_legacy_delivery_import_batch" model="ir.sequence">
        <field name="name">Lote de importación histórica</field>
        <field name="code">doorandoor.legacy.delivery.import.batch</field>
        <field name="prefix">HIB/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_legacy_delivery_ocr" model="ir.sequence">
        <field name="name">Documento histórico importado</field>
        <field name="code">doorandoor.legacy.delivery.ocr</field>
        <field name="prefix">HIOCR/%(year)s/</field>
        <field name="padding">6</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
