<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_inventory_initial_load_report_list" model="ir.ui.view">
        <field name="name">inventory.initial.load.report.list</field>
        <field name="model">inventory.initial.load.report</field>
        <field name="arch" type="xml">
            <list string="Carga inicial oficial" create="0" edit="0" delete="0"
                  decoration-muted="category == 'test_cleanup'"
                  decoration-warning="category == 'correction'">
                <field name="date"/><field name="reference"/><field name="session_id" optional="show"/>
                <field name="load_reference" optional="show"/><field name="warehouse_id"/>
                <field name="product_id"/><field name="direction" widget="badge"/>
                <field name="quantity_in" sum="Total cargado"/><field name="quantity_out" sum="Total correcciones tecnicas"/>
                <field name="net_quantity" sum="Total neto"/><field name="product_uom"/>
                <field name="category" widget="badge"/><field name="user_id" optional="hide"/>
                <field name="location_id" optional="hide"/><field name="location_dest_id" optional="hide"/>
                <field name="move_id" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_inventory_initial_load_report_pivot" model="ir.ui.view">
        <field name="name">inventory.initial.load.report.pivot</field><field name="model">inventory.initial.load.report</field>
        <field name="arch" type="xml"><pivot string="Carga inicial oficial" disable_linking="true">
            <field name="warehouse_id" type="row"/><field name="load_reference" type="row"/>
            <field name="date" interval="day" type="col"/><field name="quantity_in" type="measure"/>
            <field name="quantity_out" type="measure"/><field name="net_quantity" type="measure"/>
            <field name="move_count" type="measure"/>
        </pivot></field>
    </record>
    <record id="view_inventory_initial_load_report_graph" model="ir.ui.view">
        <field name="name">inventory.initial.load.report.graph</field><field name="model">inventory.initial.load.report</field>
        <field name="arch" type="xml"><graph string="Carga inicial oficial" type="bar">
            <field name="warehouse_id"/><field name="net_quantity" type="measure"/>
        </graph></field>
    </record>
    <record id="view_inventory_initial_load_report_search" model="ir.ui.view">
        <field name="name">inventory.initial.load.report.search</field><field name="model">inventory.initial.load.report</field>
        <field name="arch" type="xml"><search string="Carga inicial oficial">
            <field name="reference"/><field name="load_reference"/><field name="product_id"/><field name="warehouse_id"/>
            <filter name="official" string="Carga oficial" domain="[('category', 'in', ('initial_load', 'correction'))]"/>
            <filter name="initial_load" string="Carga inicial" domain="[('category', '=', 'initial_load')]"/>
            <filter name="correction" string="Correcciones" domain="[('category', '=', 'correction')]"/>
            <filter name="test_cleanup" string="Pruebas / limpieza" domain="[('category', '=', 'test_cleanup')]"/>
            <separator/><filter name="direction_in" string="Entradas" domain="[('direction', '=', 'in')]"/>
            <filter name="direction_out" string="Reducciones tecnicas" domain="[('direction', '=', 'out')]"/>
            <group expand="0" string="Agrupar por">
                <filter name="group_warehouse" string="Almacen" context="{'group_by': 'warehouse_id'}"/>
                <filter name="group_lot" string="Lote" context="{'group_by': 'load_reference'}"/>
                <filter name="group_product" string="Producto" context="{'group_by': 'product_id'}"/>
                <filter name="group_session" string="Sesion" context="{'group_by': 'session_id'}"/>
                <filter name="group_category" string="Clasificacion" context="{'group_by': 'category'}"/>
                <filter name="group_date" string="Fecha" context="{'group_by': 'date:day'}"/>
            </group>
        </search></field>
    </record>
    <record id="action_inventory_initial_load_report" model="ir.actions.act_window">
        <field name="name">Carga inicial oficial</field><field name="res_model">inventory.initial.load.report</field>
        <field name="view_mode">pivot,list,graph</field><field name="search_view_id" ref="view_inventory_initial_load_report_search"/>
        <field name="context">{'search_default_official': 1}</field>
    </record>
    <menuitem id="menu_stock_initial_load_report" name="Carga inicial oficial" parent="stock.menu_warehouse_report"
              action="action_inventory_initial_load_report" sequence="235"
              groups="doorandoor_inventory_variant_count.group_inventory_count_manager,base.group_system"/>
    <menuitem id="menu_inventory_count_reports" name="Informes"
              parent="doorandoor_inventory_variant_count.menu_inventory_count_root" sequence="80"
              groups="doorandoor_inventory_variant_count.group_inventory_count_manager,base.group_system"/>
    <menuitem id="menu_inventory_count_initial_load_report" name="Carga inicial oficial"
              parent="menu_inventory_count_reports" action="action_inventory_initial_load_report" sequence="10"/>
</odoo>
