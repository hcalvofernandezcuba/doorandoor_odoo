<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_ddsp_special_products" model="ir.ui.view">
        <field name="name">account.move.form.ddsp.special.products</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_open_ddsp_special_from_master"
                        type="object"
                        string="Agregar producto especial"
                        class="btn-secondary"
                        invisible="state != 'draft' or move_type != 'out_invoice' or (ddsn_is_preinvoice and ddsn_preinvoice_state == 'confirmed')"
                        groups="sales_team.group_sale_salesman"/>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/form//field[@name='product_id']" position="after">
                <field name="ddsp_is_special_product" readonly="1"/>
                <field name="ddsp_special_bom_state" readonly="1" invisible="not ddsp_is_special_product"/>
            </xpath>
        </field>
    </record>

    <record id="view_move_form_exclude_transformed_products_ddsp" model="ir.ui.view">
        <field name="name">account.move.form.ddsp.exclude.transformed.products</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="doorandoor_product_config.view_move_form_inherit_ddpc"/>
        <field name="priority">130</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='ddpc_product_template_id']" position="attributes">
                <attribute name="domain">[('sale_ok', '=', True), ('ddsp_is_special', '=', False), ('ddsp_is_manufacturing_template', '=', False)]</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/form//field[@name='ddpc_product_template_id']" position="attributes">
                <attribute name="domain">[('sale_ok', '=', True), ('ddsp_is_special', '=', False), ('ddsp_is_manufacturing_template', '=', False)]</attribute>
            </xpath>
        </field>
    </record>
</odoo>
