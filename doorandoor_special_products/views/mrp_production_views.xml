<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mrp_production_form_ddsp_special" model="ir.ui.view">
        <field name="name">mrp.production.form.ddsp.special</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <field name="ddsp_is_special" invisible="1"/>
                <field name="ddsp_product_kind" invisible="1"/>
                <div class="alert alert-danger" role="alert" invisible="not ddsp_is_special or ddsp_product_kind == 'special'">
                    <strong>Orden de producto transformado:</strong> fabricar conforme a los cambios e instrucciones indicados abajo.
                </div>
                <div class="alert alert-info" role="alert" invisible="ddsp_product_kind != 'special'">
                    <strong>Orden de producto especial:</strong> fabricar desde la LDM maestra, sin consumir un producto terminado base.
                </div>
                <group string="Guia de fabricacion personalizada" invisible="not ddsp_is_special">
                    <group>
                        <field name="ddsp_base_product_tmpl_id" readonly="1"/>
                        <field name="ddsp_origin_invoice_id" readonly="1"/>
                        <field name="ddsp_dimensions_display" readonly="1" class="fw-bold"/>
                    </group>
                    <group>
                        <field name="ddsp_special_notes" readonly="1"/>
                        <field name="ddsp_product_kind" readonly="1"/>
                        <field name="ddsp_manufacturing_family" readonly="1"/>
                        <field name="ddsp_source_bom_template_id" readonly="1"/>
                        <field name="ddsp_production_instructions" readonly="1"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
