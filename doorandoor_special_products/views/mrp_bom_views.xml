<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mrp_bom_form_ddsp_special" model="ir.ui.view">
        <field name="name">mrp.bom.form.ddsp.special</field>
        <field name="model">mrp.bom</field>
        <field name="inherit_id" ref="mrp.mrp_bom_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <field name="ddsp_is_special" invisible="1"/>
                <field name="ddsp_product_kind" invisible="1"/>
                <div class="alert alert-warning" role="alert" invisible="not ddsp_is_special or ddsp_product_kind == 'special'">
                    <strong>Receta transformada:</strong> revise cambios, componentes, operaciones e instrucciones antes de validar esta LDM.
                </div>
                <div class="alert alert-info" role="alert" invisible="ddsp_product_kind != 'special'">
                    <strong>Receta especial:</strong> creada desde materias primas y operaciones de una plantilla maestra.
                </div>
                <group string="Guia del producto personalizado" invisible="not ddsp_is_special">
                    <group>
                        <field name="ddsp_base_product_tmpl_id" readonly="1"/>
                        <field name="ddsp_origin_invoice_id" readonly="1"/>
                        <field name="ddsp_dimensions_display" readonly="1" class="fw-bold"/>
                        <field name="ddsp_bom_state" readonly="1"/>
                    </group>
                    <group>
                        <field name="ddsp_special_notes" readonly="1"/>
                        <field name="ddsp_product_kind" readonly="1"/>
                        <field name="ddsp_manufacturing_family" readonly="1"/>
                        <field name="ddsp_source_bom_template_id" readonly="1"/>
                        <field name="ddsp_production_instructions" readonly="1"/>
                    </group>
                </group>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Reglas de transformacion" groups="mrp.group_mrp_manager">
                    <field name="ddsp_manufacturing_rule_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="component_product_id"/>
                            <field name="attribute_id"/>
                            <field name="condition_value"/>
                            <field name="base_quantity"/>
                            <field name="value_factor"/>
                            <field name="waste_percent"/>
                        </list>
                    </field>
                    <div class="alert alert-info mt-2" role="alert">
                        Formula: Cantidad base + (valor numerico del atributo x factor), mas el porcentaje de merma.
                    </div>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
