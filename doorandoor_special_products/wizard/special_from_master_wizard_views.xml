<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ddsp_special_from_master_wizard_form" model="ir.ui.view">
        <field name="name">ddsp.special.from.master.wizard.form</field>
        <field name="model">ddsp.special.from.master.wizard</field>
        <field name="arch" type="xml">
            <form string="Crear producto especial">
                <sheet>
                    <div class="alert alert-info" role="alert">
                        Este producto se fabricara desde materias primas de la LDM maestra.
                        No consume un producto terminado de stock.
                    </div>
                    <field name="sale_order_id" invisible="1"/>
                    <field name="move_id" invisible="1"/>
                    <field name="company_id" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="allow_vendor_price" invisible="1"/>
                    <group>
                        <group string="Plantilla">
                            <field name="create_new_master"
                                   groups="doorandoor_special_products.group_ddsp_master_template_creator"/>
                            <field name="master_template_id"
                                   required="not create_new_master"
                                   invisible="create_new_master"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="new_master_name"
                                   required="create_new_master"
                                   invisible="not create_new_master"/>
                            <field name="new_master_output_name"
                                   required="create_new_master"
                                   invisible="not create_new_master"/>
                            <field name="new_master_family"
                                   required="create_new_master"
                                   invisible="not create_new_master"/>
                            <field name="new_master_reference"
                                   invisible="not create_new_master"
                                   placeholder="Opcional; se genera automaticamente"/>
                            <field name="base_variant_id"
                                   invisible="create_new_master"
                                   placeholder="Seleccione la configuración que servirá de referencia"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="master_bom_id"
                                   invisible="create_new_master"
                                   placeholder="Opcional: se creara una LDM automatica"
                                   options="{'no_create': True, 'no_open': True}"/>
                        </group>
                        <group string="Venta">
                            <field name="quantity"/>
                            <field name="price_unit" readonly="not allow_vendor_price"
                                   help="En plantillas autorizadas, introduzca el precio cotizado por el proveedor. En las demas se usa el precio administrativo configurado."/>
                            <div class="alert alert-warning" role="alert"
                                 invisible="not allow_vendor_price">
                                Introduzca el precio vigente cotizado por el proveedor para este producto especial.
                            </div>
                        </group>
                    </group>
                    <group string="Configuración completa del nuevo producto">
                        <field name="attribute_line_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="modify"/>
                                <field name="attribute_id"
                                       options="{'no_create': True, 'no_create_edit': True}"/>
                                <field name="new_attribute_name"
                                       placeholder="O escriba un atributo nuevo"/>
                                <field name="base_value" readonly="1"/>
                                <field name="value"
                                       placeholder="Solo si modifica"
                                       readonly="not modify"
                                       required="modify"/>
                                <field name="result_value" readonly="1"/>
                            </list>
                        </field>
                        <div class="alert alert-info mt-2" role="alert">
                            Los valores de la configuración base se conservan automáticamente.
                            Marque Modificar solamente en los atributos que cambiarán y escriba su nuevo valor.
                            También puede agregar atributos nuevos.
                        </div>
                    </group>
                    <notebook>
                        <page string="Componentes de la receta">
                            <field name="component_line_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="include"/>
                                    <field name="product_id"/>
                                    <field name="product_qty"/>
                                    <field name="product_uom_id"/>
                                    <field name="source_operation_id" readonly="1" optional="show"/>
                                </list>
                            </field>
                            <div class="alert alert-info mt-2" role="alert">
                                Desmarque los componentes que no formarán parte del Especial.
                                Puede ajustar cantidades o agregar componentes nuevos.
                                Al crear una plantilla nueva debe incluir al menos un componente real;
                                esta receta quedará guardada para los próximos productos de la familia.
                            </div>
                        </page>
                        <page string="Operaciones de fabricación">
                            <field name="operation_line_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="include"/>
                                    <field name="name"/>
                                    <field name="workcenter_id"/>
                                    <field name="time_cycle_manual"/>
                                </list>
                            </field>
                            <div class="alert alert-info mt-2" role="alert">
                                Desmarque las operaciones que no deben copiarse a la nueva LDM.
                            </div>
                        </page>
                    </notebook>
                    <group>
                        <field name="special_notes" placeholder="Descripción, acabado, tolerancias y requisitos del cliente."/>
                        <field name="production_instructions" placeholder="Cortes, ensamblaje, controles y terminación."/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_create_special_product" type="object"
                            string="Crear especial y agregar" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
