        <field name="model">inventory.count.session</field>
        <field name="inherit_id" ref="doorandoor_inventory_variant_count.view_inventory_count_session_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_ddhd_create_ticket" type="object" string="Crear ticket de soporte"
                        icon="fa-life-ring" class="btn-secondary"/>
            </xpath>
        </field>
    </record>

    <record id="view_inventory_serial_batch_form_ddhd_ticket" model="ir.ui.view">
