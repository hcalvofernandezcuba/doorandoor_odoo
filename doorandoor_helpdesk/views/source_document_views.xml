<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_order_form_ddhd_ticket" model="ir.ui.view">
        <field name="name">sale.order.form.ddhd.ticket</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_ddhd_create_ticket" type="object" string="Crear ticket de soporte"
                        icon="fa-life-ring" class="btn-secondary"/>
            </xpath>
        </field>
    </record>

    <record id="view_account_move_form_ddhd_ticket" model="ir.ui.view">
