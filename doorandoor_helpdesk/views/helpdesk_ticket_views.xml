<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ddhd_ticket_list" model="ir.ui.view">
        <field name="name">doorandoor.helpdesk.ticket.list</field>
        <field name="model">doorandoor.helpdesk.ticket</field>
        <field name="arch" type="xml">
            <list string="Tickets de soporte" decoration-danger="priority == '3' and state not in ('resolved','closed')"
                  decoration-success="state in ('resolved','closed')" decoration-warning="state == 'waiting'">
                <field name="priority" widget="priority"/>
                <field name="name"/>
                <field name="title"/>
                <field name="office_id"/>
                <field name="requester_id"/>
                <field name="received_by_id" optional="hide"/>
                <field name="request_channel" widget="badge" optional="show"/>
                <field name="affected_area" widget="badge"/>
                <field name="assigned_user_id"/>
                <field name="user_action_required" optional="show"/>
                <field name="create_date"/>
                <field name="resolved_at" optional="show"/>
                <field name="solution_hours" optional="show" avg="Promedio"/>
                <field name="solution_efficiency" widget="badge" optional="show"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_ddhd_ticket_kanban" model="ir.ui.view">
        <field name="name">doorandoor.helpdesk.ticket.kanban</field>
        <field name="model">doorandoor.helpdesk.ticket</field>
        <field name="arch" type="xml">
            <kanban string="Tickets de soporte" default_group_by="state" quick_create="false" records_draggable="false">
                <field name="name"/><field name="title"/><field name="priority"/>
                <field name="office_id"/><field name="requester_id"/><field name="received_by_id"/>
                <field name="request_channel"/><field name="affected_area"/>
                <field name="assigned_user_id"/><field name="state"/><field name="create_date"/>
                <field name="user_action_required"/><field name="required_action"/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="border-start border-5 {{record.priority.raw_value === '3' ? 'border-danger' : record.priority.raw_value === '2' ? 'border-warning' : 'border-primary'}}">
                            <div class="d-flex justify-content-between gap-2">
                                <strong class="fs-5"><field name="name"/></strong>
                                <field name="priority" widget="priority"/>
                            </div>
                            <div class="fw-bold mt-2"><field name="title"/></div>
                            <div class="mt-2"><field name="affected_area" widget="badge"/></div>
                            <div class="mt-2"><i class="fa fa-building me-1"/><field name="office_id"/></div>
                            <div><i class="fa fa-user me-1"/><field name="requester_id"/></div>
                            <div class="small"><i class="fa fa-inbox me-1"/><field name="request_channel"/></div>
                            <div t-if="record.assigned_user_id.raw_value" class="mt-2 text-primary">
                                <i class="fa fa-wrench me-1"/><field name="assigned_user_id"/>
                            </div>
                            <div t-if="record.user_action_required.raw_value" class="mt-2 alert alert-warning py-1 px-2">
                                <strong>Acción requerida:</strong>
                                <div><field name="required_action"/></div>
                            </div>
                            <div class="small text-muted mt-2"><field name="create_date"/></div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_ddhd_ticket_form" model="ir.ui.view">
        <field name="name">doorandoor.helpdesk.ticket.form</field>
        <field name="model">doorandoor.helpdesk.ticket</field>
        <field name="arch" type="xml">
            <form string="Ticket de soporte">
                <header>
                    <button name="action_start_analysis" type="object" string="Iniciar análisis" class="btn-primary"
                            groups="doorandoor_helpdesk.group_ddhd_technician,base.group_system" invisible="state != 'new'"/>
                    <button name="action_waiting" type="object" string="Esperar respuesta"
                            groups="doorandoor_helpdesk.group_ddhd_technician,base.group_system" invisible="state != 'analysis'"/>
                    <button name="action_resolve" type="object" string="Marcar resuelto" class="btn-success"
                            groups="doorandoor_helpdesk.group_ddhd_technician,base.group_system" invisible="state not in ('analysis','waiting')"/>
                    <button name="action_confirm_required_action" type="object"
                            string="Confirmar acción realizada" class="btn-primary"
                            invisible="state != 'waiting' or not user_action_required or requester_id != uid"/>
                    <button name="action_close" type="object" string="Confirmar solución y cerrar"
                            class="btn-success" invisible="state != 'resolved' or requester_id != uid"/>
                    <button name="action_close" type="object" string="Cerrar ticket"
                            groups="doorandoor_helpdesk.group_ddhd_manager,base.group_system"
                            invisible="state != 'resolved' or requester_id == uid"/>
                    <button name="action_reopen" type="object" string="Reabrir"
                            groups="doorandoor_helpdesk.group_ddhd_technician,base.group_system" invisible="state not in ('resolved','closed')"/>
                    <field name="state" widget="statusbar" statusbar_visible="new,analysis,waiting,resolved,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                        <h2><field name="title" placeholder="Describa brevemente el problema..."/></h2>
                    </div>
                    <group>
                        <group string="Origen">
                            <field name="requester_id" string="Originado por"/>
                            <field name="received_by_id" readonly="1"/>
                            <field name="request_channel"/>
                            <field name="office_id"/>
                            <field name="warehouse_id" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Clasificación">
                            <field name="priority" widget="priority"/>
                            <field name="affected_area"/>
                            <field name="assigned_user_id" groups="doorandoor_helpdesk.group_ddhd_technician,base.group_system"/>
                            <field name="create_date" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Problema">
                            <field name="description" placeholder="Qué intentaba hacer, qué ocurrió y qué resultado esperaba..."/>
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </page>
                        <page string="Acción requerida" invisible="not user_action_required and state not in ('analysis','waiting')">
                            <field name="user_action_required" invisible="1"/>
                            <group>
                                <field name="user_action_required"
                                       groups="doorandoor_helpdesk.group_ddhd_technician,doorandoor_helpdesk.group_ddhd_manager,base.group_system"/>
                                <field name="required_action"
                                       placeholder="Indique paso a paso qué debe hacer el usuario y qué evidencia debe devolver..."
                                       readonly="not user_action_required"
                                       groups="doorandoor_helpdesk.group_ddhd_technician,doorandoor_helpdesk.group_ddhd_manager,base.group_system"/>
                                <field name="required_action" readonly="1"
                                       groups="base.group_user,!doorandoor_helpdesk.group_ddhd_technician,!doorandoor_helpdesk.group_ddhd_manager,!base.group_system"/>
                            </group>
                            <div class="alert alert-warning" invisible="not user_action_required">
                                Esta instrucción se enviará al usuario mediante las notificaciones internas de Odoo.
                            </div>
                        </page>
                        <page string="Información técnica" groups="doorandoor_helpdesk.group_ddhd_technician,base.group_system">
                            <group>
                                <field name="model_name"/>
                                <field name="record_id"/>
                                <field name="source_display_name"/>
                                <field name="current_url" widget="url"/>
                                <field name="analysis_started_at"/>
                                <field name="resolved_at"/>
                                <field name="solution_hours"/>
                                <field name="solution_efficiency" widget="badge"/>
                                <field name="resolution_notified_at"/>
                                <field name="closed_at"/>
                            </group>
                            <field name="error_details" nolabel="1" placeholder="Traceback o detalle técnico capturado..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_ddhd_ticket_search" model="ir.ui.view">
        <field name="name">doorandoor.helpdesk.ticket.search</field>
        <field name="model">doorandoor.helpdesk.ticket</field>
        <field name="arch" type="xml">
            <search string="Buscar tickets">
                <field name="name"/><field name="title"/><field name="requester_id"/>
                <field name="received_by_id"/><field name="request_channel"/>
                <field name="office_id"/><field name="assigned_user_id"/><field name="affected_area"/>
                <field name="create_date"/>
                <field name="resolved_at"/>
                <field name="solution_efficiency"/>
                <filter name="create_date_period" string="Fecha de creación" date="create_date"/>
                <filter name="resolved_date_period" string="Fecha de solución" date="resolved_at"/>
                <filter name="open" string="Abiertos" domain="[('state','not in',('resolved','closed','cancel'))]"/>
                <filter name="my_tickets" string="Mis tickets" domain="[('requester_id','=',uid)]"/>
                <filter name="assigned_to_me" string="Asignados a mí" domain="[('assigned_user_id','=',uid)]"/>
                <filter name="urgent" string="Urgentes" domain="[('priority','in',('2','3'))]"/>
                <filter name="user_action_required" string="Acción del usuario pendiente" domain="[('user_action_required','=',True),('state','=','waiting')]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_state" string="Estado" context="{'group_by':'state'}"/>
                    <filter name="group_office" string="Oficina" context="{'group_by':'office_id'}"/>
                    <filter name="group_area" string="Área" context="{'group_by':'affected_area'}"/>
                    <filter name="group_channel" string="Canal" context="{'group_by':'request_channel'}"/>
                    <filter name="group_assigned" string="Técnico" context="{'group_by':'assigned_user_id'}"/>
                    <filter name="group_efficiency" string="Eficiencia" context="{'group_by':'solution_efficiency'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_ddhd_my_tickets" model="ir.actions.act_window">
        <field name="name">Mis tickets</field>
        <field name="res_model">doorandoor.helpdesk.ticket</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_ddhd_ticket_search"/>
        <field name="domain">[('requester_id', '=', uid)]</field>
        <field name="context">{}</field>
    </record>

    <record id="action_ddhd_all_tickets" model="ir.actions.act_window">
        <field name="name">Todos los tickets</field>
        <field name="res_model">doorandoor.helpdesk.ticket</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_ddhd_ticket_search"/>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>

    <record id="action_ddhd_local_tickets" model="ir.actions.act_window">
        <field name="name">Casos de mi sede</field>
        <field name="res_model">doorandoor.helpdesk.ticket</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_ddhd_ticket_search"/>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No hay casos registrados para sus oficinas o almacenes.</p>
            <p>La bandeja muestra sus propios tickets y los casos vinculados a las sedes operativas que tiene asignadas.</p>
        </field>
    </record>

    <record id="view_ddhd_ticket_solution_graph" model="ir.ui.view">
        <field name="name">doorandoor.helpdesk.ticket.solution.graph</field>
        <field name="model">doorandoor.helpdesk.ticket</field>
        <field name="arch" type="xml">
            <graph string="Soluciones por técnico" type="bar" stacked="1">
                <field name="assigned_user_id"/>
                <field name="solution_efficiency"/>
                <field name="id" type="measure"/>
            </graph>
        </field>
    </record>
    <record id="view_ddhd_ticket_solution_pivot" model="ir.ui.view">
        <field name="name">doorandoor.helpdesk.ticket.solution.pivot</field>
        <field name="model">doorandoor.helpdesk.ticket</field>
        <field name="arch" type="xml">
            <pivot string="Soluciones por técnico">
                <field name="assigned_user_id" type="row"/>
                <field name="solution_efficiency" type="col"/>
                <field name="create_date" interval="month" type="col"/>
                <field name="solution_hours" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="action_ddhd_solution_dashboard" model="ir.actions.act_window">
        <field name="name">Tablero de soluciones</field>
        <field name="res_model">doorandoor.helpdesk.ticket</field>
        <field name="view_mode">graph,pivot,list,form</field>
        <field name="search_view_id" ref="view_ddhd_ticket_search"/>
        <field name="domain">[('state','in',('resolved','closed'))]</field>
        <field name="context">{'search_default_group_assigned': 1}</field>
    </record>
</odoo>
