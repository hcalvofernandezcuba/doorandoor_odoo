<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ddhd_daily_report_form" model="ir.ui.view">
        <field name="name">doorandoor.helpdesk.daily.report.form</field>
        <field name="model">doorandoor.helpdesk.daily.report</field>
        <field name="arch" type="xml">
            <form string="Reporte diario de soporte">
                <group><field name="report_date"/><field name="company_id" groups="base.group_multi_company"/></group>
                <field name="ticket_ids" readonly="1">
                    <list><field name="name"/><field name="title"/><field name="affected_area"/><field name="assigned_user_id"/><field name="state" widget="badge"/></list>
                </field>
                <footer>
                    <button name="action_print_report" type="object" string="Imprimir PDF" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_ddhd_daily_report_wizard" model="ir.actions.act_window">
        <field name="name">Reporte diario</field><field name="res_model">doorandoor.helpdesk.daily.report</field>
        <field name="view_mode">form</field><field name="target">new</field>
    </record>
</odoo>
