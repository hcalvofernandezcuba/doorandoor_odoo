<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ddhd_summary_report_form" model="ir.ui.view">
        <field name="name">doorandoor.helpdesk.summary.report.form</field>
        <field name="model">doorandoor.helpdesk.summary.report</field>
        <field name="arch" type="xml">
            <form string="Reporte resumido de soporte">
                <group>
                    <group>
                        <field name="date_from"/><field name="date_to"/>
                        <field name="date_basis"/>
                        <field name="state_filter"/>
                    </group>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="assigned_user_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        <field name="requester_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        <field name="affected_area_filter"/>
                        <field name="total_count" readonly="1"/>
                    </group>
                </group>
                <group string="Totales por estado" col="7">
                    <field name="new_count" readonly="1"/>
                    <field name="analysis_count" readonly="1"/>
                    <field name="waiting_count" readonly="1"/>
                    <field name="resolved_count" readonly="1"/>
                    <field name="closed_count" readonly="1"/>
                    <field name="cancelled_count" readonly="1"/>
                </group>
                <field name="ticket_ids" readonly="1">
                    <list>
                        <field name="create_date"/><field name="name"/><field name="title"/>
                        <field name="requester_id"/><field name="affected_area"/>
                        <field name="assigned_user_id"/><field name="resolved_at"/>
                        <field name="solution_hours" avg="Promedio"/>
                        <field name="solution_efficiency" widget="badge"/>
                        <field name="state" widget="badge"/>
                    </list>
                </field>
                <footer>
                    <button name="action_print_report" type="object" string="Imprimir PDF" class="btn-primary"/>
                    <button string="Cerrar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_ddhd_summary_report_wizard" model="ir.actions.act_window">
        <field name="name">Reporte resumido</field>
        <field name="res_model">doorandoor.helpdesk.summary.report</field>
        <field name="view_mode">form</field><field name="target">new</field>
    </record>
</odoo>
