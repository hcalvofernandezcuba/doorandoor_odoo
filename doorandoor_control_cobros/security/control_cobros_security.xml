<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="group_ddc_user" model="res.groups">
            <field name="name">DoorAndDoor Control de Cobros User</field>
            <field name="category_id" ref="base.module_category_hidden"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_ddc_manager" model="res.groups">
            <field name="name">DoorAndDoor Control de Cobros Manager</field>
            <field name="category_id" ref="base.module_category_hidden"/>
            <field name="implied_ids" eval="[(4, ref('doorandoor_control_cobros.group_ddc_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_admin'))]"/>
        </record>

        <record id="group_ddc_official_payment" model="res.groups">
            <field name="name">DoorAndDoor Registrar pagos oficiales</field>
            <field name="category_id" ref="base.module_category_hidden"/>
            <field name="implied_ids" eval="[(4, ref('doorandoor_control_cobros.group_ddc_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_admin'))]"/>
        </record>

        <record id="group_ddc_manager" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('doorandoor_control_cobros.group_ddc_official_payment'))]"/>
        </record>

        <record id="sales_team.group_sale_salesman" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('doorandoor_control_cobros.group_ddc_user'))]"/>
        </record>

        <record id="account.group_account_invoice" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('doorandoor_control_cobros.group_ddc_user'))]"/>
        </record>

        <record id="seq_doorandoor_cobro_control" model="ir.sequence">
            <field name="name">DoorAndDoor Control de Cobro</field>
            <field name="code">doorandoor.cobro.control</field>
            <field name="prefix">CC/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_doorandoor_credit_authorization" model="ir.sequence">
            <field name="name">DoorAndDoor Autorizacion de Credito</field>
            <field name="code">doorandoor.credit.authorization</field>
            <field name="prefix">AUT-CRED/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
