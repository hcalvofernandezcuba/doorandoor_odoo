<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ddc_cobro_control_tree" model="ir.ui.view">
        <field name="name">doorandoor.cobro.control.tree</field>
        <field name="model">doorandoor.cobro.control</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="state"/>
                <field name="matching_status"/>
                <field name="is_partial"/>
                <field name="payment_state"/>
                <field name="invoice_payment_state"/>
                <field name="move_id"/>
                <field name="credit_authorization_id" optional="show"/>
                <field name="payment_id"/>
                <field name="partner_id"/>
                <field name="journal_id"/>
                <field name="payment_date"/>
                <field name="amount_reported"/>
                <field name="validated_amount"/>
                <field name="sale_user_id"/>
                <field name="accountant_user_id"/>
            </list>
        </field>
    </record>

    <record id="view_ddc_cobro_control_form" model="ir.ui.view">
        <field name="name">doorandoor.cobro.control.form</field>
        <field name="model">doorandoor.cobro.control</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_print_control_report" type="object" string="Imprimir" class="btn-secondary"/>
                    <button name="action_report" type="object" string="Reportar" invisible="state != 'draft'"/>
                    <button name="action_open_match_wizard" type="object" string="Asociar pago/factura"
                            groups="doorandoor_control_cobros.group_ddc_official_payment"
                            invisible="state == 'validated'"/>
                    <button name="action_create_payment_entry" type="object" string="Crear pago contable"
                            groups="doorandoor_control_cobros.group_ddc_official_payment"
                            invisible="payment_id != False or source_type == 'sales_report'"/>
                    <button name="action_mark_pending" type="object" string="Pasar a pendiente" invisible="state not in ('reported', 'draft', 'rejected')"/>
                    <button name="action_review" type="object" string="Revisar"
                            groups="doorandoor_control_cobros.group_ddc_official_payment"
                            invisible="state not in ('reported', 'pending')"/>
                    <button name="action_validate" type="object" string="Validar"
                            groups="doorandoor_control_cobros.group_ddc_official_payment"
                            invisible="state not in ('review', 'pending', 'reported') or not payment_id"/>
                    <button name="action_validate" type="object" string="Reparar conciliacion" class="btn-primary" invisible="not needs_reconciliation_repair"/>
                    <button name="action_reject" type="object" string="Rechazar"
                            groups="doorandoor_control_cobros.group_ddc_official_payment"
                            invisible="state not in ('review', 'pending', 'reported')"/>
                    <button name="action_ddc_force_operational_sync" type="object"
                            string="Forzar sincronización" class="btn-secondary"
                            groups="base.group_system" invisible="not move_id"/>
                    <field name="needs_reconciliation_repair" invisible="1"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,reported,pending,review,validated,rejected"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="move_id"/>
                            <field name="credit_authorization_id"
                                   invisible="source_type != 'authorized_credit_repayment'"
                                   readonly="state == 'validated'"
                                   options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="credit_origin_invoice_id"
                                   invisible="source_type != 'authorized_credit_repayment'"
                                   readonly="1"/>
                            <field name="payment_id"
                                   groups="doorandoor_control_cobros.group_ddc_official_payment"
                                   options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="payment_id" readonly="1"
                                   groups="!doorandoor_control_cobros.group_ddc_official_payment"/>
                            <field name="matching_status" readonly="1"/>
                            <field name="payment_state" readonly="1"/>
                            <field name="invoice_payment_state" readonly="1"/>
                            <field name="partner_id"/>
                            <field name="journal_id"/>
                            <field name="payment_date"/>
                        </group>
                        <group>
                            <field name="amount_reported"/>
                            <field name="validated_amount"/>
                            <field name="payment_reference"/>
                            <field name="source_type"/>
                            <field name="credit_origin_control_id" invisible="source_type != 'customer_credit'"/>
                            <field name="is_unidentified" readonly="1"/>
                            <field name="is_partial" readonly="1"/>
                            <field name="sale_user_id"/>
                            <field name="accountant_user_id" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="review_date" readonly="1"/>
                            <field name="invoice_residual_snapshot" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                            <field name="credit_balance_before" invisible="source_type != 'customer_credit'"/>
                            <field name="credit_applied_amount" invisible="source_type != 'customer_credit'"/>
                            <field name="credit_balance_after" invisible="source_type != 'customer_credit'"/>
                            <field name="authorized_credit_balance_before"
                                   invisible="source_type != 'authorized_credit_repayment'"/>
                            <field name="authorized_credit_applied_amount"
                                   invisible="source_type != 'authorized_credit_repayment'"/>
                            <field name="authorized_credit_balance_after"
                                   invisible="source_type != 'authorized_credit_repayment'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notas">
                            <field name="notes"/>
                        </page>
                        <page string="Identificacion">
                            <field name="identification_notes" placeholder="Usa este espacio para documentar pagos recibidos antes de identificar su factura o el pago contable real."/>
                        </page>
                        <page string="Documentos del pago" invisible="not payment_id">
                            <field name="payment_support_attachment_ids" widget="many2many_binary" nolabel="1" readonly="1"/>
                        </page>
                        <page string="Rechazo">
                            <field name="rejection_reason" readonly="state != 'rejected'"/>
                        </page>
                        <page string="Actividad">
                            <field name="message_follower_ids"/>
                            <field name="activity_ids"/>
                            <field name="message_ids"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ddc_cobro_control_search" model="ir.ui.view">
        <field name="name">doorandoor.cobro.control.search</field>
        <field name="model">doorandoor.cobro.control</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="move_id"/>
                <field name="partner_id"/>
                <field name="journal_id"/>
                <field name="payment_id"/>
                <field name="matching_status"/>
                <field name="payment_state"/>
                <field name="invoice_payment_state"/>
                <filter string="Pendientes" name="pending" domain="[('state', 'in', ['reported', 'pending', 'review'])]"/>
                <filter string="Pagos por identificar" name="unidentified" domain="[('move_id', '=', False)]"/>
                <filter string="Cliente identificado" name="identified" domain="[('matching_status', '=', 'identified')]"/>
                <filter string="Con factura" name="with_invoice" domain="[('move_id', '!=', False)]"/>
                <filter string="Con pago contable" name="with_payment" domain="[('payment_id', '!=', False)]"/>
                <filter string="Sin pago contable" name="without_payment" domain="[('payment_id', '=', False)]"/>
                <filter string="Parciales" name="partials" domain="[('is_partial', '=', True)]"/>
                <filter string="Validados" name="validated" domain="[('state', '=', 'validated')]"/>
                <filter string="Rechazados" name="rejected" domain="[('state', '=', 'rejected')]"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Estado" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Asociacion" name="group_matching_status" context="{'group_by': 'matching_status'}"/>
                    <filter string="Estado del pago" name="group_payment_state" context="{'group_by': 'payment_state'}"/>
                    <filter string="Estado de la factura" name="group_invoice_payment_state" context="{'group_by': 'invoice_payment_state'}"/>
                    <filter string="Diario" name="group_journal" context="{'group_by': 'journal_id'}"/>
                    <filter string="Vendedor" name="group_user" context="{'group_by': 'sale_user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_ddc_cobro_control" model="ir.actions.act_window">
        <field name="name">Control de Cobros</field>
        <field name="res_model">doorandoor.cobro.control</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="search_view_id" ref="view_ddc_cobro_control_search"/>
    </record>

    <record id="view_ddc_cobro_control_pivot" model="ir.ui.view">
        <field name="name">doorandoor.cobro.control.pivot</field>
        <field name="model">doorandoor.cobro.control</field>
        <field name="arch" type="xml">
            <pivot string="Reporte de pagos">
                <field name="journal_id" type="row"/>
                <field name="state" type="col"/>
                <field name="payment_state" type="col"/>
                <field name="amount_reported" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_ddc_cobro_control_graph" model="ir.ui.view">
        <field name="name">doorandoor.cobro.control.graph</field>
        <field name="model">doorandoor.cobro.control</field>
        <field name="arch" type="xml">
            <graph string="Pagos por diario" type="bar">
                <field name="journal_id"/>
                <field name="amount_reported" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_ddc_cobro_report" model="ir.actions.act_window">
        <field name="name">Reporte de pagos</field>
        <field name="res_model">doorandoor.cobro.control</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="search_view_id" ref="view_ddc_cobro_control_search"/>
        <field name="context">{'search_default_group_journal': 1}</field>
    </record>

    <record id="action_ddc_account_payments" model="ir.actions.act_window">
        <field name="name">Pagos</field>
        <field name="res_model">account.payment</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('partner_type', '=', 'customer')]</field>
        <field name="context">{'default_partner_type': 'customer', 'search_default_inbound_filter': 1}</field>
    </record>
</odoo>
