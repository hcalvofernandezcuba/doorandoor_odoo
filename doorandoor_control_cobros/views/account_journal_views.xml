<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_journal_form_ddc" model="ir.ui.view">
        <field name="name">account.journal.form.ddc</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="before">
                <group string="Control de cobros">
                    <field name="ddc_payment_flow"/>
                    <field name="ddc_requires_payment_control" readonly="ddc_payment_flow == 'authorized_credit'"/>
                    <field name="ddc_credit_parent_account_id"
                           invisible="ddc_payment_flow != 'authorized_credit'"
                           required="ddc_payment_flow == 'authorized_credit'"
                           options="{'no_create': True, 'no_create_edit': True}"/>
                    <div class="alert alert-info" role="status"
                         invisible="ddc_payment_flow != 'authorized_credit'">
                        Este diario aplica credito autorizado por gerencia. Cada cliente utiliza
                        una subcuenta propia de la cuenta madre configurada arriba. Enviar dinero
                        y Recibir dinero manualmente están bloqueados; se usa solo desde facturas.
                    </div>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
