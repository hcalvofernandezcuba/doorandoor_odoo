<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_journal_form_ddc" model="ir.ui.view">
        <field name="name">account.journal.form.ddc</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="before">
                <group string="Control de cobros">
                    <field name="ddc_payment_flow"/>
                    <field name="ddc_requires_payment_control"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
