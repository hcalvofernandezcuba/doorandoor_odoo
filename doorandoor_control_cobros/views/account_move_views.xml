<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_ddc" model="ir.ui.view">
        <field name="name">account.move.form.ddc</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button
                    name="action_view_ddc_controls"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-money"
                    invisible="move_type != 'out_invoice'">
                    <field name="ddc_control_count" string="Controles de cobro" widget="statinfo"/>
                </button>
            </xpath>
            <xpath expr="//sheet//group" position="inside">
                <group string="Control de cobros" invisible="move_type != 'out_invoice'">
                    <field name="ddc_collection_state" readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>

