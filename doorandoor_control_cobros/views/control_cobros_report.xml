<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="report_ddc_cobro_control_document">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="web.external_layout">
                        <div class="page">
                            <h2>Control de Cobro</h2>
                            <div class="row mt-3 mb-3">
                                <div class="col-6">
                                    <strong>Control:</strong> <span t-field="o.name"/><br/>
                                    <strong>Factura:</strong> <span t-field="o.move_id.name"/><br/>
                                    <strong>Cliente:</strong> <span t-field="o.partner_id"/><br/>
                                    <strong>Fecha reportada:</strong> <span t-field="o.payment_date"/>
                                </div>
                                <div class="col-6 text-end">
                                    <strong>Diario:</strong> <span t-field="o.journal_id"/><br/>
                                    <strong>Estado del control:</strong> <span t-field="o.state"/><br/>
                                    <strong>Estado del pago:</strong> <span t-field="o.payment_state"/><br/>
                                    <strong>Estado de factura:</strong> <span t-field="o.invoice_payment_state"/>
                                </div>
                            </div>

                            <div class="row mb-4 align-items-start">
                                <div class="col-8">
                                    <div>
                                        <strong>Codigo de control</strong>
                                    </div>
                                    <div class="mt-2">
                                        <img t-att-src="o._ddsn_get_barcode_img_src()" alt="Cobro Barcode" style="max-width: 320px; max-height: 90px;"/>
                                    </div>
                                </div>
                                <div class="col-4 text-end">
                                    <div>
                                        <strong>Escanear para abrir</strong>
                                    </div>
                                    <div class="mt-2">
                                        <img t-att-src="o._ddsn_get_document_qr_img_src()" alt="Cobro QR" style="width: 110px; height: 110px;"/>
                                    </div>
                                </div>
                            </div>

                            <table class="table table-sm o_main_table">
                                <tbody>
                                    <tr>
                                        <td><strong>Monto reportado</strong></td>
                                        <td class="text-end"><span t-field="o.amount_reported"/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Referencia de pago</strong></td>
                                        <td><span t-field="o.payment_reference"/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Reportado por</strong></td>
                                        <td><span t-field="o.sale_user_id"/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Validado por</strong></td>
                                        <td><span t-field="o.accountant_user_id"/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Fecha de revision</strong></td>
                                        <td><span t-field="o.review_date"/></td>
                                    </tr>
                                </tbody>
                            </table>

                            <div class="row mt-4">
                                <div class="col-12">
                                    <strong>Notas</strong>
                                    <div t-field="o.notes"/>
                                </div>
                            </div>

                            <div class="row mt-3" t-if="o.state == 'rejected' or o.rejection_reason">
                                <div class="col-12">
                                    <strong>Motivo de rechazo</strong>
                                    <div t-field="o.rejection_reason"/>
                                </div>
                            </div>

                            <div class="row mt-5 pt-4">
                                <div class="col-6">
                                    <div style="margin-top: 30px;">
                                        <strong>Recibido y reportado por</strong>
                                    </div>
                                    <div style="border-top: 1px solid #000; margin-top: 45px; padding-top: 6px; min-height: 22px;">
                                        <span t-esc="o.sale_user_id.name or ''"/>
                                    </div>
                                </div>
                                <div class="col-6 text-end">
                                    <div style="margin-top: 30px;">
                                        <strong>Revisado por contabilidad</strong>
                                    </div>
                                    <div style="border-top: 1px solid #000; margin-top: 45px; padding-top: 6px; min-height: 22px;">
                                        <span t-esc="o.accountant_user_id.name or ''"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </t>
            </t>
        </template>

        <record id="action_report_ddc_cobro_control" model="ir.actions.report">
            <field name="name">Control de Cobro</field>
            <field name="model">doorandoor.cobro.control</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">doorandoor_control_cobros.report_ddc_cobro_control_document</field>
            <field name="report_file">doorandoor_control_cobros.report_ddc_cobro_control_document</field>
            <field name="binding_model_id" ref="model_doorandoor_cobro_control"/>
            <field name="binding_type">report</field>
            <field name="print_report_name">'Control de Cobro - %s' % (object.name)</field>
        </record>
    </data>
</odoo>
