<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_access_matrix_list" model="ir.ui.view">
        <field name="name">res.users.access.matrix.list</field>
        <field name="model">res.users</field>
        <field name="arch" type="xml">
            <list string="Matriz de permisos" create="0" edit="0" delete="0" multi_edit="0">
                <field name="name"/>
                <field name="login"/>
                <field name="active" widget="boolean_toggle"/>
                <field name="company_id"/>
                <field name="dd_uam_company_summary" optional="hide"/>
                <field name="dd_uam_is_system_admin" widget="boolean_toggle"/>
                <field name="dd_uam_group_count"/>
                <field name="dd_uam_group_ids" widget="many2many_tags"/>
                <field name="dd_uam_group_summary" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_users_form_access_matrix" model="ir.ui.view">
        <field name="name">res.users.form.access.matrix</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Resumen de permisos" groups="base.group_system">
                    <group>
                        <group>
                            <field name="dd_uam_is_system_admin" readonly="1"/>
                            <field name="dd_uam_group_count" readonly="1"/>
                            <field name="dd_uam_company_summary" readonly="1"/>
                        </group>
                        <group>
                            <field name="dd_uam_group_ids" widget="many2many_tags" readonly="1"/>
                        </group>
                    </group>
                    <group string="Detalle por área">
                        <field name="dd_uam_group_summary" nolabel="1" readonly="1"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="action_users_access_matrix" model="ir.actions.act_window">
        <field name="name">Matriz de permisos</field>
        <field name="res_model">res.users</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_users_access_matrix_list"/>
        <field name="domain">[('share', '=', False)]</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="groups_id" eval="[(4, ref('base.group_system'))]"/>
    </record>

    <menuitem id="menu_users_access_matrix"
              name="Matriz de permisos"
              parent="base.menu_users"
              action="action_users_access_matrix"
              sequence="95"
              groups="base.group_system"/>
</odoo>
