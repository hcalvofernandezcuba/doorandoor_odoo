<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_server_monitor" model="ir.actions.client">
        <field name="name">Monitoring</field>
        <field name="tag">server_monitor.dashboard</field>
    </record>

    <record id="action_server_monitor_postgres" model="ir.actions.client">
        <field name="name">PostgreSQL Monitor</field>
        <field name="tag">server_monitor.postgres</field>
    </record>

    <record id="action_server_monitor_odoo" model="ir.actions.client">
        <field name="name">Odoo Dashboard</field>
        <field name="tag">server_monitor.odoo</field>
    </record>

    <record id="action_server_monitor_odoo_log" model="ir.actions.client">
        <field name="name">Server Log</field>
        <field name="tag">server_monitor.odoo_log</field>
    </record>

    <record id="action_server_monitor_wireguard" model="ir.actions.client">
        <field name="name">WireGuard Monitor</field>
        <field name="tag">server_monitor.wireguard</field>
    </record>

    <record id="action_server_monitor_wireguard_peer" model="ir.actions.act_window">
        <field name="name">WireGuard Peers</field>
        <field name="res_model">server.monitor.wireguard.peer</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_server_monitor_root"
        name="Monitoring"
        sequence="10"
        groups="server_monitor.group_server_monitor_user"
    />

    <menuitem
        id="menu_server_monitor_dashboard"
        name="Server"
        parent="menu_server_monitor_root"
        action="action_server_monitor"
        sequence="1"
        groups="server_monitor.group_server_monitor_user"
    />

    <menuitem
        id="menu_server_monitor_postgres"
        name="PostgreSQL"
        parent="menu_server_monitor_root"
        action="action_server_monitor_postgres"
        sequence="2"
        groups="server_monitor.group_server_monitor_user"
    />

    <menuitem
        id="menu_server_monitor_odoo"
        name="Odoo"
        parent="menu_server_monitor_root"
        sequence="3"
        groups="server_monitor.group_server_monitor_user"
    />

    <menuitem
        id="menu_server_monitor_wireguard"
        name="WireGuard"
        parent="menu_server_monitor_root"
        action="action_server_monitor_wireguard"
        sequence="4"
        groups="server_monitor.group_server_monitor_user"
    />

    <menuitem
        id="menu_server_monitor_wireguard_peer"
        name="Peer Names"
        parent="menu_server_monitor_root"
        action="action_server_monitor_wireguard_peer"
        sequence="5"
        groups="base.group_system"
    />

    <menuitem
        id="menu_server_monitor_odoo_dashboard"
        name="Dashboard"
        parent="menu_server_monitor_odoo"
        action="action_server_monitor_odoo"
        sequence="1"
        groups="server_monitor.group_server_monitor_user"
    />

    <menuitem
        id="menu_server_monitor_odoo_log"
        name="Server Log"
        parent="menu_server_monitor_odoo"
        action="action_server_monitor_odoo_log"
        sequence="2"
        groups="server_monitor.group_server_monitor_user"
    />

    <record id="view_server_monitor_wireguard_peer_list" model="ir.ui.view">
        <field name="name">server.monitor.wireguard.peer.list</field>
        <field name="model">server.monitor.wireguard.peer</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="allowed_ip"/>
                <field name="public_key"/>
                <field name="note"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_server_monitor_wireguard_peer_form" model="ir.ui.view">
        <field name="name">server.monitor.wireguard.peer.form</field>
        <field name="model">server.monitor.wireguard.peer</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="allowed_ip"/>
                            <field name="public_key"/>
                        </group>
                        <group>
                            <field name="active"/>
                            <field name="note"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
