<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ddmh_document_scan_form" model="ir.ui.view">
        <field name="name">doorandoor.hanger.document.scan.form</field>
        <field name="model">doorandoor.hanger.document.scan</field>
        <field name="arch" type="xml">
            <form string="Escanear operación">
                <sheet>
                    <div class="text-center mb-4">
                        <i class="fa fa-camera fa-4x text-primary" title="La cámara se activa desde el botón inferior"/>
                        <h2 class="mt-3">Escanee el documento</h2>
                        <p class="text-muted">Active la cámara, use el lector del hanger o escriba el código impreso.</p>
                    </div>
                    <group>
                        <field name="scan_code"
                               widget="ddmh_camera_barcode"
                               placeholder="Ejemplo: DTP/OUT/00118"
                               options="{'always_reload': True}"/>
                    </group>
                    <div class="d-grid gap-2 mt-4">
                        <button name="action_open_operation" type="object"
                                string="Abrir operación" class="btn-primary btn-lg"
                                icon="fa-external-link"/>
                    </div>
                </sheet>
                <footer>
                    <button string="Cerrar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_ddmh_document_scan" model="ir.actions.act_window">
        <field name="name">Escanear operación</field>
        <field name="res_model">doorandoor.hanger.document.scan</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_ddmh_document_scan_form"/>
        <field name="target">current</field>
    </record>
</odoo>
