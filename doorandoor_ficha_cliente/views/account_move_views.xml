<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_account_move_form_inherit_ddfc_builder" model="ir.ui.view">
            <field name="name">account.move.form.ddfc.builder</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="priority">120</field>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='partner_id']" position="after">
                    <field name="ddfc_builder_id" options="{'no_create': True, 'no_create_edit': True}"/>
                    <field name="ddfc_builder_discount_percent"/>
                    <field name="ddfc_pricing_source"/>
                </xpath>
            </field>
        </record>

        <record id="view_account_move_tree_inherit_ddfc_builder" model="ir.ui.view">
            <field name="name">account.move.tree.ddfc.builder</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_out_invoice_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='invoice_date']" position="after">
                    <field name="ddfc_builder_id" optional="hide"/>
                    <field name="ddfc_pricing_source" optional="hide"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
