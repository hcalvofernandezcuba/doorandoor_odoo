<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Anclaje principal en la vista de factura/prefactura de sales_new -->
        <record id="view_out_invoice_form_inherit_ddfc_builder_on_ddsn" model="ir.ui.view">
            <field name="name">account.move.form.out.invoice.ddfc.builder.ddsn.anchor</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="doorandoor_sales_new.view_move_form_inherit_doorandoor_sales_new"/>
            <field name="priority">130</field>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='partner_shipping_id']" position="after">
                    <button name="ddfc_action_open_builder_wizard"
                            type="object"
                            string="Crear Constructor"
                            class="oe_link"
                            invisible="move_type not in ('out_invoice', 'out_refund')"/>
                    <field
                        name="ddfc_builder_id"
                        invisible="not ddfc_builder_id or move_type not in ('out_invoice', 'out_refund')"
                        readonly="1"/>
                    <field
                        name="ddfc_pricing_source"
                        invisible="1"/>
                </xpath>
            </field>
        </record>

        <!-- Fallback para formularios de account.move fuera del flujo de sales_new -->
        <record id="view_account_move_form_inherit_ddfc_builder_fallback" model="ir.ui.view">
            <field name="name">account.move.form.ddfc.builder.fallback</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="priority">80</field>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='partner_id']" position="after">
                    <button name="ddfc_action_open_builder_wizard"
                            type="object"
                            string="Crear Constructor"
                            class="oe_link"
                            invisible="move_type in ('out_invoice', 'out_refund')"/>
                    <field
                        name="ddfc_builder_id"
                        invisible="not ddfc_builder_id or move_type in ('out_invoice', 'out_refund')"
                        readonly="1"/>
                </xpath>
            </field>
        </record>

        <!-- Vista de árbol para facturas de cliente -->
        <record id="view_account_move_tree_inherit_ddfc_builder" model="ir.ui.view">
            <field name="name">account.move.tree.ddfc.builder</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_out_invoice_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='invoice_date']" position="after">
                    <field name="ddfc_builder_id" optional="hide"/>
                    <field name="ddfc_pricing_source" optional="hide"/>
                </xpath>
            </field>
        </record>

        <!-- Vista de árbol general para account.move -->
        <record id="view_account_move_tree_general_inherit_ddfc_builder" model="ir.ui.view">
            <field name="name">account.move.tree.general.ddfc.builder</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='date']" position="after">
                    <field name="ddfc_builder_id" optional="hide"/>
                    <field name="ddfc_pricing_source" optional="hide"/>
                </xpath>
            </field>
        </record>

    </data>
</odoo>