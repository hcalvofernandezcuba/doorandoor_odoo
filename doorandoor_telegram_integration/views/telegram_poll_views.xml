<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ddtg_poll_search" model="ir.ui.view">
        <field name="name">doorandoor.telegram.poll.search</field>
        <field name="model">doorandoor.telegram.poll</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/><field name="bot_id"/><field name="state"/>
                <filter name="open" string="En votación" domain="[('state', '=', 'open')]"/>
                <filter name="approved" string="Aprobadas" domain="[('state', '=', 'approved')]"/>
                <group expand="0" string="Agrupar"><filter string="Bot" name="bot_id" context="{'group_by': 'bot_id'}"/><filter string="Estado" name="state_group" context="{'group_by': 'state'}"/></group>
            </search>
        </field>
    </record>
    <record id="view_ddtg_poll_list" model="ir.ui.view">
        <field name="name">doorandoor.telegram.poll.list</field>
        <field name="model">doorandoor.telegram.poll</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'open'" decoration-success="state == 'approved'" decoration-muted="state in ('closed', 'cancelled')">
                <field name="name"/><field name="bot_id"/><field name="deadline"/>
                <field name="vote_count"/><field name="voter_count"/><field name="participation" widget="percentage"/>
                <field name="winning_option_id"/><field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="view_ddtg_poll_form" model="ir.ui.view">
        <field name="name">doorandoor.telegram.poll.form</field>
        <field name="model">doorandoor.telegram.poll</field>
        <field name="arch" type="xml">
            <form string="Aprobación por Telegram">
                <header>
                    <button name="action_open_and_send" string="Enviar a Telegram" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_close" string="Cerrar y aprobar resultado" type="object" class="btn-primary" invisible="state != 'open'"/>
                    <button name="action_cancel" string="Cancelar" type="object" invisible="state not in ('draft', 'open')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,open,approved,closed,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title"><label for="name"/><h1><field name="name" readonly="state != 'draft'"/></h1></div>
                    <group>
                        <group><field name="bot_id" readonly="state != 'draft'"/><field name="deadline" readonly="state != 'draft'"/><field name="voter_ids" widget="many2many_tags" readonly="state != 'draft'"/></group>
                        <group string="Resultado"><field name="vote_count"/><field name="voter_count"/><field name="participation" widget="percentage"/><field name="winning_option_id"/><field name="sent_at"/><field name="closed_at"/></group>
                    </group>
                    <field name="description" readonly="state != 'draft'" placeholder="Explique qué debe aprobar el equipo..."/>
                    <notebook>
                        <page string="Variantes">
                            <field name="option_ids" readonly="state != 'draft'">
                                <list editable="bottom"><field name="sequence" widget="handle"/><field name="image" widget="image"/><field name="image_filename" column_invisible="True"/><field name="name"/><field name="description"/><field name="vote_count" readonly="1"/></list>
                            </field>
                        </page>
                        <page string="Votos">
                            <field name="vote_ids" readonly="1"><list><field name="voted_at"/><field name="user_id"/><field name="option_id"/><field name="telegram_user_id" optional="hide"/></list></field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_ddtg_poll" model="ir.actions.act_window">
        <field name="name">Aprobaciones</field><field name="res_model">doorandoor.telegram.poll</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_ddtg_poll_search"/>
    </record>
</odoo>
