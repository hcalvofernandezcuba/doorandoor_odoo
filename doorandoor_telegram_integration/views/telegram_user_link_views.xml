<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ddtg_user_link_list" model="ir.ui.view">
        <field name="name">doorandoor.telegram.user.link.list</field><field name="model">doorandoor.telegram.user.link</field>
        <field name="arch" type="xml"><list decoration-success="state == 'active'" decoration-muted="state == 'revoked'">
            <field name="user_id"/><field name="bot_id"/><field name="telegram_username"/><field name="telegram_user_id" optional="hide"/>
            <field name="verified_at"/><field name="state" widget="badge"/>
        </list></field>
    </record>
    <record id="view_ddtg_user_link_form" model="ir.ui.view">
        <field name="name">doorandoor.telegram.user.link.form</field><field name="model">doorandoor.telegram.user.link</field>
        <field name="arch" type="xml"><form string="Vínculo Telegram">
            <header><button name="action_revoke" string="Desvincular" type="object" invisible="state != 'active'"/><field name="state" widget="statusbar"/></header>
            <sheet><group><group><field name="user_id" readonly="1"/><field name="bot_id" readonly="1"/><field name="verified_at" readonly="1"/></group>
            <group><field name="telegram_username" readonly="1"/><field name="telegram_first_name" readonly="1"/><field name="telegram_last_name" readonly="1"/><field name="telegram_user_id" readonly="1"/><field name="telegram_chat_id" readonly="1"/></group></group>
            <notebook>
                <page string="Conversación">
                    <group groups="doorandoor_telegram_integration.group_ddtg_manager">
                        <field name="outgoing_message" placeholder="Escriba un mensaje para este usuario de Telegram..." nolabel="1"/>
                        <div class="oe_button_box">
                            <button name="action_send_chat_message" string="Enviar por Telegram" type="object" class="btn-primary" invisible="not outgoing_message or state != 'active'"/>
                            <button name="action_receive_chat_messages" string="Recibir respuestas ahora" type="object" class="btn-secondary" invisible="state != 'active'"/>
                        </div>
                    </group>
                    <field name="telegram_message_ids" readonly="1" nolabel="1">
                        <list decoration-info="direction == 'incoming'" decoration-success="direction == 'outgoing'">
                            <field name="create_date"/><field name="direction" widget="badge"/><field name="text"/><field name="telegram_message_id" optional="hide"/>
                        </list>
                    </field>
                </page>
                <page string="Preferencias">
                    <group><field name="notify_general"/><field name="notify_manufacturing"/><field name="notify_warehouse"/><field name="notify_tasks"/></group>
                </page>
            </notebook>
            </sheet><chatter/></form></field>
    </record>
    <record id="action_ddtg_user_link" model="ir.actions.act_window">
        <field name="name">Mi cuenta Telegram</field><field name="res_model">doorandoor.telegram.user.link</field><field name="view_mode">list,form</field><field name="domain">[('user_id', '=', uid)]</field>
    </record>
    <record id="action_ddtg_user_link_all" model="ir.actions.act_window">
        <field name="name">Usuarios vinculados</field><field name="res_model">doorandoor.telegram.user.link</field><field name="view_mode">list,form</field>
    </record>
    <record id="view_users_form_inherit_ddtg" model="ir.ui.view">
        <field name="name">res.users.form.doorandoor.telegram</field><field name="model">res.users</field><field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml"><xpath expr="//div[@name='button_box']" position="inside">
            <button name="action_open_doorandoor_telegram_links" type="object" class="oe_stat_button" icon="fa-telegram"><field name="doorandoor_telegram_link_count" widget="statinfo" string="Telegram"/></button>
        </xpath></field>
    </record>
</odoo>
