<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_ddtg_process_notification_queue" model="ir.cron">
        <field name="name">DoorAndDoor Telegram: enviar notificaciones</field>
        <field name="model_id" ref="model_doorandoor_telegram_notification"/>
        <field name="state">code</field>
        <field name="code">model._cron_process_queue()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
    <record id="ir_cron_ddtg_expire_activations" model="ir.cron">
        <field name="name">DoorAndDoor Telegram: expirar enlaces</field>
        <field name="model_id" ref="model_doorandoor_telegram_activation"/>
        <field name="state">code</field>
        <field name="code">model._cron_expire_activations()</field>
        <field name="interval_number">10</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
    <record id="ir_cron_ddtg_poll_updates" model="ir.cron">
        <field name="name">DoorAndDoor Telegram: recibir eventos locales</field>
        <field name="model_id" ref="model_doorandoor_telegram_bot"/>
        <field name="state">code</field>
        <field name="code">model._cron_poll_updates()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
