<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="group_ddtg_manager" model="res.groups">
            <field name="name">DoorAndDoor Telegram / Administrador</field>
            <field name="category_id" ref="base.module_category_hidden"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_admin'))]"/>
        </record>
        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('doorandoor_telegram_integration.group_ddtg_manager'))]"/>
        </record>

        <record id="rule_ddtg_bot_company" model="ir.rule">
            <field name="name">Bots Telegram por compañía</field>
            <field name="model_id" ref="model_doorandoor_telegram_bot"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>
        <record id="rule_ddtg_link_own" model="ir.rule">
            <field name="name">Cada usuario ve su vínculo Telegram</field>
            <field name="model_id" ref="model_doorandoor_telegram_user_link"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>
        <record id="rule_ddtg_link_manager" model="ir.rule">
            <field name="name">Administradores ven vínculos de la compañía</field>
            <field name="model_id" ref="model_doorandoor_telegram_user_link"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('doorandoor_telegram_integration.group_ddtg_manager'))]"/>
        </record>
        <record id="rule_ddtg_notification_own" model="ir.rule">
            <field name="name">Cada usuario ve sus notificaciones Telegram</field>
            <field name="model_id" ref="model_doorandoor_telegram_notification"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>
        <record id="rule_ddtg_notification_manager" model="ir.rule">
            <field name="name">Administradores ven notificaciones de la compañía</field>
            <field name="model_id" ref="model_doorandoor_telegram_notification"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('doorandoor_telegram_integration.group_ddtg_manager'))]"/>
        </record>
        <record id="rule_ddtg_message_own" model="ir.rule">
            <field name="name">Cada usuario ve sus mensajes Telegram</field>
            <field name="model_id" ref="model_doorandoor_telegram_message"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>
        <record id="rule_ddtg_message_manager" model="ir.rule">
            <field name="name">Administradores ven mensajes de la compañía</field>
            <field name="model_id" ref="model_doorandoor_telegram_message"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('doorandoor_telegram_integration.group_ddtg_manager'))]"/>
        </record>
        <record id="rule_ddtg_poll_company" model="ir.rule">
            <field name="name">Encuestas Telegram por compañía</field>
            <field name="model_id" ref="model_doorandoor_telegram_poll"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('doorandoor_telegram_integration.group_ddtg_manager'))]"/>
        </record>
    </data>
</odoo>
