<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ddtb_tax_exempt_invoice_list" model="ir.ui.view">
        <field name="name">account.move.tax.exempt.audit.list</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <list string="Ventas exentas de impuestos" create="0" delete="0" default_order="invoice_date desc, name desc">
                <field name="invoice_date" string="Fecha"/>
                <field name="sale_order_id" string="PO"/>
                <field name="name" string="Factura"/>
                <field name="partner_id" string="Cliente"/>
                <field name="ddts_tax_exemption_number" string="Registro de exención"/>
                <field name="invoice_user_id" string="Vendedor" optional="show"/>
                <field name="amount_untaxed" string="Venta sin impuesto" sum="Base exenta"/>
                <field name="amount_tax" string="Impuestos" sum="Impuestos"/>
                <field name="amount_total" string="Total" sum="Total vendido"/>
                <field name="ddc_total_validated" string="Pago validado" sum="Total pagado" optional="show"/>
                <field name="payment_state" string="Estado del pago" widget="badge"/>
                <field name="state" string="Estado fiscal" widget="badge"/>
                <field name="write_date" string="Último cambio" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_ddtb_tax_exempt_invoice_search" model="ir.ui.view">
        <field name="name">account.move.tax.exempt.audit.search</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <search string="Ventas exentas de impuestos">
                <field name="name" string="Factura"/>
                <field name="sale_order_id" string="PO"/>
                <field name="partner_id"/>
                <field name="ddts_tax_exemption_number"/>
                <field name="invoice_user_id"/>
                <filter name="invoice_date" string="Fecha" date="invoice_date"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_month" string="Mes" context="{'group_by': 'invoice_date:month'}"/>
                    <filter name="group_partner" string="Cliente" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_salesperson" string="Vendedor" context="{'group_by': 'invoice_user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_ddtb_tax_exempt_invoice_pivot" model="ir.ui.view">
        <field name="name">account.move.tax.exempt.audit.pivot</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <pivot string="Ventas exentas de impuestos">
                <field name="invoice_date" type="row" interval="month"/>
                <field name="partner_id" type="row"/>
                <field name="amount_untaxed" type="measure"/>
                <field name="amount_tax" type="measure"/>
                <field name="amount_total" type="measure"/>
                <field name="ddc_total_validated" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_ddtb_tax_exempt_sales" model="ir.actions.act_window">
        <field name="name">Ventas exentas de impuestos</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,pivot,graph,form</field>
        <field name="view_id" ref="view_ddtb_tax_exempt_invoice_list"/>
        <field name="search_view_id" ref="view_ddtb_tax_exempt_invoice_search"/>
        <field name="domain">[('move_type','=','out_invoice'),('state','=','posted'),('payment_state','=','paid'),('ddts_partner_tax_exempt','=',True)]</field>
        <field name="context">{'create': False, 'edit': False, 'delete': False}</field>
    </record>

    <menuitem id="menu_ddtb_tax_exempt_sales" name="Ventas exentas de impuestos"
              parent="sale.menu_sale_report" action="action_ddtb_tax_exempt_sales"
              sequence="45" groups="sales_team.group_sale_salesman,account.group_account_readonly"/>

    <record id="action_report_ddtb_tax_exempt_sales" model="ir.actions.report">
        <field name="name">Ventas exentas de impuestos</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">doorandoor_tableros.report_ddtb_tax_exempt_sales</field>
        <field name="report_file">doorandoor_tableros.report_ddtb_tax_exempt_sales</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Ventas exentas de impuestos'</field>
    </record>

    <template id="report_ddtb_tax_exempt_sales">
        <t t-call="web.html_container"><t t-call="web.external_layout">
            <div class="page" style="font-size:9px">
                <h3>Ventas exentas de impuestos</h3>
                <table class="table table-sm">
                    <thead><tr><th>Fecha</th><th>PO</th><th>Factura</th><th>Cliente</th><th>Registro</th><th class="text-end">Base</th><th class="text-end">Impuesto</th><th class="text-end">Total</th><th class="text-end">Pagado</th></tr></thead>
                    <tbody><tr t-foreach="docs" t-as="o">
                        <td><span t-field="o.invoice_date"/></td><td><span t-field="o.sale_order_id"/></td><td><span t-field="o.name"/></td><td><span t-field="o.partner_id"/></td><td><span t-field="o.ddts_tax_exemption_number"/></td>
                        <td class="text-end"><span t-field="o.amount_untaxed" t-options='{"widget":"monetary","display_currency":o.currency_id}'/></td>
                        <td class="text-end"><span t-field="o.amount_tax" t-options='{"widget":"monetary","display_currency":o.currency_id}'/></td>
                        <td class="text-end"><span t-field="o.amount_total" t-options='{"widget":"monetary","display_currency":o.currency_id}'/></td>
                        <td class="text-end"><span t-field="o.ddc_total_validated" t-options='{"widget":"monetary","display_currency":o.currency_id}'/></td>
                    </tr></tbody>
                    <tfoot><tr class="fw-bold"><td colspan="5">Totales</td><td class="text-end"><span t-esc="sum(docs.mapped('amount_untaxed'))" t-options='{"widget":"monetary","display_currency":docs[:1].currency_id}'/></td><td class="text-end"><span t-esc="sum(docs.mapped('amount_tax'))" t-options='{"widget":"monetary","display_currency":docs[:1].currency_id}'/></td><td class="text-end"><span t-esc="sum(docs.mapped('amount_total'))" t-options='{"widget":"monetary","display_currency":docs[:1].currency_id}'/></td><td class="text-end"><span t-esc="sum(docs.mapped('ddc_total_validated'))" t-options='{"widget":"monetary","display_currency":docs[:1].currency_id}'/></td></tr></tfoot>
                </table>
            </div>
        </t></t>
    </template>
</odoo>
