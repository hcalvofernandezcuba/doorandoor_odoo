<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="dashboard_payments_native" model="spreadsheet.dashboard">
        <field name="name">Pagos</field>
        <field name="spreadsheet_binary_data" type="base64" file="doorandoor_tableros/data/files/payments_dashboard.json"/>
        <field name="main_data_model_ids" eval="[
            (4, ref('doorandoor_control_cobros.model_doorandoor_cobro_control')),
            (4, ref('account.model_account_payment')),
            (4, ref('account.model_account_move'))
        ]"/>
        <field name="sample_dashboard_file_path">doorandoor_tableros/data/files/payments_sample_dashboard.json</field>
        <field name="dashboard_group_id" ref="spreadsheet_dashboard.spreadsheet_dashboard_group_finance"/>
        <field name="group_ids" eval="[Command.link(ref('account.group_account_readonly')), Command.link(ref('account.group_account_invoice'))]"/>
        <field name="sequence">30</field>
        <field name="is_published">True</field>
    </record>

    <record id="dashboard_builders_sales_native" model="spreadsheet.dashboard">
        <field name="name">Constructores</field>
        <field name="spreadsheet_binary_data" type="base64" file="doorandoor_tableros/data/files/builders_sales_dashboard.json"/>
        <field name="main_data_model_ids" eval="[
            (4, ref('doorandoor_ficha_cliente.model_ddfc_builder_profile')),
            (4, ref('base.model_res_partner')),
            (4, ref('sale.model_sale_order'))
        ]"/>
        <field name="sample_dashboard_file_path">doorandoor_tableros/data/files/builders_sales_sample_dashboard.json</field>
        <field name="dashboard_group_id" ref="spreadsheet_dashboard.spreadsheet_dashboard_group_sales"/>
        <field name="group_ids" eval="[Command.link(ref('sales_team.group_sale_salesman')), Command.link(ref('sales_team.group_sale_manager'))]"/>
        <field name="sequence">30</field>
        <field name="is_published">True</field>
    </record>

    <record id="dashboard_deliveries_sales_native" model="spreadsheet.dashboard">
        <field name="name">Entregas</field>
        <field name="spreadsheet_binary_data" type="base64" file="doorandoor_tableros/data/files/deliveries_sales_dashboard.json"/>
        <field name="main_data_model_ids" eval="[
            (4, ref('doorandoor_process_control.model_doorandoor_pending_delivery')),
            (4, ref('stock.model_stock_warehouse')),
            (4, ref('product.model_product_product')),
            (4, ref('base.model_res_partner'))
        ]"/>
        <field name="sample_dashboard_file_path">doorandoor_tableros/data/files/deliveries_sales_sample_dashboard.json</field>
        <field name="dashboard_group_id" ref="spreadsheet_dashboard.spreadsheet_dashboard_group_sales"/>
        <field name="group_ids" eval="[Command.link(ref('stock.group_stock_user')), Command.link(ref('sales_team.group_sale_manager'))]"/>
        <field name="sequence">40</field>
        <field name="is_published">True</field>
    </record>

    <record id="dashboard_reservations_sales_native" model="spreadsheet.dashboard">
        <field name="name">Reservas y Prereservas</field>
        <field name="spreadsheet_binary_data" type="base64" file="doorandoor_tableros/data/files/reservations_sales_dashboard.json"/>
        <field name="main_data_model_ids" eval="[(4, ref('doorandoor_process_control.model_doorandoor_sales_reservation_analysis'))]"/>
        <field name="sample_dashboard_file_path">doorandoor_tableros/data/files/reservations_sales_sample_dashboard.json</field>
        <field name="dashboard_group_id" ref="spreadsheet_dashboard.spreadsheet_dashboard_group_sales"/>
        <field name="group_ids" eval="[Command.link(ref('stock.group_stock_user')), Command.link(ref('sales_team.group_sale_manager'))]"/>
        <field name="sequence">50</field>
        <field name="is_published">True</field>
    </record>
</odoo>
