<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_showroom_list" model="ir.ui.view">
        <field name="name">doorandoor.website.showroom.list</field>
        <field name="model">doorandoor.website.showroom</field>
        <field name="arch" type="xml">
            <list multi_edit="1">
                <field name="sequence" widget="handle"/>
                <field name="image_1920" widget="image" options="{'size': [48, 48]}"/>
                <field name="name"/>
                <field name="city"/>
                <field name="phone"/>
                <field name="has_video"/>
                <field name="website_published" widget="boolean_toggle"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_showroom_form" model="ir.ui.view">
        <field name="name">doorandoor.website.showroom.form</field>
        <field name="model">doorandoor.website.showroom</field>
        <field name="arch" type="xml">
            <form>
                <header><field name="website_published" widget="website_redirect_button"/></header>
                <sheet>
                    <widget name="web_ribbon" text="Archivada" bg_color="text-bg-danger" invisible="active"/>
                    <field name="image_1920" widget="image" class="oe_avatar"/>
                    <div class="oe_title"><label for="name"/><h1><field name="name" placeholder="Ej.: Tampa Showroom"/></h1></div>
                    <group>
                        <group>
                            <field name="street"/>
                            <field name="city"/>
                            <field name="state_name"/>
                            <field name="zip"/>
                            <field name="map_url" widget="url"/>
                        </group>
                        <group>
                            <field name="phone" widget="phone"/>
                            <field name="email" widget="email"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Presentación"><field name="description" widget="html"/></page>
                        <page string="Video">
                            <group>
                                <field name="video_source"/>
                                <field name="video_url" widget="url" invisible="video_source != 'external'" placeholder="https://youtu.be/... o https://vimeo.com/..."/>
                                <field name="video_embed_url" readonly="1" invisible="video_source != 'external'"/>
                                <field name="video_file" filename="video_filename" invisible="video_source != 'upload'"/>
                                <field name="video_filename" invisible="video_source != 'upload'"/>
                            </group>
                            <div class="alert alert-info" role="alert">
                                Use YouTube/Vimeo para videos largos. Para un archivo propio, cargue MP4 comprimido y breve.
                            </div>
                        </page>
                        <page string="SEO"><group><field name="website_meta_title"/><field name="website_meta_description"/><field name="website_meta_keywords"/></group></page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_showrooms" model="ir.actions.act_window">
        <field name="name">Oficinas y Showrooms</field>
        <field name="res_model">doorandoor.website.showroom</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_showrooms" name="Oficinas y Showrooms" parent="website.menu_content" action="action_showrooms" sequence="46" groups="website.group_website_designer"/>
</odoo>
