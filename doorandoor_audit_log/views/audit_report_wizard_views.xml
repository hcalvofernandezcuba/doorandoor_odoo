<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_doorandoor_audit_report_wizard_form" model="ir.ui.view">
        <field name="name">doorandoor.audit.report.wizard.form</field>
        <field name="model">doorandoor.audit.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Imprimir reporte de auditoría">
                <group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="user_id" options="{'no_create': True}"/>
                    </group>
                    <group>
                        <field name="model_name" placeholder="Ej.: product.template"/>
                        <field name="operation"/>
                        <field name="price_changes_only"/>
                    </group>
                </group>
                <footer>
                    <button name="action_print_report" string="Imprimir PDF" type="object" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_doorandoor_audit_report_wizard" model="ir.actions.act_window">
        <field name="name">Imprimir reporte</field>
        <field name="res_model">doorandoor.audit.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_doorandoor_audit_report_wizard_form"/>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_doorandoor_audit_report"
              name="Imprimir reporte"
              parent="menu_doorandoor_audit_root"
              action="action_doorandoor_audit_report_wizard"
              sequence="20"
              groups="base.group_system"/>
</odoo>
