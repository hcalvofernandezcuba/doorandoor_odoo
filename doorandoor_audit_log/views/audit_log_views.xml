<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_doorandoor_audit_log_list" model="ir.ui.view">
        <field name="name">doorandoor.audit.log.list</field>
        <field name="model">doorandoor.audit.log</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" default_order="event_date desc, id desc">
                <field name="event_date"/>
                <field name="user_id"/>
                <field name="operation"/>
                <field name="model_label"/>
                <field name="record_name"/>
                <field name="field_label"/>
                <field name="old_value" optional="hide"/>
                <field name="new_value" optional="show"/>
                <field name="source"/>
                <field name="remote_ip" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_doorandoor_audit_log_form" model="ir.ui.view">
        <field name="name">doorandoor.audit.log.form</field>
        <field name="model">doorandoor.audit.log</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="event_date"/>
                            <field name="user_id"/>
                            <field name="company_id"/>
                            <field name="operation"/>
                        </group>
                        <group>
                            <field name="model_name"/>
                            <field name="model_label"/>
                            <field name="record_id"/>
                            <field name="record_name"/>
                        </group>
                    </group>
                    <group string="Cambio">
                        <field name="field_name"/>
                        <field name="field_label"/>
                        <field name="old_value"/>
                        <field name="new_value"/>
                    </group>
                    <group string="Origen">
                        <field name="source"/>
                        <field name="remote_ip"/>
                        <field name="request_path"/>
                        <field name="session_sid"/>
                        <field name="context_note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_doorandoor_audit_log_search" model="ir.ui.view">
        <field name="name">doorandoor.audit.log.search</field>
        <field name="model">doorandoor.audit.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="record_name"/>
                <field name="user_id"/>
                <field name="model_name"/>
                <field name="field_name"/>
                <field name="operation"/>
                <field name="event_date"/>
                <filter name="price_changes" string="Precios y costos" domain="[('field_name', 'in', ['list_price', 'standard_price', 'ddpc_variant_extra_price', 'price_extra'])]"/>
                <filter name="permission_changes" string="Permisos y almacenes" domain="[('field_name', 'in', ['groups_id', 'users', 'ddpc_warehouse_ids'])]"/>
                <separator/>
                <filter name="group_user" string="Usuario" context="{'group_by': 'user_id'}"/>
                <filter name="group_model" string="Modelo" context="{'group_by': 'model_name'}"/>
                <filter name="group_operation" string="Operación" context="{'group_by': 'operation'}"/>
                <filter name="group_day" string="Día" context="{'group_by': 'event_date:day'}"/>
            </search>
        </field>
    </record>

    <record id="action_doorandoor_audit_log" model="ir.actions.act_window">
        <field name="name">Trazas de auditoría</field>
        <field name="res_model">doorandoor.audit.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_doorandoor_audit_log_search"/>
    </record>

    <menuitem id="menu_doorandoor_audit_root" name="Auditoría" sequence="95" groups="base.group_system"/>
    <menuitem id="menu_doorandoor_audit_log" name="Trazas generales" parent="menu_doorandoor_audit_root" action="action_doorandoor_audit_log" sequence="10" groups="base.group_system"/>
</odoo>
