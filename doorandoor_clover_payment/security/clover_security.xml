<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_ddcl_clover_operation_user_own" model="ir.rule">
        <field name="name">Operaciones Clover propias del comercial</field>
        <field name="model_id" ref="model_doorandoor_clover_operation"/>
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="rule_ddcl_clover_operation_admin_all" model="ir.rule">
        <field name="name">Administración consulta todas las operaciones Clover</field>
        <field name="model_id" ref="model_doorandoor_clover_operation"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
    </record>
</odoo>
