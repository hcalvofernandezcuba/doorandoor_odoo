<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ddpc_variant_selector_form" model="ir.ui.view">
        <field name="name">ddpc.variant.selector.form</field>
        <field name="model">ddpc.variant.selector</field>
        <field name="arch" type="xml">
            <form string="Configure su producto" class="ddpc_sale_style_configurator">
                <sheet>
                    <field name="move_line_id" invisible="1"/>
                    <field name="remove_line_on_cancel" invisible="1"/>
                    <field name="selection_mode" invisible="1"/>
                    <field name="available_attribute_ids" invisible="1"/>
                    <field name="requires_hinges" invisible="1"/>
                    <field name="available_hinge_template_value_ids" invisible="1"/>
                    <div class="row align-items-start mb-3">
                        <div class="col-12 col-md-2 text-center">
                            <field name="product_image" widget="image" class="ddpc_product_image" options="{'preview_image': 'product_image'}"/>
                        </div>
                        <div class="col-12 col-md-7">
                            <label for="product_template_id" string="Producto" class="fw-bold"/>
                            <field name="product_template_id" class="fs-5 fw-bold" options="{'no_open': True}"/>

                            <field name="option_line_ids" nolabel="1" class="mt-3 ddpc_multi_options" invisible="not option_line_ids">
                                <list create="0" delete="0" editable="bottom">
                                    <field name="attribute_id"/>
                                    <field name="value_id"/>
                                    <field name="selected" widget="boolean_toggle"/>
                                </list>
                            </field>

                            <field name="attribute_selection_line_ids" nolabel="1" class="mt-3 ddpc_single_options">
                                <list create="0" delete="0" editable="bottom">
                                    <field name="attribute_line_id" column_invisible="1"/>
                                    <field name="sequence" column_invisible="1"/>
                                    <field name="available_template_value_ids" column_invisible="1"/>
                                    <field name="attribute_id"/>
                                    <field name="selected_template_value_id"
                                           required="1"
                                           context="{'show_attribute': False}"
                                           options="{'no_create': True, 'no_open': True}"
                                           placeholder="Seleccione un valor..."/>
                                </list>
                            </field>
                            <div class="mt-3" invisible="not requires_hinges">
                                <label for="hinge_template_value_id" string="Hinges" class="fw-bold"/>
                                <field name="hinge_template_value_id"
                                       required="requires_hinges"
                                       options="{'no_create': True, 'no_open': True}"
                                       placeholder="Seleccione Gold, Silver o Black..."/>
                            </div>
                        </div>
                        <div class="col-6 col-md-1">
                            <label for="quantity" string="Cantidad" class="fw-bold"/>
                            <field name="quantity"/>
                        </div>
                        <div class="col-6 col-md-2 text-end">
                            <span class="fw-bold">Precio</span>
                            <div class="fs-5"><field name="configured_price" readonly="1"/></div>
                        </div>
                    </div>

                    <separator/>
                    <group string="Resultado de la configuracion">
                        <group>
                            <field name="variant_preview_name" readonly="1"/>
                            <field name="selection_summary" readonly="1"/>
                        </group>
                        <group>
                            <field name="variant_extra_price" readonly="1"/>
                            <field name="configured_total" readonly="1" class="fw-bold"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_apply_variant" string="Confirmar" type="object" class="btn-primary"/>
                    <button name="action_cancel_configuration" string="Cancelar" type="object" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
