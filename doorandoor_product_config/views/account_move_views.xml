<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_move_form_inherit_ddpc" model="ir.ui.view">
            <field name="name">account.move.form.ddpc.variant.price</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='product_id']" position="after">
                    <button
                        name="action_open_ddpc_variant_selector"
                        type="object"
                        icon="fa-sliders"
                        title="Configure Variant"
                        invisible="display_type not in (False, 'product')"/>
                </xpath>

                <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='price_unit']" position="after">
                    <field name="ddpc_base_price" string="Base Price" readonly="1" optional="hide"/>
                    <field name="ddpc_variant_extra_price" string="Variant Extra" readonly="1" optional="show"/>
                    <field name="ddpc_configured_price_unit" string="Configured Price" readonly="1" optional="show"/>
                </xpath>

                <xpath expr="//field[@name='invoice_line_ids']/form//field[@name='product_id']" position="after">
                    <button
                        name="action_open_ddpc_variant_selector"
                        type="object"
                        icon="fa-sliders"
                        string="Configure Variant"
                        class="oe_link"
                        invisible="display_type not in (False, 'product')"/>
                    <group string="Variant Pricing" colspan="2">
                        <field name="ddpc_base_price" readonly="1"/>
                        <field name="ddpc_variant_extra_price" readonly="1"/>
                        <field name="ddpc_configured_price_unit" readonly="1"/>
                    </group>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
