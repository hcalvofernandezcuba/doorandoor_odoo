<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_product_product_form_inherit_ddpc" model="ir.ui.view">
            <field name="name">product.product.form.ddpc.variant.extra.price</field>
            <field name="model">product.product</field>
            <field name="inherit_id" ref="product.product_normal_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='list_price']" position="after">
                    <field name="ddpc_variant_extra_price" groups="base.group_system"/>
                    <field name="ddpc_is_custom_variant" readonly="1"/>
                </xpath>
                <xpath expr="//notebook" position="inside">
                    <page string="Variante personalizada" invisible="not ddpc_is_custom_variant">
                        <group>
                            <field name="ddpc_custom_attribute_value_id" readonly="1"/>
                            <field name="ddpc_origin_invoice_id" readonly="1"/>
                            <field name="ddpc_last_delivery_date" readonly="1"/>
                            <field name="ddpc_archive_after_date" readonly="1"/>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>

        <record id="view_product_template_form_inherit_ddpc" model="ir.ui.view">
            <field name="name">product.template.form.ddpc.variant.extra.price</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_only_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                    <button
                        name="action_open_ddpc_variant_pricing"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-sliders"
                        groups="base.group_system"
                        invisible="product_variant_count &lt;= 0">
                        <div class="o_stat_info">
                            <span class="o_stat_text">Variant</span>
                            <span class="o_stat_text">Pricing</span>
                        </div>
                    </button>
                </xpath>
                <xpath expr="//field[@name='list_price']" position="after">
                    <label for="list_price" string="Variant pricing is configured on each generated variant." invisible="product_variant_count &lt;= 1"/>
                </xpath>
            </field>
        </record>

        <record id="view_product_template_form_configurator_only_ddpc" model="ir.ui.view">
            <field name="name">product.template.form.ddpc.configurator.only</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="sale_product_matrix.product_template_grid_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//group[@name='product_mode']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
