<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_operational_manual_list" model="ir.ui.view">
        <field name="name">doorandoor.operational.manual.list</field>
        <field name="model">doorandoor.operational.manual</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'published'" decoration-muted="state == 'archived'">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="area"/>
                <field name="operation_name"/>
                <field name="version"/>
                <field name="effective_date"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_operational_manual_search" model="ir.ui.view">
        <field name="name">doorandoor.operational.manual.search</field>
        <field name="model">doorandoor.operational.manual</field>
        <field name="arch" type="xml">
            <search string="Buscar guias operativas">
                <field name="name"/>
                <field name="code"/>
                <field name="module_name"/>
                <field name="operation_name"/>
                <field name="audience"/>
                <filter name="published" string="Publicadas" domain="[('state','=','published')]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_area" string="Area" context="{'group_by':'area'}"/>
                    <filter name="group_state" string="Estado" context="{'group_by':'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_operational_manual_form" model="ir.ui.view">
        <field name="name">doorandoor.operational.manual.form</field>
        <field name="model">doorandoor.operational.manual</field>
        <field name="arch" type="xml">
            <form string="Guia operativa">
                <header>
                    <button name="action_publish" type="object" string="Publicar" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_archive_manual" type="object" string="Archivar" invisible="state != 'published'"/>
                    <button name="action_set_draft" type="object" string="Volver a borrador" invisible="state == 'draft'"/>
                    <button name="action_open_internal_center" type="object" string="Abrir centro interno"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,published,archived"/>
                </header>
                <sheet>
                    <div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="area"/>
                            <field name="module_name"/>
                            <field name="operation_name"/>
                            <field name="audience"/>
                        </group>
                        <group>
                            <field name="version"/>
                            <field name="effective_date"/>
                            <field name="sequence"/>
                            <field name="active"/>
                            <field name="pdf_filename" invisible="1"/>
                            <field name="pdf_file" filename="pdf_filename"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Contenido">
                            <field name="summary"/>
                            <field name="change_log"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_operational_manual_admin" model="ir.actions.act_window">
        <field name="name">Administrar guias</field>
        <field name="res_model">doorandoor.operational.manual</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_operational_manual_search"/>
    </record>
    <record id="action_operational_manual_center" model="ir.actions.act_url">
        <field name="name">Centro de guias operativas</field>
        <field name="url">/guias-operativas</field>
        <field name="target">self</field>
    </record>

    <menuitem id="menu_operational_manual_root"
              name="Guias operativas"
              action="action_operational_manual_center"
              groups="base.group_user"
              sequence="92"/>
    <menuitem id="menu_operational_manual_admin"
              name="Administrar guias"
              parent="menu_operational_manual_root"
              action="action_operational_manual_admin"
              groups="doorandoor_operational_manuals.group_operational_manual_manager"
              sequence="90"/>
</odoo>
