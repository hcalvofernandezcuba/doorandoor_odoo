<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_load_control" model="ir.module.category">
        <field name="name">DoorAndDoor Control de Cargas</field>
        <field name="sequence">38</field>
    </record>

    <record id="group_load_control_user" model="res.groups">
        <field name="name">Consulta de planes de carga</field>
        <field name="category_id" ref="module_category_load_control"/>
    </record>

    <record id="group_load_control_planner" model="res.groups">
        <field name="name">Planificador de cargas</field>
        <field name="category_id" ref="module_category_load_control"/>
        <field name="implied_ids" eval="[(4, ref('group_load_control_user')), (4, ref('fleet.fleet_group_user'))]"/>
    </record>

    <record id="group_load_control_driver" model="res.groups">
        <field name="name">Chofer</field>
        <field name="category_id" ref="module_category_load_control"/>
        <field name="implied_ids" eval="[(4, ref('group_load_control_user'))]"/>
    </record>

    <record id="group_load_control_manager" model="res.groups">
        <field name="name">Gerencia logística</field>
        <field name="category_id" ref="module_category_load_control"/>
        <field name="implied_ids" eval="[(4, ref('group_load_control_planner')), (4, ref('fleet.fleet_group_manager'))]"/>
    </record>

    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_load_control_manager'))]"/>
    </record>

    <record id="rule_load_plan_company" model="ir.rule">
        <field name="name">Planes de carga por compañía</field>
        <field name="model_id" ref="model_doorandoor_load_plan"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(5, 0, 0)]"/>
    </record>

    <record id="rule_load_plan_stop_company" model="ir.rule">
        <field name="name">Paradas de carga por compañía</field>
        <field name="model_id" ref="model_doorandoor_load_plan_stop"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(5, 0, 0)]"/>
    </record>

    <record id="rule_load_plan_driver_assigned" model="ir.rule">
        <field name="name">Chofer ve solamente sus rutas</field>
        <field name="model_id" ref="model_doorandoor_load_plan"/>
        <field name="domain_force">[('driver_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_load_control_driver'))]"/>
    </record>

    <record id="rule_load_plan_planner_all" model="ir.rule">
        <field name="name">Planificación ve todos los planes de su compañía</field>
        <field name="model_id" ref="model_doorandoor_load_plan"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_load_control_planner'))]"/>
    </record>

    <record id="rule_load_plan_stop_driver_assigned" model="ir.rule">
        <field name="name">Chofer ve paradas de sus rutas</field>
        <field name="model_id" ref="model_doorandoor_load_plan_stop"/>
        <field name="domain_force">[('plan_id.driver_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_load_control_driver'))]"/>
    </record>

    <record id="rule_load_plan_stop_planner_all" model="ir.rule">
        <field name="name">Planificación ve todas las paradas de su compañía</field>
        <field name="model_id" ref="model_doorandoor_load_plan_stop"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_load_control_planner'))]"/>
    </record>

    <record id="rule_driver_profile_company" model="ir.rule">
        <field name="name">Choferes por compañía</field>
        <field name="model_id" ref="model_doorandoor_driver_profile"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(5, 0, 0)]"/>
    </record>

    <record id="rule_load_plan_crew_company" model="ir.rule">
        <field name="name">Tripulaciones por compañía</field>
        <field name="model_id" ref="model_doorandoor_load_plan_crew"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(5, 0, 0)]"/>
    </record>

    <record id="rule_trip_control_company" model="ir.rule">
        <field name="name">Controles de viaje por compañía</field>
        <field name="model_id" ref="model_doorandoor_load_trip_control"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(5, 0, 0)]"/>
    </record>

    <record id="rule_trip_control_driver_assigned" model="ir.rule">
        <field name="name">Chofer registra controles de sus viajes</field>
        <field name="model_id" ref="model_doorandoor_load_trip_control"/>
        <field name="domain_force">[('plan_id.driver_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_load_control_driver'))]"/>
    </record>

    <record id="rule_trip_control_planner_all" model="ir.rule">
        <field name="name">Planificación consulta controles de viaje</field>
        <field name="model_id" ref="model_doorandoor_load_trip_control"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_load_control_planner'))]"/>
    </record>
</odoo>
