<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mrp_production_form_inherit_ddfc" model="ir.ui.view">
        <field name="name">mrp.production.form.doorandoor.fabrica.control</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_ddfc_machining_handoffs" type="object" class="oe_stat_button" icon="fa-exchange">
                    <field name="ddfc_machining_handoff_count" widget="statinfo" string="Maquinado → Ensamblaje"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="ddfc_requesting_warehouse_id" readonly="1"/>
                <field name="ddfc_source_invoice_id" readonly="1" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="view_mrp_production_tree_inherit_ddfc" model="ir.ui.view">
        <field name="name">mrp.production.list.doorandoor.fabrica.control</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="ddfc_requesting_warehouse_id" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
