<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ddfc_production_need_list" model="ir.ui.view"><field name="name">ddfc.production.need.list</field><field name="model">ddfc.production.need</field><field name="arch" type="xml"><list decoration-muted="state == 'cancel'" decoration-success="state == 'planned'"><field name="name"/><field name="required_date"/><field name="warehouse_id"/><field name="product_id"/><field name="requested_qty"/><field name="planned_qty"/><field name="pending_qty"/><field name="source_type"/><field name="source_document"/><field name="priority" widget="priority"/><field name="state"/></list></field></record>
    <record id="view_ddfc_production_need_form" model="ir.ui.view"><field name="name">ddfc.production.need.form</field><field name="model">ddfc.production.need</field><field name="arch" type="xml"><form string="Necesidad de producción"><sheet><div class="oe_title"><h1><field name="name" readonly="1"/></h1></div><group><group><field name="warehouse_id"/><field name="product_id"/><field name="requested_qty"/><field name="product_uom_id" readonly="1"/></group><group><field name="required_date"/><field name="source_type"/><field name="source_invoice_id" invisible="source_type != 'sale'"/><field name="source_picking_id" invisible="source_type != 'replenishment'"/><field name="source_document" readonly="1"/><field name="priority" widget="priority"/><field name="state"/></group></group><group><field name="planned_qty" readonly="1"/><field name="pending_qty" readonly="1"/></group><field name="notes"/></sheet></form></field></record>
    <record id="action_ddfc_production_needs" model="ir.actions.act_window"><field name="name">Necesidades por almacén</field><field name="res_model">ddfc.production.need</field><field name="view_mode">list,form</field></record>

    <record id="view_ddfc_daily_plan_list" model="ir.ui.view"><field name="name">ddfc.daily.plan.list</field><field name="model">ddfc.daily.plan</field><field name="arch" type="xml"><list><field name="name"/><field name="plan_date"/><field name="production_warehouse_id"/><field name="state"/><field name="material_picking_id"/></list></field></record>
    <record id="view_ddfc_daily_plan_form" model="ir.ui.view"><field name="name">ddfc.daily.plan.form</field><field name="model">ddfc.daily.plan</field><field name="arch" type="xml"><form string="Plan diario de producción">
        <header><button name="action_load_pending_needs" string="Generar corte de solicitudes" type="object" class="btn-primary" invisible="state != 'draft' or snapshot_locked"/><button name="action_approve" string="Aprobar plan y crear OF" type="object" class="btn-primary" invisible="state != 'draft' or not snapshot_locked"/><button name="action_request_materials" string="Solicitar salida de materiales" type="object" class="btn-primary" invisible="state != 'approved'"/><button name="action_print_daily_plan" string="Imprimir plan" type="object"/><button name="action_print_material_request" string="Imprimir requerimiento" type="object" invisible="not component_line_ids"/><button name="action_print_order_labels" string="Etiquetas OF 2×1" type="object" invisible="not production_ids"/><button name="action_print_material_delivery" string="Imprimir vale de salida" type="object" invisible="not material_picking_id"/><button name="action_cancel" string="Cancelar" type="object" invisible="state == 'cancel'"/><field name="state" widget="statusbar" statusbar_visible="draft,approved,materials"/></header>
        <sheet><div class="oe_button_box" name="button_box"><button name="action_open_material_picking" type="object" class="oe_stat_button" icon="fa-exchange" invisible="not material_picking_id"><field name="material_picking_id" widget="statinfo" string="Salida materiales"/></button></div><div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
        <group><group><field name="plan_date" readonly="snapshot_locked"/><field name="production_warehouse_id" readonly="snapshot_locked"/></group><group><field name="material_destination_location_id" readonly="snapshot_locked"/><field name="snapshot_locked" readonly="1"/><field name="snapshot_at" readonly="1" invisible="not snapshot_locked"/><field name="snapshot_user_id" readonly="1" invisible="not snapshot_locked"/><field name="material_picking_id" readonly="1"/></group></group>
        <div class="alert alert-info" invisible="not snapshot_locked">Corte cerrado. Las solicitudes posteriores se procesarán en el próximo plan diario.</div>
        <notebook><page string="Producciones por almacén"><field name="line_ids" readonly="state != 'draft'"><list editable="bottom" create="0" delete="0"><field name="warehouse_id" readonly="1"/><field name="source_document" readonly="1"/><field name="product_id" readonly="1"/><field name="bom_id" readonly="1"/><field name="requested_qty" readonly="1"/><field name="approved_qty"/><field name="product_uom_id" readonly="1"/><field name="production_id" readonly="1"/></list></field></page><page string="Partes y piezas consolidadas"><field name="component_line_ids" readonly="1"><list><field name="product_id"/><field name="required_qty"/><field name="product_uom_id"/><field name="label_policy"/><field name="available_qty"/><field name="shortage_qty" decoration-danger="shortage_qty &gt; 0"/></list></field></page><page string="Materiales por OF"><field name="order_component_line_ids" readonly="1"><list><field name="production_id"/><field name="source_document"/><field name="warehouse_id"/><field name="product_id"/><field name="required_qty"/><field name="product_uom_id"/><field name="label_policy"/></list></field></page><page string="Observaciones"><field name="notes"/></page></notebook></sheet>
    </form></field></record>
    <record id="action_ddfc_daily_plans" model="ir.actions.act_window"><field name="name">Planes diarios</field><field name="res_model">ddfc.daily.plan</field><field name="view_mode">list,form</field></record>
    <record id="action_ddfc_daily_replenishments" model="ir.actions.act_window"><field name="name">Reposiciones diarias</field><field name="res_model">ddfc.production.need</field><field name="view_mode">list,form</field><field name="domain">[('source_type', '=', 'replenishment')]</field><field name="context">{'default_source_type': 'replenishment'}</field></record>
    <menuitem id="menu_ddfc_reports_root" name="Reportes DoorAndDoor" parent="mrp.menu_mrp_root" sequence="80" groups="mrp.group_mrp_user"/>
    <menuitem id="menu_ddfc_production_needs" name="Necesidades por almacén" parent="menu_ddfc_reports_root" action="action_ddfc_production_needs" sequence="10"/>
    <menuitem id="menu_ddfc_daily_plans" name="Plan general diario" parent="menu_ddfc_reports_root" action="action_ddfc_daily_plans" sequence="20"/>
    <menuitem id="menu_ddfc_daily_replenishments" name="Reposiciones diarias" parent="menu_ddfc_reports_root" action="action_ddfc_daily_replenishments" sequence="30"/>
</odoo>
