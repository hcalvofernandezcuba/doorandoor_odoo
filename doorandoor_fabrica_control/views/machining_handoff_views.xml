<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ddfc_machining_handoff_list" model="ir.ui.view">
        <field name="name">ddfc.machining.handoff.list</field>
        <field name="model">ddfc.machining.handoff</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'received'" decoration-muted="state == 'cancel'">
                <field name="name"/>
                <field name="production_id"/>
                <field name="origin_type"/>
                <field name="origin_document"/>
                <field name="product_id"/>
                <field name="delivered_at"/>
                <field name="delivered_by_id"/>
                <field name="received_at"/>
                <field name="received_by_id"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_ddfc_machining_handoff_form" model="ir.ui.view">
        <field name="name">ddfc.machining.handoff.form</field>
        <field name="model">ddfc.machining.handoff</field>
        <field name="arch" type="xml">
            <form string="Entrega de Maquinado a Ensamblaje">
                <header>
                    <button name="action_dispatch" string="Confirmar salida de Maquinado" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_receive" string="Confirmar recepción en Ensamblaje" type="object" class="btn-primary" invisible="state != 'dispatched'"/>
                    <button name="action_print_handoff" string="Imprimir vale" type="object" invisible="state == 'draft'"/>
                    <button name="action_cancel" string="Cancelar" type="object" invisible="state in ('received', 'cancel')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,dispatched,received"/>
                </header>
                <sheet>
                    <div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="production_id" readonly="state != 'draft'"/>
                            <field name="product_id" readonly="1"/>
                            <field name="product_qty" readonly="1"/>
                            <field name="product_uom_id" readonly="1"/>
                            <field name="machining_workorder_id" readonly="state != 'draft'"/>
                            <field name="reception_workorder_id" readonly="state != 'draft'"/>
                        </group>
                        <group string="Trazabilidad de origen">
                            <field name="origin_type" readonly="1"/>
                            <field name="origin_document" readonly="1"/>
                            <field name="source_invoice_id" readonly="1" invisible="origin_type != 'sale'"/>
                            <field name="replenishment_reference" readonly="1" invisible="origin_type != 'replenishment'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Partes o productos">
                            <field name="line_ids" readonly="state in ('received', 'cancel')">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="description" optional="show"/>
                                    <field name="delivered_qty" readonly="parent.state != 'draft'"/>
                                    <field name="rejected_qty" readonly="parent.state != 'draft'"/>
                                    <field name="received_qty" readonly="parent.state != 'dispatched'"/>
                                    <field name="receipt_rejected_qty" readonly="parent.state != 'dispatched'"/>
                                    <field name="product_uom_id"/>
                                    <field name="notes" optional="show"/>
                                </list>
                            </field>
                        </page>
                        <page string="Control y responsables">
                            <group>
                                <group><field name="delivered_by_id"/><field name="delivered_at"/></group>
                                <group><field name="received_by_id"/><field name="received_at"/></group>
                            </group>
                            <field name="notes" readonly="state == 'cancel'"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_ddfc_machining_handoff" model="ir.actions.act_window">
        <field name="name">Entregas Maquinado → Ensamblaje</field>
        <field name="res_model">ddfc.machining.handoff</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_ddfc_machining_handoff" name="Entregas Maquinado → Ensamblaje"
              parent="mrp.menu_mrp_manufacturing" action="action_ddfc_machining_handoff" sequence="45"/>
</odoo>
