<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="document_labels_report">
            <t t-call="web.html_container">
                <div style="padding:8mm;font-size:0;">
                    <t t-foreach="labels" t-as="label">
                        <div style="display:inline-block;vertical-align:top;width:88mm;height:128mm;margin:0 4mm 8mm 0;padding:0;box-sizing:border-box;page-break-inside:avoid;">
                            <div style="border:1px solid #d9d9d9;height:100%;padding:6mm 7mm;box-sizing:border-box;background:#fff;color:#000;">
                                <div style="display:table;width:100%;height:100%;">
                                    <div style="display:table-row;">
                                        <div style="display:table-cell;vertical-align:top;">
                                            <div style="text-align:center;font-size:16px;font-weight:700;">DOOR AND DOOR</div>
                                            <div style="text-align:center;font-size:9px;margin-top:1mm;">WWW.DOORANDOOR.COM</div>

                                            <div style="margin-top:8mm;font-size:12px;line-height:1.45;">
                                                <div><strong>INV:</strong> <t t-esc="label.get('document_name')"/></div>
                                                <div><strong>CUSTOMER:</strong> <t t-esc="label.get('customer_name')"/></div>
                                                <div t-if="label.get('label_model')"><strong>MODEL:</strong> <t t-esc="label.get('label_model')"/></div>
                                                <div t-if="label.get('label_design')"><strong>DESIGN:</strong> <t t-esc="label.get('label_design')"/></div>
                                                <div t-if="label.get('label_size')"><strong>SIZE:</strong> <t t-esc="label.get('label_size')"/></div>
                                                <div t-if="label.get('label_swing')"><strong>SWING:</strong> <t t-esc="label.get('label_swing')"/></div>
                                                <div t-if="label.get('label_hinge')"><strong>HINGE:</strong> <t t-esc="label.get('label_hinge')"/></div>
                                            </div>

                                            <div style="margin-top:8mm;font-size:9px;line-height:1.25;">
                                                <div><strong>PREPARED BY:</strong> <t t-esc="label.get('prepared_by')"/></div>
                                                <div><strong>PRINTED BY:</strong> <t t-esc="label.get('printed_by')"/></div>
                                            </div>

                                            <div style="margin-top:10mm;text-align:center;">
                                                <img t-if="label.get('barcode_src')" t-att-src="label.get('barcode_src')" style="max-width:72mm;width:auto;height:16mm;display:inline-block;"/>
                                                <div style="font-size:9px;margin-top:1mm;">
                                                    <t t-esc="label.get('product_code')"/>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>
            </t>
        </template>

        <record id="action_report_ddsl_document_labels" model="ir.actions.report">
            <field name="name">Document Labels</field>
            <field name="model">ddsl.document.label.wizard</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">doorandoor_stock_labels.document_labels_report</field>
            <field name="report_file">doorandoor_stock_labels.document_labels_report</field>
            <field name="print_report_name">'Document Labels'</field>
        </record>
    </data>
</odoo>
