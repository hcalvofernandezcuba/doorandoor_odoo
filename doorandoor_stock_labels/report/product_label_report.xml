<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="product_labels_report">
            <t t-call="web.html_container">
                <style>
                    html, body.o_body_html, body.o_body_html.container,
                    #wrapwrap, #wrapwrap main {
                        width: 101.6mm !important;
                        min-width: 101.6mm !important;
                        max-width: 101.6mm !important;
                        margin: 0 !important;
                        padding: 0 !important;
                    }
                    .ddsl-zebra-label-page {
                        display: block !important;
                        width: 101.6mm !important;
                        height: 151.8mm !important;
                        min-height: 151.8mm !important;
                        max-height: 151.8mm !important;
                        margin: 0 !important;
                        padding: 0 !important;
                        box-sizing: border-box !important;
                        overflow: hidden !important;
                        position: relative !important;
                        page-break-after: always !important;
                        page-break-inside: avoid !important;
                    }
                </style>
                <t t-foreach="labels" t-as="label">
                    <div class="page ddsl-zebra-label-page"
                         t-attf-style="font-size:0;page-break-after:#{'auto' if label_last else 'always'} !important;">
                            <div style="position:absolute;left:3mm;top:3mm;width:95.6mm;height:146.4mm;margin:0;padding:0;box-sizing:border-box;page-break-inside:avoid;overflow:hidden;">
                                <div style="border:0.35mm solid #222;height:100%;padding:4mm 6mm;box-sizing:border-box;background:#fff;color:#000;overflow:hidden;position:relative;">
                                    <div style="text-align:center;font-size:25px;font-weight:700;line-height:1.05;letter-spacing:0.6px;">DOORANDOOR</div>
                                    <div style="text-align:center;font-size:14px;line-height:1.1;margin-top:0.8mm;">WWW.DOORANDOOR.COM</div>

                                    <div style="margin-top:6mm;font-size:17px;line-height:1.3;max-height:76mm;overflow:hidden;word-break:break-word;">
                                        <div><strong>PRODUCT:</strong> <t t-esc="label.get('product_name')"/></div>
                                        <div><strong>WAREHOUSE:</strong> <t t-esc="label.get('warehouse_name')"/></div>
                                        <div t-if="label.get('label_model')"><strong>MODEL:</strong> <t t-esc="label.get('label_model')"/></div>
                                        <div t-if="label.get('label_design')"><strong>DESIGN:</strong> <t t-esc="label.get('label_design')"/></div>
                                        <div t-if="label.get('label_size')"><strong>SIZE:</strong> <t t-esc="label.get('label_size')"/></div>
                                        <div t-if="label.get('label_swing')"><strong>SWING:</strong> <t t-esc="label.get('label_swing')"/></div>
                                        <div t-if="label.get('label_hinge')"><strong>HINGE:</strong> <t t-esc="label.get('label_hinge')"/></div>
                                    </div>

                                    <div style="position:absolute;left:5mm;right:5mm;bottom:7mm;text-align:center;white-space:nowrap;">
                                        <img t-if="label.get('barcode_src')" t-att-src="label.get('barcode_src')" style="width:78mm;height:36mm;display:inline-block;"/>
                                        <div style="font-size:18px;font-weight:700;line-height:1.1;margin-top:1.5mm;letter-spacing:0.6px;">
                                            BARCODE: <t t-esc="label.get('product_code')"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                    </div>
                </t>
            </t>
        </template>

        <template id="product_labels_report_small">
            <t t-call="web.html_container">
                <style>
                    html, body.o_body_html, body.o_body_html.container, #wrapwrap, #wrapwrap main {width:76mm !important;margin:0 !important;padding:0 !important;}
                    .ddsl-product-3x1 {display:block !important;width:76mm !important;height:25mm !important;margin:0 !important;padding:1.2mm 2mm !important;box-sizing:border-box !important;overflow:hidden !important;position:relative !important;page-break-inside:avoid !important;}
                </style>
                <t t-foreach="labels" t-as="label">
                    <div class="page ddsl-product-3x1" t-attf-style="page-break-after:#{'auto' if label_last else 'always'} !important;">
                        <div style="position:absolute;left:1.5mm;top:0.8mm;width:73mm;height:9.8mm;overflow:hidden;font-size:8.5px;line-height:1.1;color:#000;">
                            <div style="font-size:11px;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;"><t t-esc="label.get('product_name')"/></div>
                            <div style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis;"><strong>WH:</strong> <t t-esc="label.get('warehouse_name')"/></div>
                            <div t-if="label.get('variant_name')" style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis;"><strong>VAR:</strong> <t t-esc="label.get('variant_name')"/></div>
                        </div>
                        <div style="position:absolute;left:1.5mm;right:1.5mm;bottom:0.7mm;text-align:center;white-space:nowrap;overflow:hidden;">
                            <img t-if="label.get('barcode_src')" t-att-src="label.get('barcode_src')" style="width:73mm !important;max-width:none !important;height:11.5mm !important;display:block;margin:0 auto;"/>
                            <div style="font-size:8px;font-weight:700;line-height:1;"><t t-esc="label.get('product_code')"/></div>
                        </div>
                    </div>
                </t>
            </t>
        </template>

        <record id="action_report_ddsl_product_labels" model="ir.actions.report">
            <field name="name">Product Labels</field>
            <field name="model">ddsl.product.label.wizard</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">doorandoor_stock_labels.product_labels_report</field>
            <field name="report_file">doorandoor_stock_labels.product_labels_report</field>
            <field name="paperformat_id" ref="doorandoor_stock_labels.paperformat_ddsl_zebra_4x6_portrait"/>
            <field name="print_report_name">'Product Labels - %s' % (object.product_tmpl_id.display_name or 'Product')</field>
        </record>
        <record id="action_report_ddsl_product_labels_small" model="ir.actions.report">
            <field name="name">Product Labels — Small</field>
            <field name="model">ddsl.product.label.wizard</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">doorandoor_stock_labels.product_labels_report_small</field>
            <field name="report_file">doorandoor_stock_labels.product_labels_report_small</field>
            <field name="paperformat_id" ref="doorandoor_stock_labels.paperformat_ddsl_zebra_3x1_landscape"/>
            <field name="print_report_name">'Product Labels Small - %s' % (object.product_tmpl_id.display_name or 'Product')</field>
        </record>
    </data>
</odoo>
