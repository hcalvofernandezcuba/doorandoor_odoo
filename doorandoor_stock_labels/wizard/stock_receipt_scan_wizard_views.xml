<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_ddsl_stock_receipt_scan_wizard_form" model="ir.ui.view">
            <field name="name">ddsl.stock.receipt.scan.wizard.form</field>
            <field name="model">ddsl.stock.receipt.scan.wizard</field>
            <field name="arch" type="xml">
                <form string="Recibir con hanger">
                    <group>
                        <field name="picking_id"/>
                        <field name="scan_code" placeholder="Escanee aqui el codigo del producto"/>
                    </group>
                    <group>
                        <field name="line_ids">
                            <list editable="bottom" create="0" delete="0">
                                <field name="product_id"/>
                                <field name="expected_qty"/>
                                <field name="counted_qty"/>
                            </list>
                        </field>
                    </group>
                    <footer>
                        <button name="action_register_scan" type="object" string="Contar disparo" class="btn-primary"/>
                        <button name="action_apply_count" type="object" string="Aplicar conteo" class="btn-secondary"/>
                        <button string="Cancelar" special="cancel" class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>
