<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_move_form_inherit_ddsl_document_labels" model="ir.ui.view">
            <field name="name">account.move.form.ddsl.document.labels</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//header/button[@name='action_print_pdf']" position="after">
                    <button
                        name="action_open_ddsl_document_label_wizard"
                        type="object"
                        string="Preparar despacho e imprimir labels"
                        invisible="move_type not in ('out_invoice', 'out_refund')"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
